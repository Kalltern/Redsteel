{{!--
  Experimental BG3-style hotbar panel. Single root element: HandlebarsApplicationMixin
  keeps only the first element of a part template.

  Stack order (top to bottom in the DOM): attributes, favourite skills, macro
  rows from the highest page down to page 1, so page 1 sits at the bottom.

  The portrait is its own round frame, a sibling of the rows box rather than a
  child of it, so the two read as separate panels sitting side by side.
--}}
{{!--
  The bar is the anchor: it alone sits in flow and is centred on screen.
  Portraits, resource columns and the wrench hang off its edges absolutely, so
  gaining a teammate or a mana pool never shifts the bar under your cursor.

  data-tt-delay / data-tt-nofreeze / data-tt-above ride on the anchor and so
  apply to every tooltip source in the panel: a longer dwell than the sheet
  uses, because the cells are small and packed; no freezing, so none of them
  sprout a pin or steal the cursor; and all of them park centred above the bar
  instead of beside the cell, which would otherwise cover the neighbouring row.
--}}
<div class="rs-bg3-outer">
{{!--
  The right-click resource editor, shared by every portrait: your own and each
  party member's. Built only for actors the viewer owns (see
  #prepareResourceEditor), which is what lets a GM reach the whole party row
  from here. It carries its own actor's uuid so a row writes to the character
  it belongs to rather than to whoever the bar is bound to, and so an open
  panel can be found again after the edit's own redraw.

  Declared inside the root element, not before it: the part must render a
  single element and a block at the top would leave text nodes beside it.
--}}
{{#*inline "rsResEdit"}}
<div class="rs-bg3-resedit" data-actor-uuid="{{editor.uuid}}">
  {{#each editor.pools as |res|}}
  <label class="rs-bg3-resedit-row">
    <span class="rs-bg3-resedit-label">{{res.label}}</span>
    <input
      class="rs-bg3-resedit-input"
      type="number"
      data-stat="{{res.key}}"
      value="{{res.value}}"
      step="1"
    />
    <span class="rs-bg3-resedit-max">/ {{res.max}}</span>
  </label>
  {{/each}}

  {{!-- Below the rule: what stands between the character and their Life.
        Temporary Life writes to system.stats like the pools above it; a shield
        carries an effect id instead, since its pool lives on the effect. --}}
  {{#if editor.guards.length}}
  <div class="rs-bg3-resedit-rule"></div>
  {{#each editor.guards as |res|}}
  <label class="rs-bg3-resedit-row">
    <span class="rs-bg3-resedit-label">
      {{#if res.img}}
      <img class="rs-bg3-resedit-icon" src="{{res.img}}" alt="" />
      {{/if}}
      {{res.label}}
    </span>
    <input
      class="rs-bg3-resedit-input"
      type="number"
      {{#if res.shieldId}}
      data-shield-id="{{res.shieldId}}"
      {{else}}
      data-stat="{{res.key}}"
      {{/if}}
      value="{{res.value}}"
      step="1"
    />
    <span class="rs-bg3-resedit-max">{{#if res.hasMax}}/ {{res.max}}{{/if}}</span>
  </label>
  {{/each}}
  {{/if}}
</div>
{{/inline}}
<div
  class="rs-bg3-anchor"
  data-tt-actor-uuid="{{actorUuid}}"
  data-tt-delay="700"
  data-tt-nofreeze
  data-tt-above
>

  {{!-- A measuring aid, off by default: how many more portraits still fit --}}
  {{#if showCapacity}}
  <div class="rs-bg3-capacity"></div>
  {{/if}}

  {{!-- Turn suggestions, floated centred above the bar. Out of flow, so the
        strip coming and going never moves the bar. No tooltips on the chips:
        the panel's above-tooltips would park right over them. --}}
  {{#if suggestions.length}}
  <div class="rs-bg3-suggest{{#if showCapacity}} rs-bg3-suggest--raised{{/if}}">
    {{!-- One movement chip, shared by Move and by the chips in its drawer.
          Declared inside the strip so the part still renders one root. --}}
    {{#*inline "rsMoveChip"}}
    <button
      type="button"
      class="rs-bg3-suggest-chip"
      data-action="useSuggestion"
      data-suggestion-id="{{chip.id}}"
      data-suggestion-mode="{{chip.mode}}"
      aria-label="{{chip.ariaLabel}}"
    >
      <i class="{{chip.icon}} rs-bg3-suggest-icon" aria-hidden="true"></i>
      <span class="rs-bg3-suggest-text">
        <span class="rs-bg3-suggest-name">{{chip.label}}</span>
        <span class="rs-bg3-suggest-meta">
          {{~#if chip.costLabel}}{{chip.costLabel}} · {{/if~}}
          {{chip.hexLabel~}}
        </span>
      </span>
    </button>
    {{/inline}}
    {{#each suggestions as |chip|}}
    {{#if chip.groupStart}}
    {{!-- Rules the movement chips apart from the combat ones. --}}
    <span class="rs-bg3-suggest-divider" aria-hidden="true"></span>
    {{/if}}
    {{#if chip.facing}}
    {{!-- Slow Movement's facing step: turn the token a hex side at a time,
          then confirm; the move is declared only on the check. --}}
    <div
      class="rs-bg3-suggest-chip locked facing"
      data-suggestion-id="{{chip.id}}"
      data-suggestion-mode="{{chip.mode}}"
      role="group"
      aria-label="{{chip.ariaLabel}}"
    >
      <i class="{{chip.icon}} rs-bg3-suggest-icon" aria-hidden="true"></i>
      <span class="rs-bg3-suggest-text">
        <span class="rs-bg3-suggest-name">{{chip.label}}</span>
        <span class="rs-bg3-suggest-meta">{{chip.hexLabel}}</span>
      </span>
      <button type="button" class="rs-bg3-suggest-confirm rs-bg3-suggest-rotate"
        data-action="rotateFacing" data-dir="-1"
        aria-label="{{localize "REDSTEEL.Bg3Hotbar.Suggest.TurnLeft"}}"
      ><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
      <button type="button" class="rs-bg3-suggest-confirm rs-bg3-suggest-rotate"
        data-action="rotateFacing" data-dir="1"
        aria-label="{{localize "REDSTEEL.Bg3Hotbar.Suggest.TurnRight"}}"
      ><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>
      <button type="button" class="rs-bg3-suggest-confirm"
        data-action="confirmFacing"
        aria-label="{{localize "REDSTEEL.Bg3Hotbar.Suggest.ConfirmFacing"}}"
      ><i class="fa-solid fa-check" aria-hidden="true"></i></button>
      <button type="button" class="rs-bg3-suggest-confirm rs-bg3-suggest-cancel"
        data-action="cancelFacing"
        aria-label="{{localize "REDSTEEL.Bg3Hotbar.Suggest.CancelFacing"}}"
      ><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
    {{else if (eq chip.kind "sustain")}}
    {{!-- A spell held in a sustained cast: clicking lets it go (the caster's
          Channeling effect is deleted, which stops the cast and its upkeep). --}}
    <button
      type="button"
      class="rs-bg3-suggest-chip ability sustain"
      data-action="stopSustain"
      data-suggestion-id="{{chip.id}}"
      data-effect-id="{{chip.effectId}}"
      data-tooltip="{{chip.label}}"
      data-tooltip-direction="UP"
      aria-label="{{chip.ariaLabel}}"
    >
      <img class="rs-bg3-suggest-img" src="{{chip.img}}" alt="" />
    </button>
    {{else if (eq chip.kind "ability")}}
    {{!-- A combat ability usable right now, shown by its icon alone (user
          ruling); its name and cost ride on a core tooltip pointing up, clear
          of the strip. Clicking opens the Combat Abilities dialog with it
          already chosen, aimed at the attacker for a reaction. --}}
    <button
      type="button"
      class="rs-bg3-suggest-chip ability"
      data-action="useCombatSuggestion"
      data-suggestion-id="{{chip.id}}"
      data-ability-id="{{chip.abilityId}}"
      {{#if chip.targetTokenId}}data-target-token-id="{{chip.targetTokenId}}"{{/if}}
      data-tooltip="{{chip.label}} · {{chip.costLabel}}"
      data-tooltip-direction="UP"
      aria-label="{{chip.ariaLabel}}"
    >
      <img class="rs-bg3-suggest-img" src="{{chip.img}}" alt="" />
    </button>
    {{else if chip.locked}}
    {{!-- The declared movement. Clicking it does nothing, so it is a box
          rather than a button, which is what lets the confirm check sit
          inside its right end: a button cannot hold a button. --}}
    <div
      class="rs-bg3-suggest-chip locked"
      data-suggestion-id="{{chip.id}}"
      data-suggestion-mode="{{chip.mode}}"
      role="group"
      aria-label="{{chip.ariaLabel}}"
    >
      <i class="{{chip.icon}} rs-bg3-suggest-icon" aria-hidden="true"></i>
      <span class="rs-bg3-suggest-text">
        <span class="rs-bg3-suggest-name">{{chip.label}}</span>
        <span class="rs-bg3-suggest-meta">{{chip.hexLabel}}</span>
      </span>
      <button
        type="button"
        class="rs-bg3-suggest-confirm"
        data-action="confirmMovement"
        aria-label="{{localize "REDSTEEL.Bg3Hotbar.Suggest.Confirm"}}"
      ><i class="fa-solid fa-check" aria-hidden="true"></i></button>
    </div>
    {{else if chip.more}}
    {{!-- Move, with the other movements folded behind the » tab. The drawer
          rolls out to the right over the strip rather than widening it, so
          nothing shifts under the cursor; its open state is toggled as a class
          (no redraw), which is what lets it animate. --}}
    <div class="rs-bg3-suggest-movegroup">
      {{> rsMoveChip chip=chip}}
      <button
        type="button"
        class="rs-bg3-suggest-more-toggle{{#if @root.movementExpanded}} open{{/if}}"
        data-action="toggleMovementMore"
        aria-expanded="{{#if @root.movementExpanded}}true{{else}}false{{/if}}"
        aria-label="{{localize "REDSTEEL.Bg3Hotbar.Suggest.MoreMovement"}}"
      ><i class="fa-solid fa-angles-right" aria-hidden="true"></i></button>
      <div class="rs-bg3-suggest-more{{#if @root.movementExpanded}} open{{/if}}">
        {{#each chip.more as |m|}}
        {{> rsMoveChip chip=m}}
        {{/each}}
      </div>
    </div>
    {{else}}
    {{> rsMoveChip chip=chip}}
    {{/if}}
    {{/each}}
  </div>
  {{/if}}

  {{!-- Everything left of the bar, hung off its left edge --}}
  <div class="rs-bg3-left">

  {{!-- Connected players' characters, small, to the left of yours --}}
  {{#if teammates.length}}
  <div class="rs-bg3-team">
    {{#each teammates as |mate|}}
    <div
      class="rs-bg3-portrait-frame rs-bg3-portrait-frame--team"
      data-actor-uuid="{{mate.uuid}}"
      style="--rs-bg3-player: {{mate.colour}};"
    >
      <div
        class="rs-bg3-portrait-ring{{#unless mate.showRing}} rs-bg3-portrait-ring--flat{{/unless}}"
        style="--rs-hp-pct: {{mate.hp.pct}};"
      >
        <img
          class="rs-bg3-portrait-img"
          src="{{mate.img}}"
          alt="{{mate.name}}"
          data-tt-kind="text"
          data-tt-title="{{mate.name}}"
          data-tt-text="{{mate.tip}}"
        />
      </div>
      {{#if mate.resEditor}}
      {{> rsResEdit editor=mate.resEditor}}
      {{/if}}
      {{#if mate.showRing}}
      <div class="rs-bg3-hp-text">{{mate.hp.value}}/{{mate.hp.max}}</div>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{!-- Portrait: its own circular frame, adjacent to the bar --}}
  <div class="rs-bg3-portrait-frame" style="--rs-bg3-player: {{playerColour}};">
    <div class="rs-bg3-portrait-ring" style="--rs-hp-pct: {{hp.pct}};">
      {{!--
        The face is its own clipping circle so the toxicity flood can be cut to
        the portrait's edge without touching the health band around it.
      --}}
      <div class="rs-bg3-portrait-face">
        <img
          class="rs-bg3-portrait-img"
          src="{{portraitImg}}"
          alt="{{portraitName}}"
          data-tt-kind="text"
          data-tt-title="{{portraitName}}"
          data-tt-text="REDSTEEL.Bg3Hotbar.OpenSheet"
        />
        {{#if toxicity.any}}
        <span class="rs-bg3-tox-flood" style="height: {{toxicity.fill}}%;"></span>
        {{/if}}

        {{!-- Corruption bleeds inward from the rim, deepening by degree --}}
        {{#if aura.corruption}}
        <span
          class="rs-bg3-corruption"
          style="opacity: {{aura.corruption.opacity}};"
        ></span>
        {{/if}}
      </div>

      {{!--
        Absorb shield or retaliation aura, ringing the portrait. Blood Shield
        is not exclusive with the rest, so it rings further out and the two can
        show at once.
      --}}
      {{#if aura.shield}}
      <span
        class="rs-bg3-shield-aura"
        style="--rs-aura-a: {{aura.shield.a}};{{#if aura.shield.b}} --rs-aura-b: {{aura.shield.b}};{{/if}}"
      ></span>
      {{/if}}
      {{#if aura.bloodShield}}
      <span class="rs-bg3-shield-aura rs-bg3-shield-aura--blood"></span>
      {{/if}}
    </div>

    {{!--
      Temporary health, sitting just above the health pill inside the portrait:
      white physical, azure magical.
    --}}
    {{#if (or aura.temp aura.tempMagic)}}
    <div class="rs-bg3-temps">
      {{#if aura.temp}}
      <span class="rs-bg3-temp rs-bg3-temp--physical">{{aura.temp}}</span>
      {{/if}}
      {{#if aura.tempMagic}}
      <span class="rs-bg3-temp rs-bg3-temp--magic">{{aura.tempMagic}}</span>
      {{/if}}
    </div>
    {{/if}}
    {{#if toxicity.any}}
    <div class="rs-bg3-tox-text" data-tt-kind="stat" data-tt-id="toxicity">
      {{toxicity.value}}/{{toxicity.max}}
    </div>
    {{/if}}
    {{!--
      Right-click resource editor, the panel's answer to the token HUD. Only
      rendered for owners, and only for the pools, temporary Life and shields
      this character actually has.
    --}}
    {{#if resEditor}}
    {{> rsResEdit editor=resEditor}}
    {{/if}}

    {{#if hasActor}}
    <div class="rs-bg3-hp-text">{{hp.value}}/{{hp.max}}</div>
    {{else}}
    <div class="rs-bg3-hp-text rs-bg3-hp-text--empty">{{localize "REDSTEEL.Bg3Hotbar.NoActor"}}</div>
    {{/if}}
  </div>

    {{!--
      Resource bars: every pool except health, which owns the ring. Full-height
      columns in a narrow box tucked under the bar's left edge, reading as an
      extension of the frame. One bar fills the box on its own; more resources
      add columns. No readout on the bar: a number would set the column's width
      for it, so the tooltip carries the value instead.
    --}}
    {{!-- The berth is always rendered, the strip only when there is something to
         put in it. That is what keeps the portrait in one place across a
         one-pool character, a three-pool one, and an empty panel with no actor
         at all. --}}
    <div class="rs-bg3-res-slot">
    {{#if resourceBars.length}}
    <div class="rs-bg3-res-strip">
      {{#each resourceBars as |res|}}
      <div
        class="rs-bg3-res-bar"
        data-rs-res="{{res.key}}"
        data-tt-kind="bg3Stat"
        data-tt-id="{{res.key}}"
        data-tt-current="{{res.value}}/{{res.max}}"
      >
        <span class="rs-bg3-res-fill" style="height: {{res.fill}}%;"></span>
      </div>
      {{/each}}
    </div>
    {{/if}}
    </div>

  </div>

  {{!-- The bar itself: the only thing in flow, and so the only thing centred --}}
  <div class="rs-bg3-inner">
    <div class="rs-bg3-stack">

    {{!--
      STATUS ROW: one tray of readouts, centred, with the armed roll modifier
      and the two trays at the end. On a character the tray reads either the
      sheet's condition row or its armor by damage type, whichever the chip at
      its end last chose; on an NPC it carries both at once and drops the chip.
      Either way it arrives as `trayRows` in one shape, so there is one loop
      here rather than two nearly-identical ones.

      Icons and colours are the sheet's own, and a state worth attention
      brightens rather than the rest dimming. Whichever readouts have nothing
      to report are dropped upstream, so what is here is what is going on.

      No max beside the value: "/24" on seven readouts is what would push this
      row past the width the attribute rows set, and the current number is the
      one you read mid-combat. The tooltip still carries the ratio.
    --}}
    {{#if hasActor}}
    <div class="rs-bg3-row rs-bg3-row--status">

      {{!--
        The readouts and the round economy travel together as one flexible
        block, so the row still has exactly one growing child and the chips at
        its far end stay put. The tray inside it is sized to its own contents
        now rather than stretched across the row, which is what leaves the
        stars sitting immediately beside it instead of a channel away.
      --}}
      <div class="rs-bg3-tray-group">
      <div class="rs-bg3-stats-tray">
        {{#each trayRows as |cond|}}
        {{#if cond.divider}}
        <div class="rs-bg3-cond-divider" role="separator"></div>
        {{else}}
        <div
          class="rs-bg3-cond-row{{#if cond.relevant}} relevant{{/if}}"
          data-tt-kind="bg3Stat"
          data-tt-id="{{cond.key}}"
          data-tt-current="{{cond.value}}{{#if cond.ratio}}/{{cond.max}}{{/if}}"
        >
          <i class="rs-bg3-cond-icon {{cond.icon}}" style="color: {{cond.colour}};"></i>
          <span class="rs-bg3-cond-value">{{cond.value}}</span>
        </div>
        {{/if}}
        {{/each}}

        {{!--
          The view chip, parked in the tray's right-hand pad and out of flow so
          it takes no part in the centring. The arrow points the way the tray
          is about to turn, and back again once it has. Absent on an NPC, whose
          tray already carries both readings.
        --}}
        {{#if showTrayToggle}}
        <button
          type="button"
          class="rs-bg3-cond-toggle"
          data-action="toggleTrayView"
          data-tt-kind="text"
          data-tt-text="REDSTEEL.Bg3Hotbar.{{#if armorView}}ShowConditions{{else}}ShowArmor{{/if}}"
        ><i class="fas fa-chevron-{{#if armorView}}left{{else}}right{{/if}}"></i></button>
        {{/if}}
      </div>

      {{!--
        What is left of the round, in its own short channel to the right of the
        readouts. Present only inside a started encounter, and never a rule: it
        counts what was spent so it can be seen, a click corrects one star and
        a right-click hands the whole round back when the count read the action
        line wrong.

        Its own recess rather than a share of the tray's: the two answer
        different questions — what this character IS, and what it has LEFT this
        round — and a single channel holding both invites reading the stars as
        another status. Sized to its contents, so it never takes room the
        readouts could use.
      --}}
      {{#if actionTracker.show}}
      <div
        class="rs-bg3-actions-strip
          {{~#if actionTracker.density}} rs-bg3-actions-strip--{{actionTracker.density}}{{/if~}}
          {{~#unless actionTracker.editable}} locked{{/unless}}"
        data-tt-kind="text"
        data-tt-title="REDSTEEL.Bg3Hotbar.ActionTracker.title"
        data-tt-text="{{actionTracker.tip}}"
      >
        {{!--
          One half per pool, each centring its own stars in its own half rather
          than the whole run centring as one clump against the rule in the
          middle. Actions read as a set and Reactions as a set, which is how
          they are spent.
        --}}
        {{#each actionTracker.groups as |group|}}
        {{#if group.divider}}<span class="rs-bg3-pip-divider" role="separator"></span>{{/if}}
        <div class="rs-bg3-pip-group rs-bg3-pip-group--{{group.pool}}">
          {{#each group.pips as |pip|}}
          <button
            type="button"
            class="rs-bg3-pip rs-bg3-pip--{{pip.pool}}{{#if pip.spent}} spent{{/if}}"
            data-action="toggleActionPip"
            data-pool="{{pip.pool}}"
            data-index="{{pip.index}}"
            aria-label="{{pip.label}}"
          >
            <svg class="rs-bg3-pip-star" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 1 Q13 11 23 12 Q13 13 12 23 Q11 13 1 12 Q11 11 12 1 Z" />
            </svg>
          </button>
          {{/each}}
        </div>
        {{/each}}
      </div>
      {{/if}}
      </div>

      {{!-- Auto-defense, immediately left of the modifier. Only an NPC answers
           its own attack cards, and only someone who can edit it may flip the
           switch, but the box is held open either way: without the spacer the
           modifier and both trays would slide 33px sideways every time the GM
           picked a token of the other kind. --}}
      {{#if autoDefense.available}}
      <button
        type="button"
        class="rs-bg3-tray-toggle rs-bg3-autodef{{#if autoDefense.active}} active{{/if}}"
        data-action="toggleAutoDefense"
        data-tt-kind="text"
        data-tt-title="REDSTEEL.AutoDefense.Label"
        data-tt-text="REDSTEEL.AutoDefense.Tooltip"
        aria-label="{{localize 'REDSTEEL.AutoDefense.Label'}}"
        aria-pressed="{{#if autoDefense.active}}true{{else}}false{{/if}}"
      ><i class="fa-light fa-shield-halved"></i></button>
      {{else}}
      <span
        class="rs-bg3-tray-toggle rs-bg3-autodef rs-bg3-cell--spacer"
        aria-hidden="true"
      ><i class="fa-light fa-shield-halved"></i></span>
      {{/if}}

      <button
        type="button"
        class="rs-bg3-modifier rs-bg3-modifier--{{modifier.tone}}"
        data-action="openRollModifier"
        data-tt-kind="text"
        data-tt-text="REDSTEEL.Bg3Hotbar.Modifier"
        aria-label="{{localize 'REDSTEEL.Bg3Hotbar.Modifier'}}"
      >{{#if modifier.empty}}<i class="fa-light fa-dice-d10"></i>{{else}}{{modifier.text}}{{/if}}</button>

      {{!-- Potions, as a grid of what is actually in the pack --}}
      {{#if potions}}
      <div class="rs-bg3-potions-wrap">
        <button
          type="button"
          class="rs-bg3-tray-toggle"
          data-action="togglePotions"
          data-tt-kind="text"
          data-tt-text="REDSTEEL.Bg3Hotbar.Potions"
          aria-label="{{localize 'REDSTEEL.Bg3Hotbar.Potions'}}"
        ><i class="fa-light fa-flask-round-potion"></i></button>

        <div class="rs-bg3-potions" style="--rs-potion-cols: {{potions.cols}};">
          {{#each potions.items as |potion|}}
          {{#if potion.empty}}
          {{!-- A socket with nothing in it: not a button, nothing to click --}}
          <span class="rs-bg3-potion empty" aria-hidden="true"></span>
          {{else}}
          <button
            type="button"
            class="rs-bg3-potion"
            data-action="usePotionItem"
            data-item-id="{{potion.id}}"
            data-tt-kind="text"
            data-tt-text="{{potion.name}}"
            aria-label="{{potion.name}}"
          >
            <img src="{{potion.img}}" alt="{{potion.name}}" />
            <span class="rs-bg3-potion-qty">{{potion.qty}}</span>
          </button>
          {{/if}}
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{!-- Weapon set swap, with its popover rising above the panel. Only
           characters have sets, but the button is rendered either way and
           merely hidden on an NPC: removing it would shorten the status row and
           slide the roll modifier and the potion tray along with it. --}}
      <div class="rs-bg3-weaponsets-wrap">
        {{#if weaponSets}}
        <button
          type="button"
          class="rs-bg3-tray-toggle"
          data-action="toggleWeaponSets"
          data-tt-kind="text"
          data-tt-text="REDSTEEL.Bg3Hotbar.WeaponSets"
          aria-label="{{localize 'REDSTEEL.Bg3Hotbar.WeaponSets'}}"
        ><i class="fa-light fa-swords"></i></button>
        {{else}}
        <span
          class="rs-bg3-tray-toggle rs-bg3-cell--spacer"
          aria-hidden="true"
        ><i class="fa-light fa-swords"></i></span>
        {{/if}}

        {{#if weaponSets}}
        <div class="rs-bg3-weaponsets">
          {{#each weaponSets.sets as |set|}}
          <button
            type="button"
            class="rs-bg3-weaponset{{#if set.active}} active{{/if}}"
            data-action="pickWeaponSet"
            data-set="{{set.id}}"
          >
            <span class="rs-bg3-weaponset-id">{{set.id}}</span>
            <span class="rs-bg3-weaponset-slots">
              {{#if set.main.img}}
              <img src="{{set.main.img}}" alt="{{set.main.name}}" title="{{set.main.name}}" />
              {{else}}
              <span class="rs-bg3-weaponset-empty"><i class="fa-light fa-hand-fist"></i></span>
              {{/if}}

              {{!--
                A two-hander occupies the off hand, so it ghosts into that slot
                the same way the character sheet's weapon sets show it.
              --}}
              {{#if set.twoHanded}}
              <img
                class="rs-bg3-weaponset-ghost"
                src="{{set.main.img}}"
                alt="{{set.main.name}}"
                title="{{set.main.name}}"
              />
              {{else if set.off.img}}
              <img src="{{set.off.img}}" alt="{{set.off.name}}" title="{{set.off.name}}" />
              {{else}}
              <span class="rs-bg3-weaponset-empty"><i class="fa-light fa-hand"></i></span>
              {{/if}}
            </span>
          </button>
          {{/each}}
        </div>
        {{/if}}
      </div>
    </div>
    <div class="rs-bg3-section-divider" role="separator"></div>
    {{/if}}

    {{!-- ATTRIBUTES: 7 primaries, a divider, then the 5 rollable secondaries --}}
    {{#if hasAttributes}}
    <div class="rs-bg3-row rs-bg3-row--attributes" aria-label="{{localize 'REDSTEEL.Bg3Hotbar.Attributes'}}">
      <div class="rs-bg3-attr-group">
        {{#each attributes.primary as |attr|}}
        <button
          type="button"
          class="rs-bg3-attr-cell"
          {{#if attr.tint}}data-attr="{{attr.tint}}"{{/if}}
          data-action="rollAttribute"
          data-roll-type="{{attr.rollType}}"
          data-label="{{attr.key}}"
          {{#if attr.roll}}data-roll="{{attr.roll}}"{{/if}}
        >
          <span class="rs-bg3-attr-label">{{attr.label}}</span>
          <span class="rs-bg3-attr-value">{{attr.display}}</span>
        </button>
        {{/each}}
      </div>

      {{!-- The divider and the secondary group always render: #prepareAttributes
           emits a spacer for every secondary the actor lacks, so this run is
           the same width for a character and an NPC and nothing below it
           shifts. --}}
      {{#if attributes.secondary.length}}
      <div class="rs-bg3-attr-divider" role="separator"></div>
      <div class="rs-bg3-attr-group rs-bg3-attr-group--secondary">
        {{#each attributes.secondary as |attr|}}
        {{#if attr.spacer}}
        <span
          class="rs-bg3-attr-cell rs-bg3-attr-cell--secondary rs-bg3-cell--spacer"
          aria-hidden="true"
        ></span>
        {{else}}
        <button
          type="button"
          class="rs-bg3-attr-cell rs-bg3-attr-cell--secondary"
          {{#if attr.tint}}data-attr="{{attr.tint}}"{{/if}}
          data-action="rollAttribute"
          data-roll-type="{{attr.rollType}}"
          data-label="{{attr.key}}"
          {{#if attr.roll}}data-roll="{{attr.roll}}"{{/if}}
        >
          <span class="rs-bg3-attr-label">{{attr.label}}</span>
          <span class="rs-bg3-attr-value">{{attr.display}}</span>
        </button>
        {{/if}}
        {{/each}}
      </div>
      {{/if}}
    </div>
    <div class="rs-bg3-section-divider" role="separator"></div>
    {{/if}}

    {{!-- NPC TAGS: traits, resistances and immunities. NPC only, but always
         present for one, so the rows below do not shift as you click between
         tokens. A creature with none of the three says so. --}}
    {{#if npcTags}}
    <div class="rs-bg3-row rs-bg3-row--npctags">
      {{#if npcTags.empty}}
      <span class="rs-bg3-npctag-label rs-bg3-npctag-label--empty"
        >{{localize "REDSTEEL.Bg3Hotbar.NoTags"}}</span>
      {{/if}}
      {{#each npcTags.groups as |group|}}
      <span class="rs-bg3-npctag-label">{{localize group.label}}</span>
      {{#each group.tags as |tag|}}
      <span
        class="rs-bg3-npctag"
        {{!-- `group`, not `../group`: it is a block param, so it stays in
             lexical scope inside this inner each. --}}
        data-kind="{{group.kind}}"
        {{!-- Race and feature tags stand for an Item, so they get its
             description; the armor and damage-modifier tags are just numbers
             and carry neither. --}}
        {{#if tag.uuid}}data-tt-kind="bg3NpcTag" data-tt-uuid="{{tag.uuid}}"{{/if}}
      >{{tag.name}}</span>
      {{/each}}
      {{/each}}
    </div>
    <div class="rs-bg3-section-divider" role="separator"></div>
    {{/if}}

    {{!-- SKILL CHECKS: 10 favourite slots, laid out as two rows of five --}}
    {{#if hasSkills}}
    {{#each skillRows as |skillRow|}}
    <div class="rs-bg3-row rs-bg3-row--skills" aria-label="{{localize 'REDSTEEL.Bg3Hotbar.Skills'}}">
      {{#each skillRow as |slot|}}
        {{#if slot.filled}}
        <button
          type="button"
          class="rs-bg3-skill-slot filled"
          {{#if slot.tint}}data-attr="{{slot.tint}}"{{/if}}
          data-action="rollSkill"
          data-index="{{slot.index}}"
          data-roll-type="skill"
          data-label="{{slot.key}}"
          data-roll="{{slot.roll}}"
          data-tt-kind="skill"
          data-tt-id="{{slot.key}}"
        >
          <span class="rs-bg3-skill-name">{{slot.label}}</span>
          <span class="rs-bg3-skill-rating">{{slot.rating}}</span>
        </button>
        {{else if slot.canPick}}
        <button
          type="button"
          class="rs-bg3-skill-slot empty"
          data-action="pickSkill"
          data-index="{{slot.index}}"
          data-tt-kind="text"
          data-tt-text="REDSTEEL.Bg3Hotbar.PickSkill"
        >
          <span class="rs-bg3-skill-plus">+</span>
        </button>
        {{else}}
        <div class="rs-bg3-skill-slot empty locked" data-index="{{slot.index}}"></div>
        {{/if}}
      {{/each}}
    </div>
    {{/each}}
    <div class="rs-bg3-section-divider" role="separator"></div>
    {{/if}}

    {{!--
      ACTION ROW: the preset hotbar macros as buttons. Same `game.redsteel`
      entry points the macros call, so the macro rows can stay at zero.
    --}}
    {{#if actions.length}}
    <div class="rs-bg3-row rs-bg3-row--actions">
      {{#each actions as |act|}}
      <button
        type="button"
        class="rs-bg3-action{{#if act.groupStart}} rs-bg3-action--group{{/if}}"
        data-action="runAction"
        data-act="{{act.key}}"
        data-tt-kind="text"
        data-tt-text="REDSTEEL.Bg3Hotbar.Action.{{act.key}}"
        aria-label="{{act.label}}"
      ><i class="{{act.icon}}"></i></button>
      {{/each}}
    </div>
    {{!-- Macro rows default to none, and a rule with nothing under it is just
         a line along the bottom of the panel. --}}
    {{#if macroRows.length}}
    <div class="rs-bg3-section-divider" role="separator"></div>
    {{/if}}
    {{/if}}

    {{!-- MACRO ROWS: one per hotbar page, page 1 last so it renders lowest --}}
    {{#each macroRows as |row|}}
    <div class="rs-bg3-row rs-bg3-row--macros" data-page="{{row.page}}">
      <div class="rs-bg3-macro-slots">
        {{#each row.slots as |slot|}}
          {{#if slot.filled}}
          <div
            class="rs-bg3-macro-slot filled"
            draggable="true"
            data-action="executeMacro"
            data-slot="{{slot.slot}}"
            data-macro-id="{{slot.macroId}}"
            data-tt-kind="text"
            data-tt-text="{{slot.name}}"
            role="button"
          >
            <img class="rs-bg3-macro-img" src="{{slot.img}}" alt="{{slot.name}}" />
          </div>
          {{else}}
          <div class="rs-bg3-macro-slot empty" data-slot="{{slot.slot}}">
            {{#if slot.keyLabel}}<span class="rs-bg3-macro-key">{{slot.keyLabel}}</span>{{/if}}
          </div>
          {{/if}}
        {{/each}}
      </div>
    </div>
    {{/each}}

    </div>
  </div>

  {{!--
    The right wing: the token conditions the character is carrying, as a column
    of icons. Same tucked extension as the resource columns on the left,
    mirrored. GMs can edit one by clicking it and remove it by right-clicking;
    there is deliberately no way to add one from here.

    The box is rendered for any actor, carrying conditions or not, so the
    wrench below it keeps its place as effects come and go.
  --}}
  <div class="rs-bg3-right">

  {{#if hasActor}}
  {{!--
    Frame outside, tray inside, the same two layers the bar itself has: the
    sockets are cut into the panel rather than being boxes stood on it. The
    icons fill the tray from the top, so the first condition on a character is
    always in the same place and the column grows downward as more land.
  --}}
  <div class="rs-bg3-status-strip" style="--rs-status-cols: {{statusCols}};">
    <div class="rs-bg3-status-tray">
    {{#each statuses as |eff|}}
    <div
      class="rs-bg3-effect{{#if eff.disabled}} disabled{{/if}}{{#if eff.canManage}} manageable{{/if}}"
      data-uuid="{{eff.uuid}}"
      {{#if eff.canManage}}data-action="editEffect"{{/if}}
      data-tt-kind="text"
      data-tt-title="{{eff.name}}"
      data-tt-text="{{#if eff.canManage}}REDSTEEL.Bg3Hotbar.EffectManage{{else}}REDSTEEL.Bg3Hotbar.EffectView{{/if}}"
    >
      <img src="{{eff.img}}" alt="{{eff.name}}" />
    </div>
    {{/each}}
    </div>
  </div>
  {{/if}}

  {{!--
    Bar settings: outside the frame, bottom right corner. Everything about the
    shape of the panel is set from here rather than from controls along its edge.
  --}}
  <div class="rs-bg3-side-controls">
    <button
      type="button"
      class="rs-bg3-settings-button"
      data-action="openSettings"
      data-tt-kind="text"
      data-tt-text="REDSTEEL.Bg3Hotbar.SettingsTooltip"
      aria-label="{{localize 'REDSTEEL.Bg3Hotbar.SettingsTitle'}}"
    ><i class="fas fa-wrench"></i></button>
  </div>

  </div>

</div>
</div>
