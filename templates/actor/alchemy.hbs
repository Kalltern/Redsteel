{{! Alchemy Tab }}
<section
  class="tab alchemy {{tab.cssClass}}"
  data-group="primary"
  data-tab="alchemy"
>
  <div class="alchemy-box">

    {{! ===== Substance stock strip ===== }}
    <div class="alchemy-substance-strip">
      {{#each alchSubstances as |sub|}}
        <div
          class="alch-substance {{#if sub.canBrew}}brewable{{/if}}"
          style="--alch-color: {{sub.color}};"
          data-action="brewSubstance"
          data-substance="{{sub.key}}"
          title="{{sub.label}} ({{sub.code}}) — {{localize 'REDSTEEL.Alchemy.Substance.TileHint'}}"
        >
          <span class="alch-substance-label">{{sub.label}}</span>
          <div class="alch-substance-body">
            <img class="alch-substance-icon" src="{{sub.icon}}" width="36" height="36" />
            <div class="alch-substance-stats">
              <span class="alch-substance-qty">{{sub.qty}}</span>
              <span class="alch-substance-herbs">
                <i class="fas fa-seedling"></i> {{sub.herbs}}/{{sub.herbCost}}
              </span>
            </div>
          </div>
        </div>
      {{/each}}
    </div>

    <div class="alchemy-columns">

      {{! ===== Recipes (left) ===== }}
      <section class="npc-traits alchemy-recipes">
        <header class="npc-traits-header">
          <h3>{{localize "REDSTEEL.Alchemy.Recipes"}}</h3>
          {{#if @root.editable}}
            <a
              class="item-control item-create"
              title="{{localize 'DOCUMENT.New' type='recipe'}}"
              data-action="createDoc"
              data-document-class="Item"
              data-type="recipe"
            >
              <i class="fas fa-plus"></i>
            </a>
          {{/if}}
        </header>

        {{! Filters sit between the header and the list; both are transient
            sheet state, never stored on the actor. }}
        <div class="alch-recipe-filters">
          {{! Custom dropdown, not a <select>: the native option list is OS
              chrome and drops open with a blue selection bar no CSS can reach. }}
          <div class="rs-select alch-type-filter" data-value="{{alchTypeFilter}}">
            <button type="button" class="rs-select-trigger">
              <span class="rs-select-value">{{alchTypeFilterLabel}}</span>
              <i class="fas fa-caret-down"></i>
            </button>
            <ul class="rs-select-menu">
              {{#each alchTypeFilters as |filter|}}
                <li
                  class="rs-select-option {{#if filter.selected}}selected{{/if}}"
                  data-value="{{filter.key}}"
                >
                  {{filter.label}}
                </li>
              {{/each}}
            </ul>
          </div>
          <button
            type="button"
            class="alch-craftable-filter {{#if alchCraftableOnly}}active{{/if}}"
            data-action="toggleCraftableFilter"
            title="{{localize 'REDSTEEL.Alchemy.Filter.CraftableHint'}}"
          >
            <i class="fas fa-mortar-pestle"></i>
            {{localize "REDSTEEL.Alchemy.Filter.Craftable"}}
          </button>
        </div>

        <ul class="npc-traits-grid alchemy-recipe-list">
          {{#each alchRecipes as |entry|}}
            {{! The card is icon + name only; the description rides the stacked
                tooltip system (data-tt-kind), which parks the panel in the free
                margin beside the sheet, same as the spell cards. }}
            <li
              class="npc-trait alch-recipe {{#if entry.selected}}selected{{/if}}"
              data-item-id="{{entry.item.id}}"
              data-document-class="Item"
              data-action="selectRecipe"
              data-drag="true"
              data-tt-kind="item"
              data-tt-id="{{entry.item.id}}"
              data-purpose="{{entry.purpose}}"
              {{#if entry.purposeColor}}style="--alch-purpose: {{entry.purposeColor}};"{{/if}}
            >
              <span class="npc-trait-icon">
                <img src="{{entry.item.img}}" width="38" height="38" />
              </span>
              <div class="npc-trait-main">
                <div class="npc-trait-top">
                  <span class="npc-trait-name">{{entry.displayName}}</span>
                  <span class="npc-trait-controls">
                    <a
                      class="item-control item-edit"
                      title="{{localize 'DOCUMENT.Update' type='recipe'}}"
                      data-action="viewDoc"
                    >
                      <i class="fas fa-edit"></i>
                    </a>
                    {{#if @root.editable}}
                      <a
                        class="item-control item-delete"
                        title="{{localize 'DOCUMENT.Delete' type='recipe'}}"
                        data-action="deleteDoc"
                      >
                        <i class="fas fa-trash"></i>
                      </a>
                    {{/if}}
                  </span>
                </div>
              </div>
            </li>
          {{else}}
            <li class="alch-empty-hint">
              {{#if alchFiltered}}
                {{localize "REDSTEEL.Alchemy.Filter.NoMatches"}}
              {{else}}
                {{localize "REDSTEEL.Alchemy.NoRecipes"}}
              {{/if}}
            </li>
          {{/each}}
        </ul>
      </section>

      {{! ===== Crafting panel (right) ===== }}
      <section class="npc-traits alchemy-craft-panel">
        <header class="npc-traits-header">
          <h3>{{localize "REDSTEEL.Alchemy.Crafting"}}</h3>
        </header>

        {{! Station + amount — deliberately unnamed inputs: read via JS, never
            submitted to the actor (sheet is submitOnChange). }}
        <div class="alch-controls">
          <label class="alch-control-label">{{localize "REDSTEEL.Alchemy.StationLabel"}}</label>
          <div class="rs-select alch-station" data-value="{{alchStation}}">
            <button type="button" class="rs-select-trigger">
              <span class="rs-select-value">{{alchStationLabel}}</span>
              <i class="fas fa-caret-down"></i>
            </button>
            <ul class="rs-select-menu">
              {{#each alchStations as |station|}}
                <li
                  class="rs-select-option {{#if station.selected}}selected{{/if}}"
                  data-value="{{station.key}}"
                >
                  {{station.label}} ({{station.modLabel}})
                </li>
              {{/each}}
            </ul>
          </div>

          {{! Batch size and what it costs, side by side: the stepper clamps to
              1..max, and each tile shows held/needed for that batch. }}
          <div class="alch-batch">
            <div class="alch-amount-box">
              <label class="alch-control-label">{{localize "REDSTEEL.Alchemy.Amount"}}</label>
              <div class="alch-amount-field">
                <input
                  type="number"
                  class="alch-amount"
                  min="1"
                  max="{{alchMaxAmount}}"
                  step="1"
                  value="{{alchAmount}}"
                />
                <span class="alch-amount-steps">
                  <button
                    type="button"
                    class="alch-amount-step"
                    data-action="stepCraftAmount"
                    data-step="1"
                  >
                    <i class="fas fa-caret-up"></i>
                  </button>
                  <button
                    type="button"
                    class="alch-amount-step"
                    data-action="stepCraftAmount"
                    data-step="-1"
                  >
                    <i class="fas fa-caret-down"></i>
                  </button>
                </span>
              </div>
            </div>

            {{#if alchStock}}
              <div class="alch-stock">
                {{#each alchStock.lines as |line|}}
                  <div
                    class="alch-stock-item {{#if line.ok}}ok{{else}}short{{/if}}"
                    title="{{line.label}}"
                  >
                    <img src="{{line.icon}}" width="30" height="30" />
                    <span class="alch-stock-count">{{line.have}}/{{line.need}}</span>
                  </div>
                {{/each}}
              </div>
            {{/if}}
          </div>
        </div>

        {{#if alchBoons.length}}
          <div class="alch-boons">
            <span class="alch-boons-label">{{localize "REDSTEEL.Alchemy.Chat.Boons"}}:</span>
            {{#each alchBoons as |boon|}}
              <span class="alch-boon">{{boon}}</span>
            {{/each}}
          </div>
        {{/if}}

        <div class="alch-buttons">
          <button
            type="button"
            class="alch-craft-btn"
            data-action="craftRecipe"
            {{#unless alchCanCraft}}disabled{{/unless}}
            title="{{localize 'REDSTEEL.Alchemy.CraftHint'}}"
          >
            <i class="fas fa-flask"></i> {{localize "REDSTEEL.Alchemy.Craft"}}
          </button>
          <button
            type="button"
            class="alch-reroll-btn"
            data-action="rerollCraft"
            {{#unless alchCanReroll}}disabled{{/unless}}
            title="{{localize 'REDSTEEL.Alchemy.RerollHint'}}"
          >
            <i class="fas fa-rotate"></i> {{localize "REDSTEEL.Alchemy.Reroll"}}
          </button>
        </div>

        <div class="alch-announcement {{#if alchAnnouncement}}{{#if alchAnnouncement.success}}success{{else}}failure{{/if}}{{/if}}">
          {{#if alchAnnouncement}}
            <div class="alch-announcement-text">{{alchAnnouncement.text}}</div>
            <div class="alch-announcement-detail">{{alchAnnouncement.detail}}</div>
          {{else}}
            <div class="alch-announcement-placeholder">{{localize "REDSTEEL.Alchemy.AnnouncementPlaceholder"}}</div>
          {{/if}}
        </div>
      </section>

    </div>
  </div>
</section>
