{{!-- Character Creation — step 1 (Origin): race, attributes, traits, info.

     ApplicationV2 requires each template part to render exactly ONE root
     element, so the title bar, the columns and the footer all live inside
     this wrapper.

     data-tt-beside: the screen fills the viewport, so the system tooltips
     (racial features in the info panel) open beside what was hovered, as in
     the Learn window. --}}
<div class="rs-create-body" data-tt-beside>

  {{!-- One trait tile, used by the list to pick from (left) and by the
        picked list (centre). It carries its kind itself, so it keeps its
        colour wherever it sits. --}}
  {{#*inline "traitTile"}}
  <button type="button"
          class="rs-create-trait is-{{kind}} {{#if selected}}is-selected{{/if}} {{#if disabled}}is-disabled{{/if}}"
          data-action="toggleTrait" data-trait="{{id}}" data-info="trait:{{id}}"
          aria-label="{{label}} ({{price}})"
          {{#if disabled}}aria-disabled="true"{{/if}}>
    <span class="rs-create-trait-icon"><img src="{{img}}" alt=""></span>
    <span class="rs-create-trait-ribbon">
      <span class="rs-create-trait-name">{{label}}</span>
      <span class="rs-create-trait-price">{{price}}</span>
    </span>
  </button>
  {{/inline}}

  {{#if loading}}
  {{!-- Shown at once while the compendium data loads (first open of the
        session); the window re-renders into the screen proper when it is in. --}}
  <div class="rs-create-loading" role="status" aria-live="polite">
    <i class="rs-create-loading-die fa-solid fa-dice-d20"></i>
    <span class="rs-create-loading-text">{{loadingText}}</span>
  </div>
  {{else}}

  <header class="rs-create-titlebar">
    <div class="rs-create-heading">
      <span class="rs-create-kicker">{{localize "REDSTEEL.Creation.title"}}</span>
      <h1 class="rs-create-step-title">{{stepTitle}}</h1>
    </div>
    <div class="rs-create-step-of">{{stepOf}}</div>
  </header>
  <div class="rs-create-progress"><div class="rs-create-progress-fill" style="width: {{progress}}%"></div></div>

  <div class="rs-create-columns {{#if isStep2}}is-doctrine-step{{/if}}">

    {{#if isStep2}}
    {{!-- Step 2 — Doctrine: every doctrine the character may train in, by
          kind. Taking one adds it to the character's skills; no rank is
          bought here. Magical ones need Magic potential (greyed out without
          it); Cordinas is not offered (it needs a specialisation). --}}
    <section class="rs-create-panel rs-create-doctrines">
      <h2 class="rs-create-panel-title">{{localize "REDSTEEL.Creation.Doctrine.heading"}}</h2>
      <div class="rs-create-scroll">
        <p class="rs-create-doctrine-advice">{{localize "REDSTEEL.Creation.Doctrine.advice"}}</p>
        {{#if doctrineWarning}}
        <p class="rs-create-doctrine-warning">{{localize "REDSTEEL.Creation.Doctrine.tooMany"}}</p>
        {{/if}}
        {{#each doctrineKinds}}
        <div class="rs-create-doctrine-block is-{{this.kind}}">
          <div class="rs-create-group-label">{{this.label}}</div>
          {{!-- One card per doctrine: its crest (the first ability it teaches),
                its name, and the ladder of abilities its ranks unlock (hover
                an icon for the ability). Taken: gold frame and seal. Locked:
                greyed out under a padlock. --}}
          <div class="rs-create-doctrine-grid">
            {{#each this.doctrines}}
            {{!-- A div, not a <button>: a button centres its content
                  vertically, which set every card's crest at a different
                  height depending on how long its ladder is. --}}
            <div role="button" tabindex="0"
                    class="rs-create-doctrine-card is-{{this.kind}} {{#if this.selected}}is-selected{{/if}} {{#if this.locked}}is-locked{{/if}}"
                    data-action="toggleDoctrine" data-doctrine="{{this.key}}" data-info="doctrine:{{this.key}}"
                    aria-pressed="{{#if this.selected}}true{{else}}false{{/if}}"
                    {{#if this.disabled}}aria-disabled="true"{{/if}}>
              <span class="rs-dc-crest"><img src="{{this.crest}}" alt=""></span>
              <span class="rs-dc-kind">{{this.kindLabel}}</span>
              <span class="rs-dc-name">{{this.label}}</span>
              <span class="rs-dc-rule"></span>
              {{#if this.ladder.length}}
              <span class="rs-dc-ladder" style="--rs-dc-cols: {{this.ladderCols}}">
                {{#each this.ladder}}
                <span class="rs-dc-step" data-tt-kind="creationFeature" data-tt-id="{{this.id}}">
                  <img src="{{this.img}}" alt="">
                  <em>{{this.numeral}}</em>
                </span>
                {{/each}}
              </span>
              {{/if}}
              {{#if this.locked}}
              <span class="rs-dc-lock"><i class="fa-solid fa-lock"></i>{{localize "REDSTEEL.Creation.Doctrine.needsMagic"}}</span>
              {{/if}}
              {{#if this.selected}}
              <span class="rs-dc-seal">{{localize "REDSTEEL.Creation.Doctrine.chosen"}}</span>
              {{/if}}
            </div>
            {{/each}}
          </div>
        </div>
        {{/each}}
      </div>
    </section>
    {{else}}

    {{!-- Left column: the name, then the traits still to pick. --}}
    <section class="rs-create-panel rs-create-origin">
      <h2 class="rs-create-panel-title">{{localize "REDSTEEL.Creation.Identity"}}</h2>
      <div class="rs-create-scroll">
        <div class="rs-create-identity">
          <label class="rs-create-name-row">
            <span class="rs-create-select-label">{{localize "REDSTEEL.Creation.Name"}}</span>
            <input type="text" data-draft="name" value="{{identity.name}}"
                   placeholder="{{localize 'REDSTEEL.Creation.Name'}}" {{#unless editable}}disabled{{/unless}}>
          </label>
        </div>

        {{!-- Traits still to pick. A picked trait moves to the centre column. --}}
        <div class="rs-create-traits {{#unless hasRace}}is-locked{{/unless}}">
          <h2 class="rs-create-panel-title is-inline">{{localize "REDSTEEL.Creation.Traits"}}</h2>
          <div class="rs-create-counter">
            <span class="{{#if traitOverspent}}is-over{{/if}}">{{traitPointsRemaining}}</span>
            <span>{{traitCount}}</span>
          </div>
          {{#unless hasRace}}<p class="rs-create-hint">{{localize "REDSTEEL.Creation.chooseRaceFirst"}}</p>{{/unless}}
          {{#each traitSections}}
          {{#if this.traits.length}}
          {{!-- Trait rows framed by kind (green positive, yellow neutral, red
                negative), each with a ribbon carrying the name and the cost. --}}
          <div class="rs-create-trait-section is-{{this.kind}}">
            <div class="rs-create-group-label">{{this.label}}</div>
            <div class="rs-create-trait-grid">
              {{#each this.traits}}
              {{> traitTile this}}
              {{/each}}
            </div>
          </div>
          {{/if}}
          {{/each}}
        </div>
      </div>
    </section>

    {{!-- Centre column: race buttons, subrace buttons when the race has any;
          the attribute buy with the racial picks as squares on each
          attribute's own row; then the picked traits. --}}
    <section class="rs-create-panel rs-create-build">
      <h2 class="rs-create-panel-title">{{localize "REDSTEEL.Creation.RaceHeading"}}</h2>
      <div class="rs-create-scroll">
        {{!-- No race yet: the race buttons are framed and lit so the eye
              starts here; attributes and traits stay locked until then. --}}
        <div class="rs-create-race-pick {{#unless hasRace}}is-prompt{{/unless}}">
        {{#unless hasRace}}<p class="rs-create-race-prompt">{{localize "REDSTEEL.Creation.raceStartHere"}}</p>{{/unless}}
        <div class="rs-create-race-row">
          {{#each raceOptions}}
          <button type="button" class="rs-create-race {{#if this.selected}}is-selected{{/if}}"
                  data-action="pickRace" data-group="{{this.key}}"
                  {{#unless @root.editable}}disabled{{/unless}}>{{this.label}}</button>
          {{/each}}
        </div>
        {{#if subraceOptions.length}}
        <div class="rs-create-race-row is-sub">
          {{#each subraceOptions}}
          <button type="button" class="rs-create-race {{#if this.selected}}is-selected{{/if}}"
                  data-action="pickRace" data-race="{{this.key}}" data-info="race:{{this.key}}"
                  {{#unless @root.editable}}disabled{{/unless}}>{{this.label}}</button>
          {{/each}}
        </div>
        {{/if}}
        </div>
        {{#if raceRequirement}}<p class="rs-create-race-req">{{raceRequirement}}</p>{{/if}}

        <h2 class="rs-create-panel-title is-inline">{{localize "REDSTEEL.Creation.Attributes"}}</h2>
        <div class="rs-create-attributes {{#unless hasRace}}is-locked{{/unless}}">
          <div class="rs-create-counter">{{pointsRemaining}}</div>
          {{#unless hasRace}}<p class="rs-create-hint">{{localize "REDSTEEL.Creation.chooseRaceFirst"}}</p>{{/unless}}

          {{#if choiceHeads.length}}
          {{!-- Column heads for the squares: one per pick column, with its
                group's name (numbered when the group takes more than one). --}}
          <div class="rs-create-attr is-head" style="{{attrGrid}}">
            <span></span><span></span><span></span><span></span>
            {{#each choiceHeads}}
            <span class="rs-create-choice-head {{#if this.complete}}is-complete{{/if}}">
              <span class="rs-create-choice-head-name">{{this.label}}</span>
              <em>{{this.pick}}</em>
            </span>
            {{/each}}
            <span></span>
          </div>
          {{/if}}

          {{#each attributes}}
          <div class="rs-create-attr is-ribbon attr-row-{{this.key}} {{#if this.hasChoice}}has-choice{{/if}} {{#if this.capRaised}}is-cap-raised{{/if}}" style="{{@root.attrGrid}}"
               data-attr="{{this.key}}" data-info="attr:{{this.key}}">
            <span class="rs-create-attr-name attr-{{this.key}}">{{this.label}}</span>
            <button type="button" class="rs-create-step-btn" data-action="attrDown" data-attr="{{this.key}}"
                    aria-label="-" {{#unless this.canDown}}disabled{{/unless}}>&minus;</button>
            <span class="rs-create-attr-total">{{this.total}}{{#if @root.hasRace}}<span class="rs-create-attr-limit"> / {{this.limit}}</span>{{/if}}</span>
            <button type="button" class="rs-create-step-btn" data-action="attrUp" data-attr="{{this.key}}"
                    aria-label="+" {{#unless this.canUp}}disabled{{/unless}}>+</button>
            {{#each this.choices}}
            {{#if this.option}}
            <button type="button" class="rs-create-square {{#if this.selected}}is-selected{{/if}} {{#if this.elsewhere}}is-elsewhere{{/if}} {{#if this.option.raisesLimit}}raises-limit{{/if}}"
                    data-action="pickChoice" data-group="{{this.group}}" data-slot="{{this.slot}}" data-effect="{{this.option.id}}"
                    data-tooltip="{{this.tooltip}}" aria-label="{{this.tooltip}}"
                    {{#unless @root.editable}}disabled{{/unless}}></button>
            {{else}}
            <span class="rs-create-square is-empty"></span>
            {{/if}}
            {{/each}}
            <span></span>
          </div>
          {{/each}}

          {{#if hasLooseChoices}}
          <div class="rs-create-choices">
            {{#each choiceGroups}}
            {{#each this.loose}}
            <button type="button" class="rs-create-choice {{#if this.selected}}is-selected{{/if}}"
                    data-action="pickChoice" data-group="{{../index}}" data-effect="{{this.id}}"
                    {{#unless @root.editable}}disabled{{/unless}}>
              <span class="rs-create-choice-mark"></span>
              <span>{{this.label}}</span>
            </button>
            {{/each}}
            {{/each}}
          </div>
          {{/if}}
        </div>

        {{!-- Picked traits: click one to give it back. --}}
        <div class="rs-create-picked">
          <h2 class="rs-create-panel-title is-inline">{{localize "REDSTEEL.Creation.PickedTraits"}}</h2>
          <div class="rs-create-counter">
            <span class="{{#if traitOverspent}}is-over{{/if}}">{{traitPointsRemaining}}</span>
            <span>{{traitCount}}</span>
          </div>
          {{#if hasPickedTraits}}
          {{!-- Three columns: positive, neutral, negative. --}}
          <div class="rs-create-picked-columns">
            {{#each pickedColumns}}
            <div class="rs-create-trait-section rs-create-picked-column is-{{this.kind}}">
              <div class="rs-create-group-label">{{this.label}}</div>
              {{#each this.traits}}
              {{> traitTile this}}
              {{/each}}
            </div>
            {{/each}}
          </div>
          {{else}}
          <p class="rs-create-hint">{{localize "REDSTEEL.Creation.noPickedTraits"}}</p>
          {{/if}}
        </div>
      </div>
    </section>

    {{/if}}

    {{!-- Info --}}
    <aside class="rs-create-panel rs-create-info">
      <h2 class="rs-create-panel-title">{{localize "REDSTEEL.Creation.Info.title"}}</h2>
      <div class="rs-create-scroll">
        {{#if infoHtml}}{{{infoHtml}}}{{else if (and isStep1 (not hasRace))}}<p class="rs-create-race-prompt is-info">{{localize "REDSTEEL.Creation.raceStartHereInfo"}}</p>{{else}}<p class="rs-create-hint">{{localize "REDSTEEL.Creation.Info.empty"}}</p>{{/if}}
      </div>
    </aside>

  </div>

  <footer class="rs-create-footer">
    <button type="button" class="rs-create-btn" data-action="back" {{#if isFirstStep}}disabled{{/if}}>
      &larr; {{localize "REDSTEEL.Creation.back"}}
    </button>
    <div class="rs-create-footer-right">
      <button type="button" class="rs-create-btn" data-action="closeScreen">
        {{localize "REDSTEEL.Creation.close"}}
      </button>
      {{#if isLastStep}}
      <button type="button" class="rs-create-btn is-primary" data-action="finish" {{#unless editable}}disabled{{/unless}}>
        {{localize "REDSTEEL.Creation.finish"}}
      </button>
      {{else}}
      <button type="button" class="rs-create-btn is-primary" data-action="next" {{#unless editable}}disabled{{/unless}}>
        {{localize "REDSTEEL.Creation.next"}} &rarr;
      </button>
      {{/if}}
    </div>
  </footer>
  {{/if}}

</div>
