{{! Features Tab }}
<section
  class="tab features {{tab.cssClass}}"
  data-group="primary"
  data-tab="features"
>
  <div class="features-box">

    {{! Sub-tabs. The active one is remembered per user between sessions
        (flags.redsteel.lastDialogTabs, key "actor-features"), defaulting to
        Rerolls because that is the panel used mid-session. }}
    <nav class="tabs features-subtabs" data-group="features-subtabs" data-action="tab">
      <a
        class="item subtab-link {{#if (eq activeFeaturesSubtab 'featureList')}}active{{/if}}"
        data-group="features-subtabs"
        data-tab="featureList"
      >
        {{localize "REDSTEEL.Actor.Character.Sections.Features"}}
      </a>
      <a
        class="item subtab-link {{#if (eq activeFeaturesSubtab 'traitList')}}active{{/if}}"
        data-group="features-subtabs"
        data-tab="traitList"
      >
        {{localize "REDSTEEL.Actor.Character.Sections.Traits"}}
      </a>
      <a
        class="item subtab-link {{#if (or (eq activeFeaturesSubtab 'rerolls') (not activeFeaturesSubtab))}}active{{/if}}"
        data-group="features-subtabs"
        data-tab="rerolls"
      >
        {{localize "REDSTEEL.Actor.Character.Sections.Rerolls"}}
      </a>
    </nav>

    <section
      class="tab features-subtab {{#if (eq activeFeaturesSubtab 'featureList')}}active{{/if}}"
      data-group="features-subtabs"
      data-tab="featureList"
    >
    {{! ===== Features ===== }}
    <section class="npc-traits">
      <header class="npc-traits-header">
        <h3>{{localize "Features"}}</h3>
        {{#if @root.editable}}
          <a
            class="item-control item-create"
            title="{{localize 'DOCUMENT.New' type='feature'}}"
            data-action="createDoc"
            data-document-class="Item"
            data-type="feature"
            data-system.option="feature"
          >
            <i class="fas fa-plus"></i>
          </a>
        {{/if}}
      </header>

      <ul class="npc-traits-grid">
        {{#each features as |item|}}
          {{#if (eq item.system.option "feature")}}
          <li
            class="npc-trait"
            data-item-id="{{item._id}}"
            data-document-class="Item"
            data-drag="true"
          >
            <a class="npc-trait-icon rollable" data-action="roll" data-roll-type="item">
              <img src="{{item.img}}" data-item-id="{{item.id}}" width="48" height="48" />
            </a>
            <div class="npc-trait-main">
              <div class="npc-trait-top">
                <span class="npc-trait-name">{{item.localizedName}}</span>
                <span class="npc-trait-controls">
                  <a
                    class="item-control item-edit"
                    title="{{localize 'DOCUMENT.Update' type='feature'}}"
                    data-action="viewDoc"
                  >
                    <i class="fas fa-edit"></i>
                  </a>
                  {{#if @root.editable}}
                    <a
                      class="item-control item-delete"
                      title="{{localize 'DOCUMENT.Delete' type='feature'}}"
                      data-action="deleteDoc"
                    >
                      <i class="fas fa-trash"></i>
                    </a>
                  {{/if}}
                </span>
              </div>
              {{#if item.system.weaponSpec.tier}}
                <a
                  class="weapon-spec-badge {{#unless item.system.weaponSpec.tag}}needs-choice{{/unless}}"
                  data-action="chooseWeaponSpec"
                  data-item-id="{{item._id}}"
                  title="Choose the weapon this specialization applies to"
                >
                  {{#if item.system.weaponSpec.tag}}
                    <i class="fas fa-crosshairs"></i> {{item.system.weaponSpec.tag}}
                  {{else}}
                    <i class="fas fa-exclamation-triangle"></i> Choose weapon
                  {{/if}}
                </a>
              {{/if}}
              <div class="npc-trait-desc">{{{item.localizedDescription}}}</div>
            </div>
          </li>
          {{/if}}
        {{/each}}
      </ul>
    </section>
    </section>

    <section
      class="tab features-subtab {{#if (eq activeFeaturesSubtab 'traitList')}}active{{/if}}"
      data-group="features-subtabs"
      data-tab="traitList"
    >
    {{! ===== Traits ===== }}
    <section class="npc-traits">
      <header class="npc-traits-header">
        <h3>{{localize "Traits"}}</h3>
        {{#if @root.editable}}
          <a
            class="item-control item-create"
            title="{{localize 'DOCUMENT.New' type='feature'}}"
            data-action="createDoc"
            data-document-class="Item"
            data-type="feature"
            data-system.option="trait"
          >
            <i class="fas fa-plus"></i>
          </a>
        {{/if}}
      </header>

      <ul class="npc-traits-grid">
        {{#each features as |item|}}
          {{#if (eq item.system.option "trait")}}
          <li
            class="npc-trait"
            data-item-id="{{item._id}}"
            data-document-class="Item"
            data-drag="true"
          >
            <a class="npc-trait-icon rollable" data-action="roll" data-roll-type="item">
              <img src="{{item.img}}" data-item-id="{{item.id}}" width="48" height="48" />
            </a>
            <div class="npc-trait-main">
              <div class="npc-trait-top">
                <span class="npc-trait-name">{{item.localizedName}}</span>
                <span class="npc-trait-controls">
                  <a
                    class="item-control item-edit"
                    title="{{localize 'DOCUMENT.Update' type='feature'}}"
                    data-action="viewDoc"
                  >
                    <i class="fas fa-edit"></i>
                  </a>
                  {{#if @root.editable}}
                    <a
                      class="item-control item-delete"
                      title="{{localize 'DOCUMENT.Delete' type='feature'}}"
                      data-action="deleteDoc"
                    >
                      <i class="fas fa-trash"></i>
                    </a>
                  {{/if}}
                </span>
              </div>
              <div class="npc-trait-desc">{{{item.localizedDescription}}}</div>
            </div>
          </li>
          {{/if}}
        {{/each}}
      </ul>
    </section>
    </section>

    <section
      class="tab features-subtab {{#if (or (eq activeFeaturesSubtab 'rerolls') (not activeFeaturesSubtab))}}active{{/if}}"
      data-group="features-subtabs"
      data-tab="rerolls"
    >
    <section class="npc-traits">
      <ul class="reroll-grid">
        {{#each rerollPools as |pool|}}
        <li
          class="reroll-box {{#unless pool.remaining}}depleted{{/unless}}"
          data-item-id="{{pool.itemId}}"
          data-pool-index="{{pool.poolIndex}}"
          data-action="toggleReroll"
          title="Click to spend or restore one reroll"
        >
          <img class="reroll-box-icon" src="{{pool.img}}" width="36" height="36" />
          <span class="reroll-box-name">
            {{pool.label}}
            {{#if pool.universal}}<span class="reroll-box-tag">Universal</span>{{/if}}
          </span>
          <span class="reroll-count {{#if pool.remaining}}active{{/if}}">{{pool.remaining}}/{{pool.max}}</span>
        </li>
        {{/each}}
      </ul>
    </section>
    </section>

  </div>
</section>
