{{! Inventory Tab }}
<section
  class="tab inventory {{tab.cssClass}}"
  data-group="primary"
  data-tab="inventory"
>
<div class="inventory-box">
{{!-- One frame around the whole tab: loadout, accessories, purse and grid --}}
<section class="inventory-frame">

{{#if (eq actor.type "character")}}

{{!-- EQUIPMENT: armor and weapon sets share one row, accessories span below --}}
<div class="equipment-groups">

<div class="loadout-group armor-group">
  <div class="loadout-group-label">{{localize "REDSTEEL.Actor.Inventory.Armor"}}</div>
  {{!-- Helmet on/off. Off drops the helmet's archery and perception
        penalties; head-hit armor bypass is not wired yet. --}}
  <a
    class="armor-helmet-toggle {{#if helmetOff}}off{{/if}} {{#unless hasHelmet}}absent{{/unless}}"
    data-action="toggleHelmet"
    title="{{#if helmetOff}}{{localize "REDSTEEL.Actor.Inventory.HelmetOff"}}{{else}}{{localize "REDSTEEL.Actor.Inventory.HelmetOn"}}{{/if}}"
  >
    <i class="fa-sharp fa-light fa-helmet-battle"></i>
  </a>

{{!-- ARMOR SLOTS (layered: Bottom / Middle / Top) --}}
<section class="armor-loadout">
  {{#each armorSlots as |slot layer|}}
    <div class="armor-slot-block">
      <div class="armor-slot-label">{{slot.label}}</div>

      <div
        class="armor-slot {{#if slot.item}}filled{{else}}empty{{/if}}"
        data-layer="{{layer}}"
        {{#if slot.item}}
          data-item-id="{{slot.item._id}}"
        {{/if}}
      >
        {{#if slot.item}}
          <img src="{{slot.item.img}}" class="item-icon" data-item-id="{{slot.item._id}}" data-tt-kind="item" data-tt-id="{{slot.item._id}}" />
        {{else}}
          <span>{{slot.label}}</span>
        {{/if}}
      </div>

      <div class="armor-durability-row">
        {{#if slot.hasDurability}}
          {{#each slot.durabilityPips as |pip|}}
            <a
              class="armor-durability-toggle {{#if pip.active}}active{{/if}}"
              data-action="toggleArmorDurability"
              data-item-id="{{slot.item._id}}"
              data-index="{{pip.index}}"
              title="{{localize "REDSTEEL.Item.Gear.FIELDS.durability.label"}}: {{slot.durability}} / {{slot.durabilityMax}}"
            >
              <i class="fa-solid fa-shield"></i>
            </a>
          {{/each}}
        {{/if}}
      </div>
    </div>
  {{/each}}
</section>

</div>

<div class="loadout-group">
  <div class="loadout-group-label">{{localize "REDSTEEL.Actor.Inventory.WeaponSets"}}</div>

<section class="weapon-loadouts horizontal active-set-{{system.combat.activeWeaponSet}}">

  {{!-- The active set renders full size; the inactive one shrinks and tucks
        diagonally up-right of it, with the switcher below. Which is which is
        decided in CSS from the .active-set-N class on .weapon-loadouts. --}}
  <div class="weapon-sets-stack">

  {{!-- SET 1 --}}
  <div class="weapon-set-block" data-set-block="1">
    <div class="weapon-loadout-label">Set 1</div>

    <div class="weapon-slot-row" data-action="weaponSlot"
     data-slot="{{slot.id}}"
     {{#if slot.itemId}}
     data-item-id="{{slot.itemId}}"
     {{/if}}>


      {{!-- MAIN --}}
      <div class="weapon-slot-column">
        <div
          class="weapon-slot main {{#if weaponSets.1.main}}filled{{else}}empty{{/if}}"
          data-set="1"
          data-slot="main"
          {{#if weaponSets.1.main}}
            data-drag="true"
            data-item-id="{{weaponSets.1.main._id}}"
          {{/if}}
        >
          {{#if weaponSets.1.main}}
            <img src="{{weaponSets.1.main.img}}" class="item-icon" data-item-id="{{weaponSets.1.main._id}}" data-tt-kind="item" data-tt-id="{{weaponSets.1.main._id}}" />
          {{else}}
            <span>Main</span>
          {{/if}}
        </div>

        {{!-- TWO-HAND GRIP TOGGLE --}}
        {{#if (and weaponSets.1.main.system.twoHandGrip (not (eq weaponSets.1.main.system.type "heavy")))}}
          <a
            class="two-hand-grip-toggle {{#if (eq weaponSets.1.main.system.gripMode "two")}}active{{/if}}"
            data-action="toggleTwoHandGrip"
            data-item-id="{{weaponSets.1.main._id}}"
            title="{{localize "REDSTEEL.Actor.Inventory.TwoHandGrip"}}"
          >
            <i class="fa-solid fa-hand-fist"></i>
          </a>
        {{/if}}
      </div>

      {{!-- OFF --}}
<div class="weapon-slot-column">
<div
  class="weapon-slot off
    {{#if weaponSets.1.mainIsTwoHanded}}blocked{{else}}
      {{#if weaponSets.1.off}}filled{{else}}empty{{/if}}
      {{#if weaponSets.1.offIsShield}}shield{{/if}}
    {{/if}}"
  data-set="1"
  data-slot="off"
  {{#if (and weaponSets.1.off (not weaponSets.1.mainIsTwoHanded))}}
    data-drag="true"
    data-item-id="{{weaponSets.1.off._id}}"
  {{/if}}
>

  {{!-- TWO-HANDED GHOST (THIS WAS MISSING) --}}
  {{#if weaponSets.1.mainIsTwoHanded}}
    <div class="two-handed-ghost">
      <img
        src="{{weaponSets.1.main.img}}"
        title="{{weaponSets.1.main.localizedName}} (Two-handed)"
        width="44"
        height="44"
      />
    </div>

  {{!-- SHIELD --}}
  {{else if weaponSets.1.offIsShield}}
    <img
      src="{{weaponSets.1.off.img}}"
      class="item-icon"
      data-item-id="{{weaponSets.1.off._id}}"
      data-tt-kind="item"
      data-tt-id="{{weaponSets.1.off._id}}"      width="44"
      height="44"
    />

  {{!-- NORMAL OFF-HAND WEAPON --}}
  {{else if weaponSets.1.off}}
    <img
      src="{{weaponSets.1.off.img}}"
      class="item-icon"
      data-item-id="{{weaponSets.1.off._id}}"
      data-tt-kind="item"
      data-tt-id="{{weaponSets.1.off._id}}"      width="44"
      height="44"
    />

  {{!-- EMPTY --}}
  {{else}}
    <span>Off</span>
  {{/if}}

</div>

{{!-- SHIELD DURABILITY PIPS --}}
{{#if weaponSets.1.offHasDurability}}
  <div class="armor-durability-row" data-set="1">
    {{#each weaponSets.1.offDurabilityPips as |pip|}}
      <a
        class="armor-durability-toggle {{#if pip.active}}active{{/if}}"
        data-action="toggleArmorDurability"
        data-item-id="{{@root.weaponSets.1.off._id}}"
        data-index="{{pip.index}}"
        title="{{localize "REDSTEEL.Item.Gear.FIELDS.durability.label"}}: {{@root.weaponSets.1.offDurability}} / {{@root.weaponSets.1.offDurabilityMax}}"
      >
        <i class="fa-solid fa-shield"></i>
      </a>
    {{/each}}
  </div>
{{/if}}
</div>

    </div>
  </div>

  {{!-- SET 2 --}}
  <div class="weapon-set-block" data-set-block="2">
    <div class="weapon-loadout-label">Set 2</div>

    <div class="weapon-slot-row" data-action="weaponSlot"
     data-slot="{{slot.id}}"
     {{#if slot.itemId}}
     data-item-id="{{slot.itemId}}"
     {{/if}}>


      {{!-- MAIN --}}
      <div class="weapon-slot-column">
        <div
          class="weapon-slot main {{#if weaponSets.2.main}}filled{{else}}empty{{/if}}"
          data-set="2"
          data-slot="main"
          {{#if weaponSets.2.main}}
            data-drag="true"
            data-item-id="{{weaponSets.2.main._id}}"
          {{/if}}
        >
          {{#if weaponSets.2.main}}
            <img src="{{weaponSets.2.main.img}}" class="item-icon" data-item-id="{{weaponSets.2.main._id}}" data-tt-kind="item" data-tt-id="{{weaponSets.2.main._id}}" />
          {{else}}
            <span>Main</span>
          {{/if}}
        </div>

        {{!-- TWO-HAND GRIP TOGGLE --}}
        {{#if (and weaponSets.2.main.system.twoHandGrip (not (eq weaponSets.2.main.system.type "heavy")))}}
          <a
            class="two-hand-grip-toggle {{#if (eq weaponSets.2.main.system.gripMode "two")}}active{{/if}}"
            data-action="toggleTwoHandGrip"
            data-item-id="{{weaponSets.2.main._id}}"
            title="{{localize "REDSTEEL.Actor.Inventory.TwoHandGrip"}}"
          >
            <i class="fa-solid fa-hand-fist"></i>
          </a>
        {{/if}}
      </div>

      {{!-- OFF --}}
<div class="weapon-slot-column">
<div
  class="weapon-slot off
    {{#if weaponSets.2.mainIsTwoHanded}}blocked{{else}}
      {{#if weaponSets.2.off}}filled{{else}}empty{{/if}}
      {{#if weaponSets.2.offIsShield}}shield{{/if}}
    {{/if}}"
  data-set="2"
  data-slot="off"
  {{#if (and weaponSets.2.off (not weaponSets.2.mainIsTwoHanded))}}
    data-drag="true"
    data-item-id="{{weaponSets.2.off._id}}"
  {{/if}}
>

  {{!-- TWO-HANDED GHOST --}}
  {{#if weaponSets.2.mainIsTwoHanded}}
    <div class="two-handed-ghost">
      <img
        src="{{weaponSets.2.main.img}}"
        title="{{weaponSets.2.main.localizedName}} (Two-handed)"
        width="44"
        height="44"
      />
    </div>

  {{!-- SHIELD --}}
  {{else if weaponSets.2.offIsShield}}
    <img
      src="{{weaponSets.2.off.img}}"
      class="item-icon"
      data-item-id="{{weaponSets.2.off._id}}"
      data-tt-kind="item"
      data-tt-id="{{weaponSets.2.off._id}}"      width="44"
      height="44"
    />

  {{!-- NORMAL OFF-HAND WEAPON --}}
  {{else if weaponSets.2.off}}
    <img
      src="{{weaponSets.2.off.img}}"
      class="item-icon"
      data-item-id="{{weaponSets.2.off._id}}"
      data-tt-kind="item"
      data-tt-id="{{weaponSets.2.off._id}}"      width="44"
      height="44"
    />

  {{!-- EMPTY --}}
  {{else}}
    <span>Off</span>
  {{/if}}

</div>

{{!-- SHIELD DURABILITY PIPS --}}
{{#if weaponSets.2.offHasDurability}}
  <div class="armor-durability-row" data-set="2">
    {{#each weaponSets.2.offDurabilityPips as |pip|}}
      <a
        class="armor-durability-toggle {{#if pip.active}}active{{/if}}"
        data-action="toggleArmorDurability"
        data-item-id="{{@root.weaponSets.2.off._id}}"
        data-index="{{pip.index}}"
        title="{{localize "REDSTEEL.Item.Gear.FIELDS.durability.label"}}: {{@root.weaponSets.2.offDurability}} / {{@root.weaponSets.2.offDurabilityMax}}"
      >
        <i class="fa-solid fa-shield"></i>
      </a>
    {{/each}}
  </div>
{{/if}}
</div>

    </div>
  </div>

  {{!-- SET SWITCH, tucked under the mini inactive set --}}
  <div class="weapon-set-switcher">
<button
  type="button"
  class="weapon-set-toggle {{#if (eq system.combat.activeWeaponSet 2)}}set-2{{else}}set-1{{/if}}"
  data-action="setActiveWeaponSet"
  title="Switch Weapon Set"
>
  <i class="fa-sharp fa-regular fa-arrows-repeat" style="color: #FFD43B;"></i>
</button>
  </div>

  </div>{{!-- /.weapon-sets-stack --}}

  {{!-- EQUIPPED AMMO SLOT --}}
  <div class="ammo-loadout">
    <div class="weapon-loadout-label">{{localize "REDSTEEL.Actor.Inventory.Ammo"}}</div>
    <div class="ammo-slot-row">
      {{#each equippedAmmo as |ammo|}}
        <div
          class="ammo-slot filled"
          data-drag="true"
          data-item-id="{{ammo._id}}"
          data-document-class="Item"
        >
          <a class="rollable" data-action="roll" data-roll-type="item" data-item-id="{{ammo._id}}">
            <img src="{{ammo.img}}" class="item-icon" data-item-id="{{ammo._id}}" data-tt-kind="item" data-tt-id="{{ammo._id}}" />
          </a>
          <span class="ammo-qty">{{ammo.system.quantity}}</span>
        </div>
      {{/each}}
      {{#unless equippedAmmo.length}}
        <div class="ammo-slot empty">
          <i class="fa-solid fa-arrow-up-from-bracket"></i>
        </div>
      {{/unless}}
    </div>
  </div>

</section>
</div>

</div>

{{!-- ACCESSORY SLOTS (10 generic, interchangeable) --}}
<section class="accessory-loadout">
  <div class="loadout-group-label">{{localize "REDSTEEL.Actor.Inventory.Accessories"}}</div>
  <div class="accessory-slot-grid">
    {{#each accessorySlots as |slot|}}
      <div
        class="accessory-slot {{#if slot.item}}filled{{else}}empty{{/if}}"
        data-slot-key="{{slot.key}}"
        {{#if slot.item}}
          data-drag="true"
          data-item-id="{{slot.item._id}}"
        {{/if}}
        title="{{#if slot.item}}{{slot.item.name}}{{/if}}"
      >
        {{#if slot.item}}
          <img src="{{slot.item.img}}" class="item-icon" data-item-id="{{slot.item._id}}" data-tt-kind="item" data-tt-id="{{slot.item._id}}" />
        {{/if}}
      </div>
    {{/each}}
  </div>
</section>

{{/if}}


{{!-- CURRENCY DIVIDER --}}
{{#if (eq actor.type "character")}}
<div class="currency-bar">
  {{!-- Heading row: title and cog left, purse total right. Keeping both off
        the coin row leaves the chips the full width of the strip. --}}
  <div class="currency-head">
    <span class="currency-label">
      {{localize "REDSTEEL.Actor.Inventory.Currencies"}}
      {{#if @root.isGM}}
        <a class="currency-config" data-action="openCurrencyConfig" title="{{localize "REDSTEEL.Currency.MenuLabel"}}">
          <i class="fa-solid fa-gear"></i>
        </a>
      {{/if}}
    </span>
    {{!-- Worth in tier-1 coins only, each figure in its own coin's colour.
          The title carries the full breakdown over every rung. --}}
    {{#if purse.length}}
      <span class="currency-total" title="{{localize "REDSTEEL.Currency.PurseTotal"}}: {{purseTotal}}">
        {{#each purseSummary as |part|}}
          <span class="currency-total-part" style="color: {{part.color}};">
            <b>{{part.count}}</b> {{part.label}}
          </span>
        {{/each}}
      </span>
    {{/if}}
  </div>
  <div class="currency-list">
    {{#each purse as |coin|}}
      {{!-- The coin's colour is carried by its name and figure only; the box
            stays near-black. The title holds the full name, which the label
            itself may have to ellipsis at six coins. --}}
      <div class="currency-chip" title="{{coin.label}}">
        <span class="currency-name" style="color: {{coin.color}};">{{coin.label}}</span>
        <input
          type="number"
          class="currency-value"
          name="system.purse.{{coin.key}}"
          value="{{coin.count}}"
          min="0"
          step="1"
          data-dtype="Number"
          style="color: {{coin.color}};"
        />
      </div>
    {{/each}}
  </div>
</div>
{{/if}}


{{!-- INVENTORY GRID --}}
<section class="inventory-panel">
<div class="inventory-grid-header">
  <span class="inventory-grid-title">{{localize "REDSTEEL.Actor.Tabs.Inventory"}}</span>
  <div class="inventory-grid-tools">
    {{#each inventoryFilters as |f|}}
      <a
        class="inventory-tool inventory-filter {{#if f.active}}active{{/if}}"
        data-action="setInventoryFilter"
        data-filter="{{f.key}}"
      >
        {{f.label}}
      </a>
    {{/each}}
    {{#if @root.editable}}
      <a class="inventory-tool item-create" data-action="createDoc" data-document-class="Item" data-type="item" title="{{localize 'DOCUMENT.Create' type="Item"}}">
        <i class="fas fa-plus"></i>
      </a>
    {{/if}}
  </div>
</div>

<ul class="inventory-grid">
  {{#each inventory as |entry|}}
    <li
      class="inventory-cell item {{#if entry.equipped}}equipped{{/if}}"
      data-item-id="{{entry.item._id}}"
      data-document-class="Item"
      data-drag="true"
    >
      <a class="inventory-cell-icon rollable" data-action="roll" data-roll-type="item" data-item-id="{{entry.item._id}}">
        <img src="{{entry.item.img}}" class="item-icon" data-item-id="{{entry.item._id}}" data-tt-kind="item" data-tt-id="{{entry.item._id}}" />
      </a>

      {{!-- TWO-HAND GRIP TOGGLE (hover overlay) --}}
      {{#if (and entry.item.system.twoHandGrip (not (eq entry.item.system.type "heavy")))}}
        <a
          class="two-hand-grip-toggle overlay {{#if (eq entry.item.system.gripMode "two")}}active{{/if}}"
          data-action="toggleTwoHandGrip"
          data-item-id="{{entry.item._id}}"
          title="{{localize "REDSTEEL.Actor.Inventory.TwoHandGrip"}}"
        >
          <i class="fa-solid fa-hand-fist"></i>
        </a>
      {{/if}}

      {{!-- NPC OFF-HAND SELECTOR (hover overlay) --}}
      {{#if (and (eq @root.actor.type "npc") entry.item.system.offhand)}}
        <a
          class="npc-offhand-toggle overlay {{#if entry.item.system.npcOffhand}}active{{/if}}"
          data-action="toggleNpcOffhand"
          data-item-id="{{entry.item._id}}"
          title="{{localize "REDSTEEL.Actor.Inventory.OffHandGrip"}}"
        >
          <i class="fa-solid fa-hand"></i>
        </a>
      {{/if}}

      {{#if entry.showQty}}
        <span class="inventory-qty">{{entry.quantity}}</span>
      {{/if}}

      {{#if entry.stackable}}
        <div class="inventory-cell-controls top">
          <a class="inventory-ctrl" data-action="adjustNumericField" data-item-id="{{entry.item._id}}" data-path="system.quantity" data-delta="1" title="Increase (Shift +5)">
            <i class="fa-solid fa-plus"></i>
          </a>
          <span class="inventory-ctrl-qty">{{entry.quantity}}</span>
          <a class="inventory-ctrl" data-action="adjustNumericField" data-item-id="{{entry.item._id}}" data-path="system.quantity" data-delta="-1" title="Decrease (Shift -5)">
            <i class="fa-solid fa-minus"></i>
          </a>
        </div>
      {{/if}}

      <div class="inventory-cell-controls bottom">
        <a class="inventory-ctrl" data-action="viewDoc" title="{{localize 'DOCUMENT.Update' type="Item"}}">
          <i class="fas fa-edit"></i>
        </a>
        {{#if @root.editable}}
          <a class="inventory-ctrl item-delete" data-action="deleteDoc" title="{{localize 'DOCUMENT.Delete' type="Item"}}">
            <i class="fas fa-trash"></i>
          </a>
        {{/if}}
      </div>
    </li>
  {{/each}}

  {{#each inventoryEmptySlots}}
    <li class="inventory-cell empty"></li>
  {{/each}}
</ul>
</section>

</section>{{!-- /.inventory-frame --}}

</div>
</section>
