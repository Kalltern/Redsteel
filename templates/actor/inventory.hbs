{{! Inventory Tab }}
<section
  class="tab inventory {{tab.cssClass}}"
  data-group="primary"
  data-tab="inventory"
>
<div class="inventory-box">
{{#if (eq actor.type "character")}}

{{!-- ARMOR SLOTS (layered: Bottom / Middle / Top) --}}
<section class="armor-loadout">
  {{#each armorSlots as |slot layer|}}
    <div class="armor-slot-block">
      <div class="armor-slot-label">{{slot.label}}</div>

      <div
        class="armor-slot {{#if slot.item}}filled{{else}}empty{{/if}}"
        data-layer="{{layer}}"
        {{#if slot.item}}
          data-item-id="{{slot.item._id}}"
        {{/if}}
      >
        {{#if slot.item}}
          <img src="{{slot.item.img}}" class="item-icon" data-item-id="{{slot.item._id}}" />
        {{else}}
          <span>{{slot.label}}</span>
        {{/if}}
      </div>

      <div class="armor-durability-row">
        {{#if slot.hasDurability}}
          {{#each slot.durabilityPips as |pip|}}
            <a
              class="armor-durability-toggle {{#if pip.active}}active{{/if}}"
              data-action="toggleArmorDurability"
              data-item-id="{{slot.item._id}}"
              data-index="{{pip.index}}"
              title="{{localize "REDSTEEL.Item.Gear.FIELDS.durability.label"}}: {{slot.durability}} / {{slot.durabilityMax}}"
            >
              <i class="fa-solid fa-shield"></i>
            </a>
          {{/each}}
        {{/if}}
      </div>
    </div>
  {{/each}}
</section>

<section class="weapon-loadouts horizontal active-set-{{system.combat.activeWeaponSet}}">

  {{!-- LEFT: SET 1 --}}
  <div class="weapon-set-block">
    <div class="weapon-loadout-label">Set 1</div>

    <div class="weapon-slot-row" data-action="weaponSlot"
     data-slot="{{slot.id}}"
     {{#if slot.itemId}}
     data-item-id="{{slot.itemId}}"
     {{/if}}>


      {{!-- MAIN --}}
      <div
        class="weapon-slot main {{#if weaponSets.1.main}}filled{{else}}empty{{/if}}"
        data-set="1"
        data-slot="main"
        {{#if weaponSets.1.main}}
          data-drag="true"
          data-item-id="{{weaponSets.1.main._id}}"
        {{/if}}
      >
        {{#if weaponSets.1.main}}
          <img src="{{weaponSets.1.main.img}}" class="item-icon" data-item-id="{{weaponSets.1.main._id}}" />
        {{else}}
          <span>Main</span>
        {{/if}}
      </div>

      {{!-- OFF --}}
<div class="weapon-slot-column">
<div
  class="weapon-slot off
    {{#if weaponSets.1.mainIsTwoHanded}}blocked{{else}}
      {{#if weaponSets.1.off}}filled{{else}}empty{{/if}}
      {{#if weaponSets.1.offIsShield}}shield{{/if}}
    {{/if}}"
  data-set="1"
  data-slot="off"
  {{#if (and weaponSets.1.off (not weaponSets.1.mainIsTwoHanded))}}
    data-drag="true"
    data-item-id="{{weaponSets.1.off._id}}"
  {{/if}}
>

  {{!-- TWO-HANDED GHOST (THIS WAS MISSING) --}}
  {{#if weaponSets.1.mainIsTwoHanded}}
    <div class="two-handed-ghost">
      <img
        src="{{weaponSets.1.main.img}}"
        title="{{weaponSets.1.main.localizedName}} (Two-handed)"
        width="44"
        height="44"
      />
    </div>

  {{!-- SHIELD --}}
  {{else if weaponSets.1.offIsShield}}
    <img
      src="{{weaponSets.1.off.img}}"
      class="item-icon"
      data-item-id="{{weaponSets.1.off._id}}"      width="44"
      height="44"
    />

  {{!-- NORMAL OFF-HAND WEAPON --}}
  {{else if weaponSets.1.off}}
    <img
      src="{{weaponSets.1.off.img}}"
      class="item-icon"
      data-item-id="{{weaponSets.1.off._id}}"      width="44"
      height="44"
    />

  {{!-- EMPTY --}}
  {{else}}
    <span>Off</span>
  {{/if}}

</div>

{{!-- SHIELD DURABILITY PIPS --}}
{{#if weaponSets.1.offHasDurability}}
  <div class="armor-durability-row" data-set="1">
    {{#each weaponSets.1.offDurabilityPips as |pip|}}
      <a
        class="armor-durability-toggle {{#if pip.active}}active{{/if}}"
        data-action="toggleArmorDurability"
        data-item-id="{{@root.weaponSets.1.off._id}}"
        data-index="{{pip.index}}"
        title="{{localize "REDSTEEL.Item.Gear.FIELDS.durability.label"}}: {{@root.weaponSets.1.offDurability}} / {{@root.weaponSets.1.offDurabilityMax}}"
      >
        <i class="fa-solid fa-shield"></i>
      </a>
    {{/each}}
  </div>
{{/if}}
</div>

    </div>
  </div>

  {{!-- CENTER: SWITCH --}}
  <div class="weapon-set-switcher">
<button
  type="button"
  class="weapon-set-toggle {{#if (eq system.combat.activeWeaponSet 2)}}set-2{{else}}set-1{{/if}}"
  data-action="setActiveWeaponSet"
  title="Switch Weapon Set"
>
  <i class="fa-sharp fa-regular fa-arrows-repeat" style="color: #FFD43B;"></i>
</button>
  </div>

  {{!-- RIGHT: SET 2 --}}
  <div class="weapon-set-block">
    <div class="weapon-loadout-label">Set 2</div>

    <div class="weapon-slot-row" data-action="weaponSlot"
     data-slot="{{slot.id}}"
     {{#if slot.itemId}}
     data-item-id="{{slot.itemId}}"
     {{/if}}>


      {{!-- MAIN --}}
      <div
        class="weapon-slot main {{#if weaponSets.2.main}}filled{{else}}empty{{/if}}"
        data-set="2"
        data-slot="main"
        {{#if weaponSets.2.main}}
          data-drag="true"
          data-item-id="{{weaponSets.2.main._id}}"
        {{/if}}
      >
        {{#if weaponSets.2.main}}
          <img src="{{weaponSets.2.main.img}}" class="item-icon" data-item-id="{{weaponSets.2.main._id}}" />
        {{else}}
          <span>Main</span>
        {{/if}}
      </div>

      {{!-- OFF --}}
<div class="weapon-slot-column">
<div
  class="weapon-slot off
    {{#if weaponSets.2.mainIsTwoHanded}}blocked{{else}}
      {{#if weaponSets.2.off}}filled{{else}}empty{{/if}}
      {{#if weaponSets.2.offIsShield}}shield{{/if}}
    {{/if}}"
  data-set="2"
  data-slot="off"
  {{#if (and weaponSets.2.off (not weaponSets.2.mainIsTwoHanded))}}
    data-drag="true"
    data-item-id="{{weaponSets.2.off._id}}"
  {{/if}}
>

  {{!-- TWO-HANDED GHOST --}}
  {{#if weaponSets.2.mainIsTwoHanded}}
    <div class="two-handed-ghost">
      <img
        src="{{weaponSets.2.main.img}}"
        title="{{weaponSets.2.main.localizedName}} (Two-handed)"
        width="44"
        height="44"
      />
    </div>

  {{!-- SHIELD --}}
  {{else if weaponSets.2.offIsShield}}
    <img
      src="{{weaponSets.2.off.img}}"
      class="item-icon"
      data-item-id="{{weaponSets.2.off._id}}"      width="44"
      height="44"
    />

  {{!-- NORMAL OFF-HAND WEAPON --}}
  {{else if weaponSets.2.off}}
    <img
      src="{{weaponSets.2.off.img}}"
      class="item-icon"
      data-item-id="{{weaponSets.2.off._id}}"      width="44"
      height="44"
    />

  {{!-- EMPTY --}}
  {{else}}
    <span>Off</span>
  {{/if}}

</div>

{{!-- SHIELD DURABILITY PIPS --}}
{{#if weaponSets.2.offHasDurability}}
  <div class="armor-durability-row" data-set="2">
    {{#each weaponSets.2.offDurabilityPips as |pip|}}
      <a
        class="armor-durability-toggle {{#if pip.active}}active{{/if}}"
        data-action="toggleArmorDurability"
        data-item-id="{{@root.weaponSets.2.off._id}}"
        data-index="{{pip.index}}"
        title="{{localize "REDSTEEL.Item.Gear.FIELDS.durability.label"}}: {{@root.weaponSets.2.offDurability}} / {{@root.weaponSets.2.offDurabilityMax}}"
      >
        <i class="fa-solid fa-shield"></i>
      </a>
    {{/each}}
  </div>
{{/if}}
</div>

    </div>
  </div>

  {{!-- EQUIPPED AMMO SLOT --}}
  <div class="ammo-loadout">
    <div class="weapon-loadout-label">{{localize "REDSTEEL.Actor.Inventory.Ammo"}}</div>
    <div class="ammo-slot-row">
      {{#each equippedAmmo as |ammo|}}
        <div
          class="ammo-slot filled"
          data-drag="true"
          data-item-id="{{ammo._id}}"
          data-document-class="Item"
        >
          <a class="rollable" data-action="roll" data-roll-type="item" data-item-id="{{ammo._id}}">
            <img src="{{ammo.img}}" class="item-icon" data-item-id="{{ammo._id}}" />
          </a>
          <span class="ammo-qty">{{ammo.system.quantity}}</span>
        </div>
      {{/each}}
      {{#unless equippedAmmo.length}}
        <div class="ammo-slot empty">
          <i class="fa-solid fa-arrow-up-from-bracket"></i>
        </div>
      {{/unless}}
    </div>
  </div>

</section>

{{/if}}


{{!-- CURRENCY DIVIDER --}}
{{#if (eq actor.type "character")}}
<div class="currency-bar">
  <span class="currency-label">{{localize "REDSTEEL.Actor.Inventory.Currencies"}}</span>
  <div class="currency-list">
    {{#each currencies as |coin index|}}
      <div class="currency-chip">
        <input
          type="text"
          class="currency-name"
          name="system.currencies.{{index}}.label"
          value="{{coin.label}}"
          placeholder="{{localize "REDSTEEL.Actor.Inventory.CurrencyName"}}"
        />
        <input
          type="number"
          class="currency-value"
          name="system.currencies.{{index}}.value"
          value="{{coin.value}}"
        />
        {{#if @root.editable}}
          <a
            class="currency-delete"
            data-action="deleteCurrency"
            data-index="{{index}}"
            title="{{localize "REDSTEEL.Actor.Inventory.RemoveCurrency"}}"
          >
            <i class="fa-solid fa-xmark"></i>
          </a>
        {{/if}}
      </div>
    {{/each}}
    {{#if @root.editable}}
      <a class="currency-add" data-action="addCurrency" title="{{localize "REDSTEEL.Actor.Inventory.AddCurrency"}}">
        <i class="fa-solid fa-plus"></i>
      </a>
    {{/if}}
  </div>
</div>
{{/if}}


{{!-- INVENTORY GRID --}}
<div class="inventory-grid-header">
  <span class="inventory-grid-title">{{localize "REDSTEEL.Actor.Tabs.Inventory"}}</span>
  <div class="inventory-grid-tools">
    {{#each inventoryFilters as |f|}}
      <a
        class="inventory-tool inventory-filter {{#if f.active}}active{{/if}}"
        data-action="setInventoryFilter"
        data-filter="{{f.key}}"
      >
        {{f.label}}
      </a>
    {{/each}}
    {{#if @root.editable}}
      <a class="inventory-tool item-create" data-action="createDoc" data-document-class="Item" data-type="item" title="{{localize 'DOCUMENT.Create' type="Item"}}">
        <i class="fas fa-plus"></i>
      </a>
    {{/if}}
  </div>
</div>

<ul class="inventory-grid">
  {{#each inventory as |entry|}}
    <li
      class="inventory-cell item {{#if entry.equipped}}equipped{{/if}}"
      data-item-id="{{entry.item._id}}"
      data-document-class="Item"
      data-drag="true"
    >
      <a class="inventory-cell-icon rollable" data-action="roll" data-roll-type="item" data-item-id="{{entry.item._id}}">
        <img src="{{entry.item.img}}" class="item-icon" data-item-id="{{entry.item._id}}" />
      </a>

      {{#if entry.showQty}}
        <span class="inventory-qty">{{entry.quantity}}</span>
      {{/if}}

      {{#if entry.stackable}}
        <div class="inventory-cell-controls top">
          <a class="inventory-ctrl" data-action="adjustNumericField" data-item-id="{{entry.item._id}}" data-path="system.quantity" data-delta="1" title="Increase">
            <i class="fa-solid fa-plus"></i>
          </a>
          <a class="inventory-ctrl" data-action="adjustNumericField" data-item-id="{{entry.item._id}}" data-path="system.quantity" data-delta="-1" title="Decrease">
            <i class="fa-solid fa-minus"></i>
          </a>
        </div>
      {{/if}}

      <div class="inventory-cell-controls bottom">
        <a class="inventory-ctrl" data-action="viewDoc" title="{{localize 'DOCUMENT.Update' type="Item"}}">
          <i class="fas fa-edit"></i>
        </a>
        {{#if @root.editable}}
          <a class="inventory-ctrl item-delete" data-action="deleteDoc" title="{{localize 'DOCUMENT.Delete' type="Item"}}">
            <i class="fas fa-trash"></i>
          </a>
        {{/if}}
      </div>
    </li>
  {{/each}}

  {{#each inventoryEmptySlots}}
    <li class="inventory-cell empty"></li>
  {{/each}}
</ul>

</div>
</section>
