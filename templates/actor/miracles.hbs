{{! Spells Tab }}
<section
  class='tab miracles {{tab.cssClass}}'
  data-group='primary'
  data-tab='miracles'
>
<div class="miracles-box">
<h2 class="flex-group-center">
Divine blessings
</h2>

<div class='grid grid-9col'>
      <div class="grid-span-1">
        <label class="resource-label">
 {{localize "REDSTEEL.Item.Spell.FIELDS.holyPower.label"}}
          </label>
        <input
          class="spell-value"
          type="text"
          name="system.stats.holyEnergy.power"
          value="{{system.stats.holyEnergy.power}}"
          data-dtype="Number"
        {{#unless (eq actor.type "npc")}}readonly{{/unless}}
        />
 </div>
    <div class="grid-span-2">
 <label for="shepherdsWill">{{localize "REDSTEEL.Item.Spell.FIELDS.shepherdsWill.label"}}</label>
<select name="system.shepherdsWill.skill" id="shepherdsWill">
    <option value="">-- Select a blessing --</option>
    {{#each system.shepherdsWill.shepherdOptions as |shepherdsWill|}}
        <option value="{{shepherdsWill}}" {{#if (eq ../system.shepherdsWill.skill shepherdsWill)}}selected{{/if}}>
            {{shepherdsWill}}
        </option>
    {{/each}}
</select>
 </div>
 <section class="main grid-span-9">
      <ol class="items-list">
        <li class="item flexrow items-header">
          <div class="item-name">{{localize "Blessings"}}</div>
          <div class="item-controls">
            {{#if @root.editable}}
              <a
                class="item-control item-create"
                title="Create item"
                data-action="createDoc"
                data-document-class="Item"
                data-type="feature"
              >
                <i class="fas fa-plus"></i>
                {{localize "DOCUMENT.New" type="feature"}}
              </a>
            {{/if}}
          </div>
        </li>
        {{#each features as |item id|}}
        {{#if (eq item.system.option "priest")}}
          <li
            class="item flexrow"
            data-item-id="{{item._id}}"
            data-drag="true"
            data-document-class="Item"
          >
            <div class="item-name">
              <div class="item-image">
                <a class="rollable" data-roll-type="item" data-action="roll">
                  <img
                    src="{{item.img}}"
                    title="{{item.localizedName}}"
                    width="24"
                    height="24"
                  />
                </a>
              </div>
              <div>{{item.localizedName}}</div>
            </div>
            <div class="item-controls">
              <a
                class="item-control item-edit"
                title="{{localize 'DOCUMENT.Update' type="feature"}}"
                data-action="viewDoc"
              >
                <i class="fas fa-edit"></i>
              </a>
              {{#if @root.editable}}
                <a
                  class="item-control item-delete"
                  title="{{localize 'DOCUMENT.Delete' type="feature"}}"
                  data-action="deleteDoc"
                >
                  <i class="fas fa-trash"></i>
                </a>
              {{/if}}
            </div>
          </li>
         {{/if}}
        {{/each}}
      </ol>
    </section>
       
    
</div>
<h2
class="flex-group-center">
Miracles
</h2>

  <nav class="rank-filter">
    {{#each miracleRankGroups as |rg|}}
      <a class="rank-filter-pill {{#if (eq rg.rank ../activeMiracleRank)}}active{{/if}}"
         data-action="setMiracleRank" data-rank="{{rg.rank}}">{{rg.label}}</a>
    {{/each}}
  </nav>

  {{#each miracleRankGroups as |rg|}}
    {{#if (eq rg.rank ../activeMiracleRank)}}
      <ul class="spell-card-grid">
        {{#each rg.cards as |card|}}
          <li class="spell-card" data-item-id="{{card.id}}" data-card-kind="miracle" data-tt-kind="spellCard" data-tt-id="{{card.id}}" data-drag="true" data-document-class="Item">
            <a class="spell-card-icon rollable" data-action="roll" data-roll-type="item">
              <img src="{{card.img}}" data-item-id="{{card.id}}" width="48" height="48" />
            </a>
            <div class="spell-card-main">
              <div class="spell-card-top">
                <span class="spell-card-name">{{card.name}}</span>
                <span class="spell-card-controls">
                  <a class="item-control item-edit" data-action="viewDoc" title="{{localize 'DOCUMENT.Update' type='spell'}}"><i class="fas fa-edit"></i></a>
                  {{#if @root.editable}}
                    <a class="item-control item-delete" data-action="deleteDoc" title="{{localize 'DOCUMENT.Delete' type='spell'}}"><i class="fas fa-trash"></i></a>
                  {{/if}}
                </span>
              </div>
              <div class="spell-card-pills">
                {{#each card.pills as |pill|}}
                  <span class="spell-pill" data-pill="{{pill.key}}" data-positive="{{pill.positive}}">
                    <span class="spell-pill-label">{{pill.label}}</span>
                    <span class="spell-pill-value">{{pill.value}}</span>
                  </span>
                {{/each}}
              </div>
            </div>
          </li>
        {{/each}}
      </ul>
    {{/if}}
  {{/each}}

</div>
</section>
