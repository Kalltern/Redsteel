{{!-- Learn window — the level-up screen.

     ApplicationV2 requires each template part to render exactly ONE root
     element, so the hero header, the tab strip and the grid all live inside
     this wrapper. Splitting them back out to siblings throws "must render a
     single HTML element".

     data-tt-beside: the screen fills the viewport, so there is no margin beside
     it for the system tooltips to use. With it, an ability card opens next to
     the icon that was hovered instead of pinned to the edge of the screen. --}}
<div class="rs-learn-body" data-tt-beside>

  {{!-- The hero header: the character this screen levels up, in three columns
        with a large portrait in the centre. Left of it (the GM's ledger fields
        are hidden for now, see below), the points left to spend, with
        the picker's controls under them; right of it, name, race and level and
        the seven attributes, with the close button in the corner. --}}
  <header class="rs-learn-hero">

    <div class="rs-learn-hero-side is-left">

    {{!-- GM ledger fields hidden for now (user request 2026-09-14): CP / SP
          adjustment and total Specialisation points (6 unless the GM changes
          it). Values already stored in system.progression.adjust and
          system.progression.specPoints still count in progressionEngine.mjs.
          Restore the block to edit them again. No inner comments allowed here,
          a nested closing tag would end this one early.

    {{#if isGM}}
    <div class="rs-learn-ledger">
      <span class="rs-learn-field">
        <label>{{localize "REDSTEEL.Learn.adjustCp"}}</label>
        <input type="number" name="system.progression.adjust.cp" value="{{adjust.cp}}" step="1">
      </span>
      <span class="rs-learn-field">
        <label>{{localize "REDSTEEL.Learn.adjustSp"}}</label>
        <input type="number" name="system.progression.adjust.sp" value="{{adjust.sp}}" step="1">
      </span>
      <span class="rs-learn-field">
        <label>{{localize "REDSTEEL.Learn.Specs.pointsTotal"}}</label>
        <input type="number" name="system.progression.specPoints" value="{{specWallet.earned}}" step="1">
      </span>
    </div>
    {{/if}}
    --}}

    <div class="rs-learn-purse">
      <div class="rs-learn-coffers">
        <span class="rs-learn-stat">
          <label>{{localize "REDSTEEL.Learn.cpRemaining"}}</label>
          <b>{{wallet.remaining.cp}}</b>
          <em>/ {{wallet.earned.cp}}</em>
        </span>
        <span class="rs-learn-stat">
          <label>{{localize "REDSTEEL.Learn.spRemaining"}}</label>
          <b>{{wallet.remaining.sp}}</b>
          <em>/ {{wallet.earned.sp}}</em>
        </span>
      </div>
    </div>

    </div>

    {{#if hero.img}}
    <img class="rs-learn-portrait" src="{{hero.img}}" alt="{{hero.name}}">
    {{/if}}

    <div class="rs-learn-hero-side is-right">

    <div class="rs-learn-identity">
      <div class="rs-learn-name">{{hero.name}}</div>
      {{!-- Race, then the doctrines the character trains, most advanced first.
            They stand in for the level; only a character with no doctrine yet
            shows the level instead. --}}
      <div class="rs-learn-epithet">
        {{#if hero.race}}
        <span>{{hero.race}}</span>
        <span class="rs-learn-sep">·</span>
        {{/if}}
        {{#if hero.doctrines}}
        <span class="rs-learn-doctrines">{{hero.doctrines}}</span>
        {{else}}
        <span>{{localize "REDSTEEL.Learn.level"}} <b>{{wallet.level}}</b></span>
        {{/if}}
      </div>
      <div class="rs-learn-attrs">
        {{#each hero.attributes}}
        {{!-- data-section lends each tile its attribute's colour (--rs-band). --}}
        <div class="rs-learn-attr" data-section="{{this.key}}">
          <span class="rs-learn-attr-label">{{this.label}}</span>
          <span class="rs-learn-attr-value">{{this.value}}</span>
        </div>
        {{/each}}
      </div>
      {{!-- The owned specialisations, one small token each; a click opens its
            star sign on the Specialisations tab. --}}
      {{#if hero.specs.length}}
      <div class="rs-learn-hero-specs">
        {{#each hero.specs}}
        <div class="rs-learn-hero-spec {{#if this.open}}is-open{{/if}}" role="button"
             data-action="openHeroSpec" data-spec="{{this.id}}"
             data-tooltip="{{this.label}}" aria-label="{{this.label}}">
          <img src="{{this.img}}" alt="">
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>

    {{!-- The band's top corner: the way between characters, then the way out.
          They share a wrapper because the column sets a 22px gap between its
          own items, which is far too wide for two small plates. --}}
    <div class="rs-learn-hero-corner">

      {{!-- The GM's party switch. Only the GM has it, and only when there is
            more than one character to switch between, so a player never sees
            the plate at all. The roster rolls out under the button; it hangs
            inside the hero band, which clips what overflows it, so the CSS
            caps it short of the band's lower edge and scrolls the rest. --}}
      {{#if party.length}}
      <div class="rs-learn-party">
        <button type="button" class="rs-learn-party-button" data-action="toggleParty"
                aria-haspopup="true" aria-expanded="false"
                data-tooltip="{{localize "REDSTEEL.Learn.switchHero"}}"
                aria-label="{{localize "REDSTEEL.Learn.switchHero"}}">
          <i class="fas fa-users"></i>
          <i class="fas fa-caret-down rs-learn-party-caret"></i>
        </button>
        <div class="rs-learn-party-menu" hidden>
          <div class="rs-learn-party-heading">{{localize "REDSTEEL.Learn.party"}}</div>
          {{#each party}}
          <button type="button" class="rs-learn-party-member {{#if this.current}}is-current{{/if}}"
                  data-action="switchHero" data-actor-id="{{this.id}}">
            <img src="{{this.img}}" alt="">
            <span class="rs-learn-party-name">{{this.name}}</span>
          </button>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{!-- No window frame, so the screen carries its own way out. --}}
      <button type="button" class="rs-learn-close" data-action="closeScreen"
              data-tooltip="{{localize "REDSTEEL.Learn.close"}}"
              aria-label="{{localize "REDSTEEL.Learn.close"}}">
        <i class="fas fa-xmark"></i>
      </button>

    </div>

    </div>

  </header>

  {{!-- The labels are wrapped so the engraved underline, and the active tab's
        gold line and diamond, run the width of the word, not of the tab. --}}
  <nav class="rs-learn-tabs">
    <button type="button" class="{{#if (eq tab 'combat')}}active{{/if}}"
            data-action="switchTab" data-tab="combat">
      <span class="rs-learn-tab-label">{{localize "REDSTEEL.Learn.Tabs.combat"}}</span>
    </button>
    <button type="button" class="{{#if (eq tab 'skills')}}active{{/if}}"
            data-action="switchTab" data-tab="skills">
      <span class="rs-learn-tab-label">{{localize "REDSTEEL.Learn.Tabs.skills"}}</span>
    </button>
    <button type="button" class="{{#if (eq tab 'features')}}active{{/if}}"
            data-action="switchTab" data-tab="features">
      <span class="rs-learn-tab-label">{{localize "REDSTEEL.Learn.Tabs.features"}}</span>
    </button>
    {{#if showSpellsTab}}
    {{!-- Only a caster (or the GM) has anything to read here. --}}
    <button type="button" class="{{#if (eq tab 'spells')}}active{{/if}}"
            data-action="switchTab" data-tab="spells">
      <span class="rs-learn-tab-label">{{localize "REDSTEEL.Learn.Tabs.spells"}}</span>
    </button>
    {{/if}}
    <button type="button" class="{{#if (eq tab 'specialisations')}}active{{/if}}"
            data-action="switchTab" data-tab="specialisations">
      <span class="rs-learn-tab-label">{{localize "REDSTEEL.Learn.Tabs.specialisations"}}</span>
    </button>
  </nav>

  {{#if isContentTab}}

  {{#if showBar}}
  {{!-- The toggle row over the grid, on Combat and Skills alike (user ruling).
        Each label switches its block on or off, and all start on. It sits
        outside the grid's scroller so it never scrolls away, and each label
        takes its block's colour through data-section. The track picker's
        controls stand in the middle of the row (user ruling), with every
        toggle to their left. Add skills opens the picker, and while it is open
        the toggles give way to its hint and Done and Cancel take the button's
        place. Done reads the checkboxes from the whole screen, so it works
        from here even though the list is below. --}}
  <nav class="rs-learn-ribbon">
    {{#if picking}}
    <p class="rs-learn-picker-hint">{{localize "REDSTEEL.Learn.pickerHint"}}</p>
    <span class="rs-learn-picker-actions">
      <button type="button" data-action="savePicker">
        {{localize "REDSTEEL.Learn.pickerDone"}}
      </button>
      <button type="button" data-action="cancelPicker">
        {{localize "REDSTEEL.Learn.pickerCancel"}}
      </button>
    </span>
    {{else}}
    <div class="rs-learn-ribbon-toggles">
      {{#each ribbon}}
      <button type="button" class="rs-learn-ribbon-toggle {{#if this.active}}active{{/if}}"
              aria-pressed="{{#if this.active}}true{{else}}false{{/if}}"
              data-action="toggleSection" data-section="{{this.id}}">
        {{this.label}}
      </button>
      {{/each}}
    </div>
    {{#if showAcquire}}
    <button type="button" class="rs-learn-acquire" data-action="openPicker">
      <i class="fas fa-list-check"></i>
      {{localize "REDSTEEL.Learn.acquire"}}
    </button>
    {{/if}}
    {{/if}}
  </nav>
  {{/if}}

  {{#if picking}}
  {{!-- The track picker. Choosing here only decides what this window shows;
        it never touches the sheet's own visibility, because a character may
        roll a skill they have never bought a rank in. --}}
  <div class="rs-learn-picker">

    {{#each picker}}
    <section class="rs-learn-picker-section" data-section="{{this.id}}">
      <h3 class="rs-learn-section-title">{{this.label}}</h3>
      <div class="rs-learn-picks">
        {{#each this.tracks}}
        {{!-- A trained track stays in the tree; a track whose prerequisite is
              missing (a school without Channeling or Veneficus) cannot join
              it yet. --}}
        <label class="rs-learn-pick {{#if this.locked}}locked{{/if}} {{#if this.gated}}is-gated{{/if}}"
               {{#if this.lockTip}}data-tooltip="{{this.lockTip}}"{{/if}}>
          <input type="checkbox" data-track-id="{{this.id}}"
                 {{#if this.checked}}checked{{/if}}
                 {{#if this.locked}}disabled{{/if}}>
          <span>{{this.label}}</span>
          {{#if this.gated}}<i class="fas fa-lock"></i>{{/if}}
          {{#if this.held}}<em>{{romanRank this.held}}</em>{{/if}}
        </label>
        {{/each}}
      </div>
    </section>
    {{/each}}

  </div>

  {{else}}

  <div class="rs-learn-grid">

    {{!-- The rank numerals. A grid with the same eleven columns as every track
          block below it, so the numerals sit over their own columns by
          construction rather than by a hand-matched width. --}}
    <div class="rs-learn-head">
      <div class="rs-learn-gutter"></div>
      {{#each rankHeaders}}
      <div class="rs-learn-col">{{this}}</div>
      {{/each}}
    </div>

    {{#each sections}}
    <section class="rs-learn-section" data-section="{{this.id}}">
      {{!-- On a ribbon tab the ribbon already names every block, so the
            heading is only printed on tabs without one. --}}
      {{#unless @root.ribbon.length}}
      <h3 class="rs-learn-section-title">{{this.label}}</h3>
      {{/unless}}

      {{#each this.tracks}}
      {{!-- One track. Both layouts share the same eleven-column grid, and every
            item states its own grid row and column, because the ten full-height
            hover columns would otherwise push auto-placed items out of the
            column they belong to.

            matrix   - node track, abilities, a row per stat, the price.
            segments - node track, one content row whose per-rank segments carry
                       that rank's icons and chips, the price. No stat rows. --}}
      <div class="rs-learn-track" data-track-id="{{this.id}}" data-mode="{{this.mode}}">

        <div class="rs-learn-gutter rs-learn-track-head" style="{{this.titleStyle}}">
          {{!-- No rank counter here on purpose: the filled diamonds already say
                how far the track is trained, and a "- / X" beside every name
                was just noise. --}}
          <span class="rs-learn-track-name" data-tooltip="{{this.label}}">{{this.label}}</span>
        </div>

        {{!-- How far this track is trained, as one band growing to the right.
              First in the block so everything else paints over it. --}}
        <div class="rs-learn-fill {{this.fillClass}}" style="{{this.fillStyle}}"></div>

        {{!-- Ledger rules. Emitted before the columns so they paint behind
              them, and spanning every column so the line is unbroken. --}}
        {{#each this.ruleStyles}}
        <div class="rs-learn-rule" style="{{this}}"></div>
        {{/each}}

        {{!-- The hover target: one column per rank, running the full height of
              the block and painted underneath it. It owns the state, the
              tooltip, the padlock and the refund arrow. Buying is not done
              here: the diamond in the node row is the buy control. --}}
        {{!-- Segment mode's engraved card tops: a recessed band per rank behind
              the diamond and what the rank hands over. Emitted before the
              columns so everything above paints on top of it. --}}
        {{#each this.cells}}
        {{#if this.engraveStyle}}<div class="rs-learn-engrave state-{{this.state}}" style="{{this.engraveStyle}}"></div>{{/if}}
        {{/each}}

        {{#each this.cells}}
        <div class="rs-learn-colhit state-{{this.state}}"
             style="{{this.hitStyle}}"
             data-rank="{{this.rank}}"
             data-track-id="{{../id}}"
             {{!-- Not clickable: the diamond is the buy control. This still
                   owns the column hover and the tooltip. --}}
             {{#if this.tooltipGroups}}data-tooltip="{{#each this.tooltipGroups}}{{#unless @first}}<hr>{{/unless}}{{#each this}}{{#unless @first}}<br>{{/unless}}{{this}}{{/each}}{{/each}}" data-tooltip-direction="UP"{{/if}}>
        </div>
        {{/each}}

        {{!-- The node track: a diamond per rank on a connecting line, filled
              for the ranks already bought. --}}
        {{#each this.cells}}
        {{!-- The diamond is the only control on a rank: it buys an available
              rank and refunds the top owned one. The two never apply to the
              same rank, since a held rank is owned and never available. The
              lock is a sibling of the diamond rather than a child, so it stays
              upright instead of turning 45 degrees with it. --}}
        <div class="rs-learn-node state-{{this.state}} {{this.nodeClass}}"
             style="{{this.nodeStyle}}"
             data-rank="{{this.rank}}"
             data-track-id="{{../id}}"
             {{#if (eq this.state "available")}}data-action="buyRank"{{/if}}
             {{#if this.isHeld}}data-action="refundRank"{{/if}}
             {{!-- A locked diamond names what still stands in the way: only the
                   clauses not yet met, and never the GM-only advisories, which
                   do not block. The same lines the column tooltip lists. --}}
             {{#if (eq this.state "locked")}}{{#if this.reasons.length}}data-tooltip="<strong>{{localize "REDSTEEL.Learn.unmetRequirements"}}</strong>{{#each this.reasons}}<br>{{this}}{{/each}}" data-tooltip-direction="UP"{{/if}}{{/if}}>
          {{#if this.exists}}<span class="rs-learn-diamond"></span>{{/if}}
          {{#if (eq this.state "locked")}}<i class="fas fa-lock rs-learn-lock"></i>{{/if}}
        </div>
        {{/each}}

        {{!-- Segment mode: one content row, each rank's own segment stacking
              its ability icons over one chip per thing that rank does. Only
              weapon skills and doctrines take this shape. --}}
        {{#if this.segRow}}
        {{#each this.cells}}
        {{#if this.hasSegment}}
        <div class="rs-learn-seg state-{{this.state}}"
             style="{{this.segStyle}}"
             data-rank="{{this.rank}}">
          {{#if this.grants.length}}
          <span class="rs-learn-seg-icons">
            {{#each this.grants}}
            <img src="{{this.img}}" width="64" height="64" alt="{{this.name}}" data-tt-kind="spellCardUuid" data-tt-uuid="{{this.uuid}}" data-card-kind="ability">
            {{/each}}
          </span>
          {{/if}}
          {{#each this.chips}}
          <span class="rs-learn-chip{{#unless this.prose}} is-value{{/unless}}{{#if this.ability}} is-ability{{/if}}">{{this.text}}</span>
          {{/each}}
        </div>
        {{/if}}
        {{/each}}
        {{/if}}

        {{#if this.iconRow}}
        {{#each this.cells}}
        {{#if this.showIcons}}
        <div class="rs-learn-icons state-{{this.state}}"
             style="{{this.iconStyle}}"
             data-rank="{{this.rank}}">
          {{#each this.grants}}
          <img src="{{this.img}}" width="64" height="64" alt="{{this.name}}" data-tt-kind="spellCardUuid" data-tt-uuid="{{this.uuid}}" data-card-kind="ability">
          {{/each}}
          {{#if this.showProse}}
          {{#each this.prose}}
          <span class="rs-learn-chip">{{this}}</span>
          {{/each}}
          {{/if}}
        </div>
        {{/if}}
        {{/each}}
        {{/if}}

        {{!-- Matrix mode: one row per stat, the stat named once in the gutter.
              Stats that carry the same number at every rank arrive already
              merged into one row, so the label can be several stats long and
              the gutter tooltip carries the whole of it. Empty in segment
              mode. --}}
        {{#each this.rows}}
        {{!-- The gold figure on the right is where the character stands on
              this row at their current rank. --}}
        <div class="rs-learn-gutter rs-learn-rowlabel is-stat" style="{{this.labelStyle}}">
          <span class="rs-learn-rowlabel-text" data-tooltip="{{this.label}}">{{this.label}}</span>
          {{#if this.total}}<span class="rs-learn-total" data-tooltip="{{this.totalTooltip}}">{{this.total}}</span>{{/if}}
        </div>
        {{#each this.cells}}
        {{#if this.text}}
        <div class="rs-learn-val state-{{this.state}}" style="{{this.style}}"
             data-rank="{{this.rank}}">{{this.text}}</div>
        {{/if}}
        {{/each}}
        {{/each}}

        {{!-- The requirements row. One chip per clause the book puts on that
              rank: dimmed once the character satisfies it, bright while it is
              still blocking. A teacher clause is the cap badge, which the GM
              clicks to grant or revoke that track's trainer. Both layouts get
              this row, and a rank the book asks nothing of stays empty. --}}
        <div class="rs-learn-gutter rs-learn-rowlabel is-reqs" style="{{this.reqLabelStyle}}">{{localize "REDSTEEL.Learn.requirements"}}</div>
        {{#each this.cells}}
        {{#if this.reqChips.length}}
        <div class="rs-learn-reqs state-{{this.state}}" style="{{this.reqStyle}}"
             data-rank="{{this.rank}}">
          {{#each this.reqChips}}
          {{#if this.teacher}}
          <a class="rs-learn-teacher {{this.cls}}" data-action="toggleTeacher"
             data-track-id="{{this.trackId}}" data-rank="{{this.rank}}"
             data-tooltip="{{this.tooltip}}">
            <i class="fas fa-graduation-cap"></i><b>{{this.roman}}</b>
          </a>
          {{else}}
          {{!-- The chip is terse enough to fit a column; the sentence behind it
                is on hover. --}}
          <span class="rs-learn-req {{this.cls}}"
                {{#if this.tooltip}}data-tooltip="{{this.tooltip}}"{{/if}}>{{this.text}}</span>
          {{/if}}
          {{/each}}
        </div>
        {{/if}}
        {{/each}}

        {{!-- The price row. The currency is named once in the gutter, so the
              cells carry the bare number. A discounted skill says so there,
              once (user ruling): hovering "Discounted" shows the source, as the
              feature's card or as the perk's name and text. The rank prices
              carry no tooltip of their own. The gold figure on the right is
              the total paid for the ranks held. --}}
        <div class="rs-learn-gutter rs-learn-rowlabel is-cost" style="{{this.costLabelStyle}}"><span class="rs-learn-rowlabel-text">{{this.costLabel}}{{#if this.discount}} <span class="rs-learn-discount-note">(<span class="rs-learn-discount-source"
               {{#if this.discount.uuid}}data-tt-kind="spellCardUuid" data-tt-uuid="{{this.discount.uuid}}" data-card-kind="feature"{{else}}data-tt-kind="text" data-tt-title="{{this.discount.title}}" data-tt-text="{{this.discount.text}}"{{/if}}>{{localize "REDSTEEL.Learn.Discounts.discounted"}}</span>)</span>{{/if}}</span>{{#if this.paid}}<span class="rs-learn-total" data-tooltip="{{this.paid.tooltip}}">{{this.paid.text}}</span>{{/if}}</div>
        {{#each this.cells}}
        {{#if this.exists}}
        <div class="rs-learn-cost state-{{this.state}}" style="{{this.costStyle}}"
             data-rank="{{this.rank}}">{{this.cost}}</div>
        {{/if}}
        {{/each}}

      </div>
      {{/each}}

    </section>
    {{/each}}

    {{#unless sections.length}}
    {{#if ribbon.length}}
    <p class="rs-learn-empty">{{localize "REDSTEEL.Learn.nothingToggled"}}</p>
    {{else}}
    <p class="rs-learn-empty">{{localize "REDSTEEL.Learn.nothingTracked"}}</p>
    {{/if}}
    {{/unless}}

  </div>
  {{/if}}

  {{else if isFeaturesTab}}
  {{!-- The Features tab. Two stone plates: on the left what the character
        already has (traits first, then bought features), on the right every
        priced feature still to take, grouped by the book's sections. Search and
        the "requirements met" toggle filter the right panel in place. --}}
  <div class="rs-learn-features">

    <section class="rs-learn-features-owned">
      {{#if features.traits.any}}
      <h3 class="rs-learn-section-title">{{localize "REDSTEEL.Learn.Features.traits"}}</h3>
      {{!-- Three columns, positive, neutral, negative (user ruling), each trait
            under the last with its name beside its icon. Clicking a trait rolls
            out its description; hovering the icon shows the full card. Traits
            the pack could not classify follow below the columns. --}}
      <div class="rs-learn-trait-columns">
        {{#each features.traits.columns}}
        <div class="rs-learn-trait-column is-{{this.polarity}}">
          <span class="rs-learn-trait-heading">{{this.label}}</span>
          {{#each this.items}}
          <div class="rs-learn-trait-entry {{#if this.expanded}}is-expanded{{/if}}"
               {{#if this.description}}data-action="toggleFeatureDescription" data-expand-key="{{this.expandKey}}"{{/if}}>
            <img class="rs-learn-trait" src="{{this.img}}" alt="{{this.name}}"
                 data-tt-kind="spellCardUuid" data-tt-uuid="{{this.uuid}}" data-card-kind="feature">
            <span class="rs-learn-trait-name">{{this.name}}</span>
            {{#if this.description}}<div class="rs-learn-feature-desc" {{#unless this.expanded}}hidden{{/unless}}>{{{this.description}}}</div>{{/if}}
          </div>
          {{/each}}
        </div>
        {{/each}}
      </div>
      {{#if features.traits.unsorted}}
      <div class="rs-learn-trait-column is-unsorted">
        <span class="rs-learn-trait-heading">{{features.traits.unsorted.label}}</span>
        {{#each features.traits.unsorted.items}}
        <div class="rs-learn-trait-entry {{#if this.expanded}}is-expanded{{/if}}"
             {{#if this.description}}data-action="toggleFeatureDescription" data-expand-key="{{this.expandKey}}"{{/if}}>
          <img class="rs-learn-trait" src="{{this.img}}" alt="{{this.name}}"
               data-tt-kind="spellCardUuid" data-tt-uuid="{{this.uuid}}" data-card-kind="feature">
          <span class="rs-learn-trait-name">{{this.name}}</span>
          {{#if this.description}}<div class="rs-learn-feature-desc" {{#unless this.expanded}}hidden{{/unless}}>{{{this.description}}}</div>{{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}
      {{/if}}

      <h3 class="rs-learn-section-title">{{localize "REDSTEEL.Learn.Features.owned"}}</h3>
      {{#each features.owned}}
      {{!-- Click the row to roll out the feature's description. --}}
      <div class="rs-learn-owned {{#if this.expanded}}is-expanded{{/if}}"
           {{#if this.description}}data-action="toggleFeatureDescription" data-expand-key="{{this.expandKey}}"{{/if}}>
        <img src="{{this.img}}" alt="{{this.name}}"
             data-tt-kind="spellCardUuid" data-tt-uuid="{{this.uuid}}" data-card-kind="feature">
        <span class="rs-learn-owned-name">{{this.name}}</span>
        {{#if this.racial}}
        <em>{{localize "REDSTEEL.Learn.Features.racial"}}</em>
        {{else if this.unpriced}}
        <em>{{localize "REDSTEEL.Learn.Features.unpriced"}}</em>
        {{else if this.native}}
        <em>{{localize "REDSTEEL.Learn.Languages.native"}}</em>
        {{else}}
        <b>{{this.costLabel}}</b>
        {{/if}}
        {{#if this.refundable}}
        <button type="button" class="rs-learn-owned-refund" data-action="refundFeature"
                data-item-id="{{this.itemId}}"
                aria-label="{{localize "REDSTEEL.Learn.Features.refund"}}">
          <i class="fas fa-rotate-left"></i>
        </button>
        {{/if}}
        {{#if this.description}}<div class="rs-learn-feature-desc" {{#unless this.expanded}}hidden{{/unless}}>{{{this.description}}}</div>{{/if}}
      </div>
      {{else}}
      <p class="rs-learn-empty">{{localize "REDSTEEL.Learn.Features.noneOwned"}}</p>
      {{/each}}

      {{#if features.discountPicks.length}}
      {{!-- Discounts that land on a skill of the player's choosing. The pick
            lives here, beside the features, since the Skills tab only notes a
            discount on the price row (user ruling). A skill another discount
            already covers is offered disabled, because discounts on one skill
            do not stack. --}}
      <h3 class="rs-learn-section-title">{{localize "REDSTEEL.Learn.Discounts.title"}}</h3>
      {{#each features.discountPicks}}
      <div class="rs-learn-discount-pick {{#unless this.skill}}is-unpicked{{/unless}}">
        <b>−{{this.amount}} {{this.currency}}</b>
        <span class="rs-learn-discount-pick-name">{{this.label}}</span>
        <select data-discount-source="{{this.id}}" aria-label="{{this.label}}"
                {{#unless @root.editable}}disabled{{/unless}}>
          <option value="">{{this.chooseLabel}}</option>
          {{#each this.options}}
          <option value="{{this.key}}" {{#if this.selected}}selected{{/if}} {{#if this.taken}}disabled{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      {{/each}}
      {{/if}}
    </section>

    <section class="rs-learn-features-available">
      {{#if features.languages}}
      {{!-- The Languages panel (user rulings 2026-09-14), in place of the list.
            The add row learns Basic communication in the typed language (Enter
            in the field does the same). The table has one row per known
            language and one diamond per slot; each column heading shows its
            feature's card on hover. --}}
      <header class="rs-learn-features-bar">
        <button type="button" class="rs-learn-feature-filter" data-action="closeFeatureFamily">
          <i class="fas fa-arrow-left"></i>
          {{localize "REDSTEEL.Learn.Features.back"}}
        </button>
        <span class="rs-learn-family-title">{{features.languages.title}}</span>
      </header>
      <div class="rs-learn-language-panel">
        <div class="rs-learn-language-add state-{{features.languages.add.state}}">
          <input type="text" class="rs-learn-language-name" maxlength="40"
                 value="{{features.languages.draft}}"
                 placeholder="{{localize "REDSTEEL.Learn.Languages.namePlaceholder"}}"
                 aria-label="{{localize "REDSTEEL.Learn.Languages.namePlaceholder"}}"
                 {{#unless features.languages.editable}}disabled{{/unless}}>
          <div class="rs-learn-node state-{{features.languages.add.state}}"
               {{#if features.languages.add.buyable}}data-action="buyLanguage" data-slot="basic"{{/if}}
               {{#if features.languages.add.reasons.length}}data-tooltip="<strong>{{localize "REDSTEEL.Learn.unmetRequirements"}}</strong>{{#each features.languages.add.reasons}}<br>{{this}}{{/each}}" data-tooltip-direction="UP"{{/if}}>
            <span class="rs-learn-diamond"></span>
            {{#if features.languages.add.showLock}}<i class="fas fa-lock rs-learn-lock"></i>{{/if}}
          </div>
          <span class="rs-learn-language-add-label">{{localize "REDSTEEL.Learn.Languages.add"}}</span>
          <b class="rs-learn-feature-cost">{{features.languages.add.costLabel}}</b>
          {{#if features.languages.canGrantNative}}
          <button type="button" class="rs-learn-feature-filter" data-action="grantNativeLanguage"
                  data-tooltip="{{features.languages.nativeHint}}">
            {{localize "REDSTEEL.Learn.Languages.grantNative"}}
          </button>
          {{/if}}
        </div>

        <div class="rs-learn-language-table">
          <div class="rs-learn-language-row is-head">
            <span class="rs-learn-language-cell is-name"></span>
            {{#each features.languages.headers}}
            <span class="rs-learn-language-cell rs-learn-language-slot"
                  data-tt-kind="spellCardUuid" data-tt-uuid="{{this.uuid}}" data-card-kind="feature">{{this.label}}</span>
            {{/each}}
          </div>
          {{#each features.languages.rows}}
          <div class="rs-learn-language-row">
            <span class="rs-learn-language-cell is-name">
              <span class="rs-learn-language-title">{{this.name}}</span>
              {{#if this.native}}<em class="rs-learn-language-native">{{localize "REDSTEEL.Learn.Languages.native"}}</em>{{/if}}
            </span>
            {{#each this.cells}}
            <div class="rs-learn-language-cell state-{{this.state}}">
              <div class="rs-learn-node state-{{this.state}} {{#if this.owned}}is-owned{{/if}}"
                   {{#if this.buyable}}data-action="buyLanguage" data-slot="{{this.slot}}" data-language="{{this.language}}"{{/if}}
                   {{#if this.reasons.length}}data-tooltip="<strong>{{localize "REDSTEEL.Learn.unmetRequirements"}}</strong>{{#each this.reasons}}<br>{{this}}{{/each}}" data-tooltip-direction="UP"{{/if}}>
                <span class="rs-learn-diamond"></span>
                {{#if this.showLock}}<i class="fas fa-lock rs-learn-lock"></i>{{/if}}
              </div>
              <b class="rs-learn-feature-cost">{{this.costLabel}}</b>
            </div>
            {{/each}}
          </div>
          {{else}}
          <p class="rs-learn-empty">{{localize "REDSTEEL.Learn.Languages.none"}}</p>
          {{/each}}
        </div>
      </div>
      {{else if features.picker}}
      {{!-- A family's skill picker, in place of the list: one column per skill
            class (A, B, C), each skill with its buy diamond, its name (hover for
            the feature's card) and its price. Only classed skills appear; the
            unclassed ones are left out on purpose (GM ruling), except for
            Specialization, which appends a fourth "Other skills" column for
            them (user ruling 2026-09-16). --}}
      <header class="rs-learn-features-bar">
        <button type="button" class="rs-learn-feature-filter" data-action="closeFeatureFamily">
          <i class="fas fa-arrow-left"></i>
          {{localize "REDSTEEL.Learn.Features.back"}}
        </button>
        <span class="rs-learn-family-title">{{features.picker.label}}</span>
      </header>
      <div class="rs-learn-family-columns {{#if features.picker.hasOther}}is-four{{/if}}">
        {{#each features.picker.columns}}
        <section class="rs-learn-family-column">
          <h3 class="rs-learn-section-title">{{this.label}}</h3>
          {{#each this.skills}}
          <div class="rs-learn-family-skill state-{{this.state}} {{#if this.expanded}}is-expanded{{/if}}"
               {{#if this.description}}data-action="toggleFeatureDescription" data-expand-key="{{this.expandKey}}"{{/if}}>
            <div class="rs-learn-node state-{{this.state}} {{#if this.owned}}is-owned{{/if}}"
                 {{#if (eq this.state "available")}}data-action="buyFeature" data-feature-id="{{this.id}}"{{/if}}
                 {{#if this.reasons.length}}data-tooltip="<strong>{{localize "REDSTEEL.Learn.unmetRequirements"}}</strong>{{#each this.reasons}}<br>{{this}}{{/each}}" data-tooltip-direction="UP"{{/if}}>
              <span class="rs-learn-diamond"></span>
              {{#if this.showLock}}<i class="fas fa-lock rs-learn-lock"></i>{{/if}}
            </div>
            <span class="rs-learn-family-skill-name"
                  data-tt-kind="spellCardUuid" data-tt-uuid="{{this.uuid}}" data-card-kind="feature">{{this.skillLabel}}</span>
            <b class="rs-learn-feature-cost">{{this.costLabel}}</b>
            {{#if this.description}}<div class="rs-learn-feature-desc" {{#unless this.expanded}}hidden{{/unless}}>{{{this.description}}}</div>{{/if}}
          </div>
          {{else}}
          <p class="rs-learn-empty">{{localize "REDSTEEL.Learn.Features.noSkills"}}</p>
          {{/each}}
        </section>
        {{/each}}
      </div>
      {{else}}
      <header class="rs-learn-features-bar">
        <input type="search" class="rs-learn-feature-search" value="{{features.query}}"
               placeholder="{{localize "REDSTEEL.Learn.Features.search"}}"
               aria-label="{{localize "REDSTEEL.Learn.Features.search"}}">
        {{!-- Every filter lives behind this one button (user ruling). The count
              is how many filters are away from their default, so a set filter
              is still visible with the drawer closed. --}}
        <button type="button" class="rs-learn-feature-filter {{#if features.filtersOpen}}active{{/if}}"
                aria-expanded="{{#if features.filtersOpen}}true{{else}}false{{/if}}"
                data-action="toggleFeatureFilters">
          <i class="fas fa-filter"></i>
          {{localize "REDSTEEL.Learn.Features.filters"}}
          <span class="rs-learn-filter-count" {{#unless features.activeFilters}}hidden{{/unless}}>{{features.activeFilters}}</span>
        </button>

        {{!-- The filter pop-up, anchored under the Filters button like a
              spreadsheet's column filter. Every tick filters the list at once
              (user ruling: no OK or Cancel); the Filters button or a click
              outside closes it. It is part of the screen rather than a dialog
              window, which would open underneath the full-screen Learn window. --}}
        <div class="rs-learn-filter-popup" role="dialog"
             aria-label="{{localize "REDSTEEL.Learn.Features.filters"}}"
             {{#unless features.filtersOpen}}hidden{{/unless}}>
          <div class="rs-learn-filter-group">
            <span class="rs-learn-filter-label">{{localize "REDSTEEL.Learn.Features.filterSections"}}</span>
            <label class="rs-learn-filter-check is-all">
              <input type="checkbox" data-filter-all-sections {{#if features.allSections}}checked{{/if}}>
              <span>{{localize "REDSTEEL.Learn.Features.selectAll"}}</span>
            </label>
            {{#each features.sectionChecks}}
            <label class="rs-learn-filter-check">
              <input type="checkbox" data-filter-section="{{this.id}}" {{#if this.checked}}checked{{/if}}>
              <span>{{this.label}}</span>
            </label>
            {{/each}}
          </div>
          <div class="rs-learn-filter-group">
            <span class="rs-learn-filter-label">{{localize "REDSTEEL.Learn.Features.filterShow"}}</span>
            <label class="rs-learn-filter-check">
              <input type="checkbox" data-filter-only-met {{#if features.onlyMet}}checked{{/if}}>
              <span>{{localize "REDSTEEL.Learn.Features.onlyMet"}}</span>
            </label>
            {{!-- Off by default: on, only features that build on a track the
                  character already holds a rank in (Drinking I shows Drinker). --}}
            <label class="rs-learn-filter-check">
              <input type="checkbox" data-filter-have-skill {{#if features.haveSkill}}checked{{/if}}>
              <span>{{localize "REDSTEEL.Learn.Features.haveSkill"}}</span>
            </label>
            {{!-- Off by default: features only another race can take stay hidden. --}}
            <label class="rs-learn-filter-check">
              <input type="checkbox" data-filter-all-races {{#if features.allRaces}}checked{{/if}}>
              <span>{{localize "REDSTEEL.Learn.Features.allRaces"}}</span>
            </label>
            {{!-- Off by default: magic features stay hidden for a character with
                  neither Magic Potential nor the School of Blood (user ruling). --}}
            <label class="rs-learn-filter-check">
              <input type="checkbox" data-filter-all-magic {{#if features.allMagic}}checked{{/if}}>
              <span>{{localize "REDSTEEL.Learn.Features.allMagic"}}</span>
            </label>
          </div>
          <footer class="rs-learn-filter-actions">
            <button type="button" data-action="resetFeatureFilters">{{localize "REDSTEEL.Learn.Features.reset"}}</button>
          </footer>
        </div>
      </header>

      <div class="rs-learn-features-list">
        {{#each features.sections}}
        <section class="rs-learn-feature-section" data-section="{{this.id}}">
          <h3 class="rs-learn-section-title">{{this.label}}</h3>
          {{#each this.rows}}
          {{#if this.isFamily}}
          {{!-- A per-skill family (Specialization, Adept…) as one row: clicking
                it opens the skill picker. --}}
          <div class="rs-learn-feature is-family state-{{this.state}}"
               data-action="openFeatureFamily" data-family="{{this.family}}"
               data-meets="{{#if this.meets}}true{{else}}false{{/if}}"
               data-race-fits="{{#if this.raceFits}}true{{else}}false{{/if}}"
               data-magic-fits="{{#if this.magicFits}}true{{else}}false{{/if}}"
               data-skill-fits="{{#if this.skillFits}}true{{else}}false{{/if}}"
               data-search="{{this.search}}">
            <div class="rs-learn-node state-{{this.state}} {{#if (eq this.state "owned")}}is-owned{{/if}}">
              <span class="rs-learn-diamond"></span>
            </div>
            <img class="rs-learn-feature-icon" src="{{this.img}}" alt="{{this.name}}">
            <span class="rs-learn-feature-name">{{this.name}} <i class="fas fa-angle-right"></i></span>
            <span class="rs-learn-feature-reqs"><span class="rs-learn-family-summary">{{this.summary}}</span></span>
            <b class="rs-learn-feature-cost">{{this.costLabel}}</b>
          </div>
          {{else}}
          {{!-- One feature. The diamond buys it, as on the rank tracks; a locked
                or taken diamond names what stands in the way on hover. --}}
          <div class="rs-learn-feature state-{{this.state}} {{#if this.expanded}}is-expanded{{/if}}"
               data-meets="{{#if this.meets}}true{{else}}false{{/if}}"
               data-race-fits="{{#if this.raceFits}}true{{else}}false{{/if}}"
               data-magic-fits="{{#if this.magicFits}}true{{else}}false{{/if}}"
               data-skill-fits="{{#if this.skillFits}}true{{else}}false{{/if}}"
               data-search="{{this.search}}"
               {{#if this.description}}data-action="toggleFeatureDescription" data-expand-key="{{this.expandKey}}"{{/if}}>
            <div class="rs-learn-node state-{{this.state}}"
                 {{#if (eq this.state "available")}}data-action="buyFeature" data-feature-id="{{this.id}}"{{/if}}
                 {{#if this.reasons.length}}data-tooltip="<strong>{{localize "REDSTEEL.Learn.unmetRequirements"}}</strong>{{#each this.reasons}}<br>{{this}}{{/each}}" data-tooltip-direction="UP"{{/if}}>
              <span class="rs-learn-diamond"></span>
              {{#if this.showLock}}<i class="fas fa-lock rs-learn-lock"></i>{{/if}}
            </div>
            <img class="rs-learn-feature-icon" src="{{this.img}}" alt="{{this.name}}"
                 data-tt-kind="spellCardUuid" data-tt-uuid="{{this.uuid}}" data-card-kind="feature">
            <span class="rs-learn-feature-name">{{this.name}}</span>
            <span class="rs-learn-feature-reqs">
              {{#each this.reqChips}}
              <span class="rs-learn-req {{this.cls}}"
                    {{#if this.tooltip}}data-tooltip="{{this.tooltip}}"{{/if}}>{{this.text}}</span>
              {{/each}}
            </span>
            <b class="rs-learn-feature-cost">{{this.costLabel}}</b>
            {{#if this.description}}<div class="rs-learn-feature-desc" {{#unless this.expanded}}hidden{{/unless}}>{{{this.description}}}</div>{{/if}}
          </div>
          {{/if}}
          {{/each}}
        </section>
        {{/each}}
        <p class="rs-learn-empty rs-learn-features-none" hidden>{{localize "REDSTEEL.Learn.Features.noneMatch"}}</p>
      </div>
      {{/if}}
    </section>

  </div>

  {{else if isSpellsTab}}
  {{!-- The Spells tab: one full-width stone plate, the spell roster. Over it
        the school pills with the open grimoire at the end of the same line,
        then the rank pages beside the search/filter bar; under them every
        spell of the open rank (of the school, or of every school held,
        merged) as a tile, grouped by school.
        A tile is lit while the spell is held (castable), dim otherwise. Writing
        a spell into the book is free; memorising it is 1 SP (Pravidla, Paměť).
        Search and the filter pop-up filter the roster in place. --}}
  <section class="rs-learn-roster" data-school="{{spells.activeSchool}}">
    {{!-- One pill per school the character holds, with its rank; the GM can
          switch every school on to hand a spell over at the table. --}}
    <div class="rs-learn-spell-schools">
      {{#each spells.schools}}
      <button type="button" class="rs-learn-spell-school {{#if this.active}}active{{/if}}"
              data-action="switchSpellSchool" data-school="{{this.key}}"
              data-tooltip="{{this.countLabel}}">
        <span class="rs-learn-spell-school-name">{{this.label}}</span>
        {{#if this.rankLabel}}<b>{{this.rankLabel}}</b>{{/if}}
      </button>
      {{else}}
      <span class="rs-learn-spell-noschools">{{localize "REDSTEEL.Learn.Spells.noSchools"}}</span>
      {{/each}}
      {{#if spells.canMerge}}
      {{!-- Every school the character holds on one list, ranked. --}}
      <button type="button" class="rs-learn-spell-school rs-learn-spell-school-all {{#if spells.merged}}active{{/if}}"
              data-action="toggleMergedSchools"
              data-tooltip="{{localize "REDSTEEL.Learn.Spells.allSchoolsHint"}}">
        <span class="rs-learn-spell-school-name">{{localize "REDSTEEL.Learn.Spells.allSchools"}}</span>
      </button>
      {{/if}}
      {{#if spells.isGM}}
      <button type="button" class="rs-learn-feature-filter {{#if spells.allSchools}}active{{/if}}"
              data-action="toggleAllSchools"
              data-tooltip="{{localize "REDSTEEL.Learn.Spells.browseAllSchoolsHint"}}">
        {{localize "REDSTEEL.Learn.Spells.browseAllSchools"}}
      </button>
      {{/if}}

      {{!-- The grimoire strip: one plate per book carried, the open one lit,
            then the lost books behind a button. The plate already carries the
            book's name and how many spells stand in it, so neither is repeated
            as loose text beside it (user ruling 2026-09-21). Clicking the open
            book opens its sheet, which is where it is renamed. --}}
      <div class="rs-learn-roster-grimoire">
        {{#if spells.hasBook}}
        <div class="rs-learn-spell-books">
          {{#each spells.books}}
          <button type="button" class="rs-learn-spell-book {{#if this.active}}active{{/if}}"
                  data-action="switchSpellBook" data-book-id="{{this.id}}"
                  data-tooltip="{{this.tooltip}}">
            <img src="{{this.img}}" alt="{{this.name}}">
            <span class="rs-learn-spell-book-name">{{this.name}}</span>
            <b>{{this.countLabel}}</b>
          </button>
          {{/each}}
        </div>
        {{else}}
        {{!-- No grimoire at all: say so. --}}
        <span class="rs-learn-roster-grimoire-none">{{localize "REDSTEEL.Learn.Spells.noBook"}}</span>
        {{/if}}
        {{!-- A new grimoire can always be started, a second one included. --}}
        {{#if editable}}
        <button type="button" class="rs-learn-feature-filter" data-action="createSpellbook">
          <i class="fas fa-book"></i>
          {{localize "REDSTEEL.Learn.Spells.newBook"}}
        </button>
        {{/if}}
        {{#if spells.archive.length}}
        <button type="button" class="rs-learn-feature-filter rs-learn-roster-lost {{#if spells.archiveOpen}}active{{/if}}"
                aria-expanded="{{#if spells.archiveOpen}}true{{else}}false{{/if}}"
                data-action="toggleSpellArchive">
          <i class="fas fa-book-skull"></i>
          {{spells.lostBooksLabel}}
        </button>
        {{/if}}
      </div>
    </div>

    {{#if spells.archive.length}}
    {{!-- What a lost book held, kept so a delete by accident costs a click
          rather than an evening of rewriting. --}}
    <div class="rs-learn-roster-archive" {{#unless spells.archiveOpen}}hidden{{/unless}}>
      <p class="rs-learn-spell-hint">{{localize "REDSTEEL.Learn.Spells.lostHint"}}</p>
      {{#each spells.archive}}
      <div class="rs-learn-spell-archive">
        <img src="{{this.img}}" alt="{{this.name}}">
        <span class="rs-learn-spell-entry-name">{{this.name}}</span>
        <em class="rs-learn-spell-entry-note">{{this.countLabel}}{{#if this.when}}, {{this.when}}{{/if}}</em>
        {{#if @root.editable}}
        <button type="button" class="rs-learn-spell-erase" data-action="restoreSpellbook"
                data-book-id="{{this.id}}"
                data-tooltip="{{localize "REDSTEEL.Learn.Spells.restore"}}"
                aria-label="{{localize "REDSTEEL.Learn.Spells.restore"}}">
          <i class="fas fa-book-medical"></i>
        </button>
        <button type="button" class="rs-learn-spell-erase" data-action="forgetSpellbook"
                data-book-id="{{this.id}}"
                data-tooltip="{{localize "REDSTEEL.Learn.Spells.forgetBook"}}"
                aria-label="{{localize "REDSTEEL.Learn.Spells.forgetBook"}}">
          <i class="fas fa-trash"></i>
        </button>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{/if}}

    <header class="rs-learn-features-bar rs-learn-spells-bar">
      {{#unless spells.noSchools}}
      {{!-- The ranks as pages: one plate each, and only the open rank is
            on the list. A search is the one thing that reaches across them. --}}
      <div class="rs-learn-spell-ranks">
        {{#each spells.rankPills}}
        <button type="button" class="rs-learn-spell-rankpill {{#if this.active}}active{{/if}}"
                data-action="toggleSpellRank" data-rank="{{this.key}}">
          <span>{{this.label}}</span>
          <b>{{this.count}}</b>
        </button>
        {{/each}}
      </div>
      {{/unless}}
      <input type="search" class="rs-learn-spell-search" value="{{spells.query}}"
             placeholder="{{localize "REDSTEEL.Learn.Spells.searchAll"}}"
             aria-label="{{localize "REDSTEEL.Learn.Spells.searchAll"}}">
      {{!-- Every filter lives behind this one button, as on the Features tab.
            The count is how many filters are away from their default. --}}
      <button type="button" class="rs-learn-feature-filter {{#if spells.filtersOpen}}active{{/if}}"
              aria-expanded="{{#if spells.filtersOpen}}true{{else}}false{{/if}}"
              data-action="toggleSpellFilters">
        <i class="fas fa-filter"></i>
        {{localize "REDSTEEL.Learn.Spells.filters"}}
        <span class="rs-learn-filter-count rs-learn-spell-filter-count" {{#unless spells.activeFilters}}hidden{{/unless}}>{{spells.activeFilters}}</span>
      </button>

      <div class="rs-learn-filter-popup rs-learn-spell-filter-popup" role="dialog"
           aria-label="{{localize "REDSTEEL.Learn.Spells.filters"}}"
           {{#unless spells.filtersOpen}}hidden{{/unless}}>
        <div class="rs-learn-filter-group">
          <span class="rs-learn-filter-label">{{localize "REDSTEEL.Learn.Spells.filterAction"}}</span>
          {{#each spells.actionChecks}}
          <label class="rs-learn-filter-check">
            <input type="checkbox" data-spell-action="{{this.key}}" {{#if this.checked}}checked{{/if}}>
            <span>{{this.label}}</span>
          </label>
          {{/each}}
        </div>
        <div class="rs-learn-filter-group">
          <span class="rs-learn-filter-label">{{localize "REDSTEEL.Learn.Spells.filterProperties"}}</span>
          <label class="rs-learn-filter-check">
            <input type="checkbox" data-spell-concentration {{#if spells.concentration}}checked{{/if}}>
            <span>{{localize "REDSTEEL.Learn.Spells.concentration"}}</span>
          </label>
          <label class="rs-learn-filter-check">
            <input type="checkbox" data-spell-sustained {{#if spells.sustained}}checked{{/if}}>
            <span>{{localize "REDSTEEL.Learn.Spells.sustained"}}</span>
          </label>
        </div>
        {{!-- Where the character stands with a spell, matched as "any of
              these": castable (held), in the open book, memorised, not held. --}}
        <div class="rs-learn-filter-group">
          <span class="rs-learn-filter-label">{{localize "REDSTEEL.Learn.Spells.filterStatus"}}</span>
          {{#each spells.statusChecks}}
          <label class="rs-learn-filter-check">
            <input type="checkbox" data-spell-status="{{this.key}}" {{#if this.checked}}checked{{/if}}>
            <span>{{this.label}}</span>
          </label>
          {{/each}}
        </div>
        <div class="rs-learn-filter-group">
          <span class="rs-learn-filter-label">{{localize "REDSTEEL.Learn.Spells.filterRole"}}</span>
          {{#each spells.roleChecks}}
          <label class="rs-learn-filter-check">
            <input type="checkbox" data-spell-role="{{this.key}}" {{#if this.checked}}checked{{/if}}>
            <span>{{this.label}}</span>
          </label>
          {{/each}}
        </div>
        {{#if spells.dmgTypeChecks.length}}
        {{!-- Only the damage types some spell on the roster actually deals. --}}
        <div class="rs-learn-filter-group">
          <span class="rs-learn-filter-label">{{localize "REDSTEEL.Learn.Spells.filterDamage"}}</span>
          {{#each spells.dmgTypeChecks}}
          <label class="rs-learn-filter-check">
            <input type="checkbox" data-spell-dmg="{{this.key}}" {{#if this.checked}}checked{{/if}}>
            <span>{{this.label}}</span>
          </label>
          {{/each}}
        </div>
        {{/if}}
        <footer class="rs-learn-filter-actions">
          <button type="button" data-action="resetSpellFilters">{{localize "REDSTEEL.Learn.Spells.reset"}}</button>
        </footer>
      </div>
    </header>

    <div class="rs-learn-roster-body">
      {{#each spells.sections}}
      <section class="rs-learn-roster-school" data-school="{{this.key}}">
        {{!-- The whole school in one grid, ordered by rank then name. No
              heading: the open school is named on its own lit pill above, and
              every card on a rank page is the same rank (user ruling
              2026-09-20). --}}
        <div class="rs-learn-roster-grid">
          {{#each this.spells}}
            {{!-- One spell. No hover card: the tile already prints everything
                  that card carried. The Read more control at its foot lifts the
                  three-line clamp off every card in the same grid row, and the
                  two marks in the corner are the
                  controls: the book writes/erases, the brain memorises/forgets,
                  and each keeps its own action because the nearest data-action
                  wins. The expand key stays on the tile so the handler can
                  remember which cards were open across a re-render.
                  Every data attribute here is read by #applySpellFilters. --}}
            <div class="rs-learn-spell-tile state-{{this.state}} {{#if this.owned}}is-held{{else}}is-dim{{/if}} {{#if this.expanded}}is-expanded{{/if}}"
                 {{#if this.description}}data-expand-key="{{this.expandKey}}"{{/if}}
                 data-rank="{{this.rank}}"
                 data-actions="{{this.actionBucket}}"
                 data-free="{{#if this.free}}true{{else}}false{{/if}}"
                 data-reaction="{{#if this.reaction}}true{{else}}false{{/if}}"
                 data-concentration="{{#if this.concentration}}true{{else}}false{{/if}}"
                 data-sustained="{{#if this.sustained}}true{{else}}false{{/if}}"
                 data-state="{{this.state}}"
                 data-held="{{#if this.held}}true{{else}}false{{/if}}"
                 data-written="{{#if this.inActiveBook}}true{{else}}false{{/if}}"
                 data-memorised="{{#if (eq this.state "memorised")}}true{{else if this.innate}}true{{else}}false{{/if}}"
                 data-offensive="{{#if this.offensive}}true{{else}}false{{/if}}"
                 data-dmg="{{this.dmgTypesKey}}"
                 data-search="{{this.searchText}}">
              {{!-- One centred column: the title, the icon with the damage
                    footnote under it, then the tags (user ruling 2026-09-20).
                    The title is padded clear of the corner marks on BOTH
                    sides, so it stays optically centred. --}}
              <span class="rs-learn-spell-tile-name">{{this.name}}</span>
              {{!-- The head row, in three columns: the marks, the icon dead
                    centre under the title, and the price panel. Everything in
                    the panel is what the spell takes from the caster, so the
                    reader gets the bill without reading the prose (user
                    ruling 2026-09-21). --}}
              <div class="rs-learn-spell-tile-head">
                {{!-- The grimoire and memory marks. They live in the head
                      row's empty left column rather than hanging off the
                      icon, so they sit centred in the gutter between the
                      card's edge and the icon (user ruling 2026-09-21). --}}
                <div class="rs-learn-spell-tile-marks {{#if this.innate}}is-single{{/if}}">
                  {{!-- Book mark: lit when in the open grimoire, part-way back when
                        it is written in another one, grey when written nowhere.
                        Wild magic is never written down, so it has none at all
                        (user ruling 2026-09-20). --}}
                  {{#unless this.innate}}
                  <button type="button"
                          class="rs-learn-spell-mark is-book {{#if this.inActiveBook}}is-lit{{else if this.writtenElsewhere}}is-elsewhere{{/if}}"
                          {{#if @root.editable}}{{#if this.canWrite}}data-action="writeSpell" data-uuid="{{this.uuid}}"{{else if this.canErase}}data-action="eraseSpell" data-uuid="{{this.uuid}}"{{/if}}{{/if}}
                          data-tooltip="{{this.bookTooltip}}" data-tooltip-direction="UP"
                          aria-label="{{this.bookTooltip}}">
                    <img src="{{@root.spells.bookIcon}}" alt="">
                  </button>
                  {{/unless}}
                  {{!-- Memory mark: lit when memorised. Wild magic is lit and
                        sealed, and cannot be clicked. --}}
                  {{#if this.innate}}
                  <span class="rs-learn-spell-mark is-memory is-lit is-innate"
                        data-tooltip="{{this.memoriseTooltip}}" data-tooltip-direction="UP"
                        aria-label="{{this.memoriseTooltip}}">
                    <img src="{{@root.spells.memoryIcon}}" alt="">
                    <i class="fas fa-lock rs-learn-spell-mark-seal"></i>
                  </span>
                  {{else}}
                  <button type="button"
                          class="rs-learn-spell-mark is-memory {{#if (eq this.state "memorised")}}is-lit{{/if}}"
                          {{#if @root.editable}}{{#if this.canMemorise}}data-action="memoriseSpell" data-uuid="{{this.uuid}}"{{else if this.canForget}}data-action="forgetSpell" data-uuid="{{this.uuid}}"{{/if}}{{/if}}
                          data-tooltip="{{this.memoriseTooltip}}" data-tooltip-direction="UP"
                          aria-label="{{this.memoriseTooltip}}">
                    <img src="{{@root.spells.memoryIcon}}" alt="">
                  </button>
                  {{/if}}
                </div>
                <div class="rs-learn-spell-tile-iconwrap">
                  <img class="rs-learn-spell-tile-icon" src="{{this.img}}" alt="{{this.name}}">
                  {{!-- What the spell deals, as fine print under the icon. The
                        line is always here, empty for a spell that deals no
                        damage, so the tags below it start at the same height on
                        every card (user ruling 2026-09-20). --}}
                  <div class="rs-learn-spell-tile-dmg">{{this.tileDmg}}</div>
                </div>
                {{!-- The price panel: Difficulty, cost, action cost, then the
                      per-round upkeep and the Corruption or Mind the cast heaps
                      on. Stacked full width so the numbers rule up down the
                      column. --}}
                <div class="rs-learn-spell-tile-keys">
                  {{#each this.tileKeys}}
                  <span class="rs-learn-spell-tile-cell" data-cell="{{this.key}}">
                    <span class="rs-learn-spell-tile-cell-label">{{this.label}}</span>
                    {{#if this.value}}<span class="rs-learn-spell-tile-cell-value">{{this.value}}</span>{{/if}}
                  </span>
                  {{/each}}
                </div>
              </div>
              {{!-- What the spell reaches and how it behaves: one line of
                    fine print under the head, the entries divided by middots
                    rather than each struck on its own plate (user ruling
                    2026-09-21). The plates belong to the price panel, where a
                    number needs a frame around it; this reads as a caption.
                    The line is as long as the spell is complicated: an entry
                    with nothing to say is left out, and the class carries its
                    own wording instead of a label. The dividers are drawn by
                    the stylesheet, so nothing here has to know which entry
                    comes last. --}}
              <div class="rs-learn-spell-tile-stats">
                {{#each this.tileStats}}
                <span class="rs-learn-spell-tile-stat" data-stat="{{this.key}}">{{#if this.label}}<span class="rs-learn-spell-tile-stat-label">{{this.label}}</span> {{/if}}{{#if this.value}}<span class="rs-learn-spell-tile-stat-value">{{this.value}}</span>{{/if}}</span>
                {{/each}}
              </div>
              {{!-- The spell's own prose, under the information shortcuts.
                    Stored HTML, so it goes in whole; three lines show and Read
                    more rolls the rest out, for this card and its row-mates
                    together. Both labels are always here: the stylesheet shows
                    whichever one fits the card's state, so no script touches
                    the text. --}}
              {{#if this.description}}<div class="rs-learn-spell-tile-desc">{{{this.description}}}</div>{{/if}}
              {{#if this.description}}
              <button type="button" class="rs-learn-spell-tile-more" data-action="expandSpellRow">
                <span class="rs-learn-spell-more-open">{{localize "REDSTEEL.Learn.Spells.readMore"}}</span>
                <span class="rs-learn-spell-more-close">{{localize "REDSTEEL.Learn.Spells.readLess"}}</span>
              </button>
              {{/if}}
              {{#if this.showLock}}<i class="fas fa-lock rs-learn-spell-tile-lock" data-tooltip="{{this.needs}}"></i>{{/if}}
            </div>
          {{/each}}
        </div>
      </section>
      {{/each}}
      <p class="rs-learn-empty rs-learn-spells-none" {{#if spells.rows.length}}hidden{{/if}}>{{localize "REDSTEEL.Learn.Spells.none"}}</p>
    </div>
  </section>

  {{else if isSpecsTab}}
  {{!-- The Specialisations tab (user rulings 2026-09-11, 2026-09-14). The main
        view holds the character's owned specialisation cards and one Learn
        Specialisation card, which opens the picker: Combat specialisations
        (at most four Specialisation points) and Support specialisations
        (uncapped), with what the character already owns left out. Each card
        or row has the buy diamond (an owned one gives the specialisation back
        while none of its nodes is unlocked) and its price. Clicking one opens
        its star sign in place of the view, to browse; nodes are still unlocked
        on the sheet. A purchase returns to the main view. --}}

  {{!-- One specialisation card, shared by the main view and the picker's
        gallery. Called with the row as `spec`; @root still reaches the window's
        context, so the GM's pencil keeps its gate. --}}
  {{#*inline "rsSpecCard"}}
  <div class="rs-learn-spec-card state-{{spec.state}} {{#if spec.wip}}is-wip{{/if}}"
       data-action="openSpec" data-spec="{{spec.id}}">
    <div class="rs-learn-spec-token"><img src="{{spec.img}}" alt=""></div>
    {{!-- SPEC ICON EDITOR (temporary): the GM's icon picker. Hidden for now
          (user request 2026-09-14), to be deleted with the rest of the editor;
          see the checklist above SPEC_ICON_SETTING in learnWindow.mjs.

    {{#if @root.isGM}}
    <button type="button" class="rs-learn-spec-icon-edit" data-action="editSpecIcon" data-spec="{{spec.id}}"
            data-tooltip="{{localize "REDSTEEL.Learn.Specs.IconEdit.edit"}}"
            aria-label="{{localize "REDSTEEL.Learn.Specs.IconEdit.edit"}}">
      <i class="fas fa-pen"></i>
    </button>
    {{/if}}
    --}}
    <div class="rs-learn-spec-card-name">{{spec.label}}</div>
    {{#if spec.wip}}
    <p class="rs-learn-spec-card-wip">{{localize "REDSTEEL.Learn.Specs.wip"}}</p>
    {{else}}
    <p class="rs-learn-spec-card-desc">{{spec.summary}}</p>
    {{/if}}
    <div class="rs-learn-spec-card-foot">
      <div class="rs-learn-node state-{{spec.nodeState}} {{#if spec.owned}}is-owned{{/if}}"
           {{#if spec.canBuy}}data-action="buySpec" data-spec="{{spec.id}}"{{/if}}
           {{#if spec.refundable}}data-action="refundSpec" data-spec="{{spec.id}}" data-tooltip="{{localize "REDSTEEL.Learn.Specs.refundTip"}}"{{/if}}
           {{#if spec.refundBlocked}}data-tooltip="{{localize "REDSTEEL.Learn.Specs.refundBlocked"}}"{{/if}}
           {{#if spec.reasons.length}}data-tooltip="<strong>{{spec.reasonsTitle}}</strong>{{#each spec.reasons}}<br>{{this}}{{/each}}" data-tooltip-direction="UP"{{/if}}>
        <span class="rs-learn-diamond"></span>
        {{#if spec.showLock}}<i class="fas fa-lock rs-learn-lock"></i>{{/if}}
      </div>
      <span class="rs-learn-spec-card-price">
        <b>{{spec.costLabel}}</b>
        {{#if spec.nodeSummary}}<em>{{spec.nodeSummary}}</em>{{/if}}
      </span>
    </div>
  </div>
  {{/inline}}

  {{!-- Specialisation points left: only on this tab's bar (user ruling), at its
        right end, in the main view and the picker but not over a star sign. --}}
  {{#*inline "rsSpecPoints"}}
  <span class="rs-learn-spec-points">
    <label>{{localize "REDSTEEL.Learn.Specs.pointsLeft"}}</label>
    <b>{{@root.specWallet.remaining}}</b>
    <em>/ {{@root.specWallet.earned}}</em>
  </span>
  {{/inline}}

  <div class="rs-learn-specs {{#if specs.open}}is-open{{/if}}">

    {{#if specs.open}}
    <section class="rs-learn-spec-view">
      <header class="rs-learn-features-bar rs-learn-spec-bar">
        <button type="button" class="rs-learn-feature-filter" data-action="closeSpec">
          <i class="fas fa-arrow-left"></i>
          {{localize "REDSTEEL.Learn.Specs.back"}}
        </button>
        {{#with specs.open as |spec|}}
        <div class="rs-learn-spec-head state-{{spec.state}}">
          <div class="rs-learn-node state-{{spec.nodeState}} {{#if spec.owned}}is-owned{{/if}}"
               {{#if spec.canBuy}}data-action="buySpec" data-spec="{{spec.id}}"{{/if}}
               {{#if spec.refundable}}data-action="refundSpec" data-spec="{{spec.id}}" data-tooltip="{{localize "REDSTEEL.Learn.Specs.refundTip"}}"{{/if}}
               {{#if spec.refundBlocked}}data-tooltip="{{localize "REDSTEEL.Learn.Specs.refundBlocked"}}"{{/if}}
               {{#if spec.reasons.length}}data-tooltip="<strong>{{spec.reasonsTitle}}</strong>{{#each spec.reasons}}<br>{{this}}{{/each}}" data-tooltip-direction="UP"{{/if}}>
            <span class="rs-learn-diamond"></span>
            {{#if spec.showLock}}<i class="fas fa-lock rs-learn-lock"></i>{{/if}}
          </div>
          <span class="rs-learn-spec-title">
            <span>{{spec.label}}</span>
            {{#if spec.nodeSummary}}<em>{{spec.nodeSummary}}</em>{{/if}}
          </span>
          <span class="rs-learn-feature-reqs">
            {{#each spec.reqChips}}
            {{#if this.teacher}}
            <a class="rs-learn-teacher {{this.cls}}"
               {{#if @root.isGM}}data-action="toggleSpecTeacher" data-spec="{{this.specId}}"{{/if}}
               data-tooltip="{{this.tooltip}}">
              <i class="fas fa-graduation-cap"></i><b>{{this.roman}}</b>
            </a>
            {{else}}
            <span class="rs-learn-req {{this.cls}}"
                  {{#if this.tooltip}}data-tooltip="{{this.tooltip}}"{{/if}}>{{this.text}}</span>
            {{/if}}
            {{/each}}
          </span>
          <b class="rs-learn-feature-cost">{{spec.costLabel}}</b>
        </div>
        {{/with}}
      </header>

      {{!-- The star sign, drawn the way the sheet's Specialisations tab draws
            it. Each node carries its price under its name; on an owned
            specialisation a buyable or refundable node carries its action, and
            its tooltip adds the price and what stands in the way. --}}
      <div class="rs-learn-spec-view-body">
        {{#with specs.open.tree as |tree|}}
        <div class="spec-tree-wrap">
          <div class="spec-tree{{#if tree.constellation}} constellation constellation-{{tree.id}}{{/if}}"
               {{#unless tree.constellation}}style="width: {{tree.width}}px; height: {{tree.height}}px;"{{/unless}}>
            {{#if tree.constellation}}
            <svg class="spec-tree-links" viewBox="0 0 100 100" preserveAspectRatio="none" width="100%" height="100%">
              {{#each tree.links as |link|}}
              <line class="spec-link {{#if link.active}}active{{/if}}" x1="{{link.x1}}" y1="{{link.y1}}" x2="{{link.x2}}" y2="{{link.y2}}" />
              {{/each}}
            </svg>
            {{else}}
            <svg class="spec-tree-links" width="{{tree.width}}" height="{{tree.height}}">
              {{#each tree.links as |link|}}
              <line class="spec-link {{#if link.active}}active{{/if}}" x1="{{link.x1}}" y1="{{link.y1}}" x2="{{link.x2}}" y2="{{link.y2}}" />
              {{/each}}
            </svg>
            {{/if}}
            {{#each tree.nodes as |node|}}
            <span class="spec-node {{node.state}} {{#if node.automated}}automated{{/if}}"
                  style="left: {{node.x}}{{#if tree.constellation}}%{{else}}px{{/if}}; top: {{node.y}}{{#if tree.constellation}}%{{else}}px{{/if}};"
                  {{#if node.action}}data-action="{{node.action}}" data-spec="{{tree.id}}" data-node="{{node.id}}"{{/if}}
                  data-tt-kind="specNode" data-tt-id="{{node.id}}" data-tt-spec="{{tree.id}}"
                  {{#if node.costLabel}}data-tt-cost="{{node.costLabel}}"{{/if}}
                  {{#if node.tipReasons}}data-tt-reasons="{{node.tipReasons}}" data-tt-reasons-title="{{node.tipReasonsTitle}}"{{/if}}
                  {{#if node.tipAdvisory}}data-tt-advisory="{{node.tipAdvisory}}"{{/if}}>
              {{#if node.icon}}<img src="{{node.icon}}" alt="">{{/if}}
              {{!-- The name, and under it the line the star is priced on: the
                    price, and the cap of the trainer the book gates the star
                    on. The cap sits beside the price rather than on the star,
                    where it covered the artwork. Gold once the GM has granted
                    the teacher for THIS star, dim while it is missing. Only
                    the GM's cap is a control, and it is the one thing in the
                    label that takes a pointer, so its own data-action wins
                    over the star's buy/refund one. --}}
              <span class="spec-node-label">{{localize node.label}}<span class="spec-node-meta">
                {{~#if node.costLabel~}}
                <span class="spec-node-cost">{{node.costLabel}}</span>
                {{~/if~}}
                {{~#if node.teacher~}}
                <span class="spec-node-teacher {{node.teacher.cls}}"
                      {{#if node.teacher.action}}data-action="{{node.teacher.action}}" data-spec="{{node.teacher.specId}}" data-node="{{node.teacher.nodeId}}"{{/if}}
                      data-tt-kind="text" data-tt-text="{{node.teacher.tooltip}}"><i class="fas fa-graduation-cap"></i><b>{{node.teacher.roman}}</b></span>
                {{~/if~}}
              </span></span>
            </span>
            {{/each}}
          </div>
        </div>
        {{/with}}
        {{!-- The picks of the owned perks that discount one skill or doctrine
              from a list (Lindar: a combat doctrine), under the star sign they
              belong to (user ruling 2026-09-15). The Features tab lists the
              same picks; either one writes the same choice. A key another
              discount already covers is offered disabled. --}}
        {{#if specs.open.discountPicks.length}}
        <div class="rs-learn-spec-picks">
          {{#each specs.open.discountPicks}}
          <div class="rs-learn-discount-pick {{#unless this.skill}}is-unpicked{{/unless}}">
            <b>−{{this.amount}} {{this.currency}}</b>
            <span class="rs-learn-discount-pick-name">{{this.label}}</span>
            <select data-discount-source="{{this.id}}" aria-label="{{this.label}}"
                    {{#unless @root.editable}}disabled{{/unless}}>
              <option value="">{{this.chooseLabel}}</option>
              {{#each this.options}}
              <option value="{{this.key}}" {{#if this.selected}}selected{{/if}} {{#if this.taken}}disabled{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{!-- A Specialist-style discount landing on this specialisation from
              elsewhere (its pick lives on the Features tab): a note only. --}}
        {{#if specs.open.specNodeDiscount}}
        <div class="rs-learn-spec-picks">
          <div class="rs-learn-discount-pick">
            <b>−{{specs.open.specNodeDiscount.amount}} {{specs.open.specNodeDiscount.currency}}</b>
            <span class="rs-learn-discount-pick-name">{{specs.open.specNodeDiscount.text}}</span>
          </div>
        </div>
        {{/if}}
        {{!-- The picks of the owned perks that make one track copy another's
              rank (Hoplite: Swords, Axes or Blunt follow Polearms), under the
              star sign they belong to. --}}
        {{#if specs.open.mirrorPicks.length}}
        <div class="rs-learn-spec-picks">
          {{#each specs.open.mirrorPicks}}
          <div class="rs-learn-discount-pick {{#unless this.skill}}is-unpicked{{/unless}}">
            <b>{{this.badge}}</b>
            <span class="rs-learn-discount-pick-name">{{this.label}}</span>
            <select data-mirror-source="{{this.id}}" aria-label="{{this.label}}"
                    {{#unless @root.editable}}disabled{{/unless}}>
              <option value="">{{this.chooseLabel}}</option>
              {{#each this.options}}
              <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
          {{/each}}
        </div>
        {{/if}}
        <p class="rs-learn-spec-hint">{{#if specs.open.owned}}{{localize "REDSTEEL.Learn.Specs.Node.hint"}}{{else}}{{localize "REDSTEEL.Learn.Specs.Node.hintNotOwned"}}{{/if}}</p>
      </div>
    </section>

    {{else if specs.picking}}
    {{!-- The picker, opened from the Learn Specialisation card. The bar: Back to
          the owned cards, then the work in progress toggle (specialisations
          whose star sign is not drawn yet stay hidden until switched on, user
          ruling; the count says how many), the GM's plain list kept for
          checking prices and requirements, and the points left. --}}
    <header class="rs-learn-features-bar rs-learn-specs-bar">
      <button type="button" class="rs-learn-feature-filter" data-action="closeSpecPicker">
        <i class="fas fa-arrow-left"></i>
        {{localize "REDSTEEL.Learn.Specs.back"}}
      </button>
      <button type="button" class="rs-learn-feature-filter {{#if specs.showWip}}active{{/if}}"
              aria-pressed="{{#if specs.showWip}}true{{else}}false{{/if}}"
              data-action="toggleSpecWip">
        <i class="fas fa-hammer"></i>
        {{localize "REDSTEEL.Learn.Specs.showWip"}}
        <span class="rs-learn-filter-count" {{#unless specs.wipCount}}hidden{{/unless}}>{{specs.wipCount}}</span>
      </button>
      {{#if isGM}}
      <button type="button" class="rs-learn-feature-filter" data-action="toggleSpecView">
        {{#if specs.listView}}
        <i class="fas fa-grip"></i>
        {{localize "REDSTEEL.Learn.Specs.cardView"}}
        {{else}}
        <i class="fas fa-list"></i>
        {{localize "REDSTEEL.Learn.Specs.listView"}}
        {{/if}}
      </button>
      {{!-- SPEC ICON EDITOR (temporary): copy the chosen icons as code. --}}
      <button type="button" class="rs-learn-feature-filter" data-action="copySpecIcons">
        <i class="fas fa-copy"></i>
        {{localize "REDSTEEL.Learn.Specs.IconEdit.copy"}}
      </button>
      {{/if}}
      {{> rsSpecPoints}}
    </header>

    {{#if specs.nothingToLearn}}
    <p class="rs-learn-empty">{{localize "REDSTEEL.Learn.Specs.nothingToLearn"}}</p>

    {{else if specs.listView}}
    <div class="rs-learn-spec-columns">
    {{#each specs.groups as |group|}}
    <section class="rs-learn-spec-group is-{{group.id}}">
      <h3 class="rs-learn-spec-group-title">
        <span>{{group.label}}</span>
        {{#if group.capLabel}}<em class="{{#if group.overCap}}is-over{{/if}}">{{group.capLabel}}</em>{{/if}}
      </h3>
      {{#each group.rows as |spec|}}
      <div class="rs-learn-spec state-{{spec.state}}" data-action="openSpec" data-spec="{{spec.id}}">
        <div class="rs-learn-node state-{{spec.nodeState}} {{#if spec.owned}}is-owned{{/if}}"
             {{#if spec.canBuy}}data-action="buySpec" data-spec="{{spec.id}}"{{/if}}
             {{#if spec.refundable}}data-action="refundSpec" data-spec="{{spec.id}}" data-tooltip="{{localize "REDSTEEL.Learn.Specs.refundTip"}}"{{/if}}
             {{#if spec.refundBlocked}}data-tooltip="{{localize "REDSTEEL.Learn.Specs.refundBlocked"}}"{{/if}}
             {{#if spec.reasons.length}}data-tooltip="<strong>{{spec.reasonsTitle}}</strong>{{#each spec.reasons}}<br>{{this}}{{/each}}" data-tooltip-direction="UP"{{/if}}>
          <span class="rs-learn-diamond"></span>
          {{#if spec.showLock}}<i class="fas fa-lock rs-learn-lock"></i>{{/if}}
        </div>
        <span class="rs-learn-spec-name">
          <span>{{spec.label}} <i class="fas fa-angle-right"></i></span>
          {{#if spec.nodeSummary}}<em>{{spec.nodeSummary}}</em>{{/if}}
        </span>
        <span class="rs-learn-feature-reqs">
          {{#each spec.reqChips}}
          {{#if this.teacher}}
          <a class="rs-learn-teacher {{this.cls}}"
             {{#if @root.isGM}}data-action="toggleSpecTeacher" data-spec="{{this.specId}}"{{/if}}
             data-tooltip="{{this.tooltip}}">
            <i class="fas fa-graduation-cap"></i><b>{{this.roman}}</b>
          </a>
          {{else}}
          <span class="rs-learn-req {{this.cls}}"
                {{#if this.tooltip}}data-tooltip="{{this.tooltip}}"{{/if}}>{{this.text}}</span>
          {{/if}}
          {{/each}}
        </span>
        <b class="rs-learn-feature-cost">{{spec.costLabel}}</b>
      </div>
      {{/each}}
    </section>
    {{/each}}
    </div>

    {{else}}
    {{!-- The cards (user ruling): what players see. One stone plate, Combat
          then Support, each specialisation a card with its token, its name, a
          short description (or "Work in progress" until its star sign is
          drawn), and along the foot the buy diamond and the price. The card
          opens the star sign, where the requirements are spelled out; a
          locked diamond lists what is missing on hover. --}}
    <div class="rs-learn-spec-gallery">
      {{#each specs.groups as |group|}}
      <section class="rs-learn-spec-gallery-group is-{{group.id}}">
        <h3 class="rs-learn-spec-group-title">
          <span>{{group.label}}</span>
          {{#if group.capLabel}}<em class="{{#if group.overCap}}is-over{{/if}}">{{group.capLabel}}</em>{{/if}}
        </h3>
        <div class="rs-learn-spec-cards">
          {{#each group.rows as |spec|}}
          {{> rsSpecCard spec=spec}}
          {{/each}}
        </div>
      </section>
      {{/each}}
    </div>
    {{/if}}

    {{else}}
    {{!-- The main view: the bar holds only the points left, then the owned
          cards, Combat before Support, and the Learn Specialisation card that
          opens the picker. It shows for everyone: browsing is harmless, and
          the buy diamonds are gated by ownership. The Learn card goes once no
          point is left to spend. --}}
    <header class="rs-learn-features-bar rs-learn-specs-bar">
      {{> rsSpecPoints}}
    </header>

    <div class="rs-learn-spec-gallery is-owned-view">
      <div class="rs-learn-spec-cards">
        {{#each specs.ownedCards as |spec|}}
        {{> rsSpecCard spec=spec}}
        {{/each}}
        {{#if specs.canLearn}}
        <div class="rs-learn-spec-card is-learn" role="button" data-action="openSpecPicker">
          <div class="rs-learn-spec-token is-plus"><i class="fas fa-plus"></i></div>
          <div class="rs-learn-spec-card-name">{{localize "REDSTEEL.Learn.Specs.learnSpec"}}</div>
        </div>
        {{/if}}
      </div>
    </div>
    {{/if}}

  </div>

  {{else}}
  <p class="rs-learn-empty">{{localize "REDSTEEL.Learn.notBuilt"}}</p>
  {{/if}}

</div>
