<section
  class="tab skills-subtab combat {{#if (eq activeSkillsSubtab 'combat')}}active{{/if}}"
  data-group="skills-subtabs"
  data-tab="combat"
>
  <section class="skills-container skills-combat-container">
    <div class="skills-column">
      <h5>Combat <span>Rank</span></h5>
      {{!-- Show only ranks for these combat entries: Combat, Archery, Channeling, Ranger --}}
      {{#with (lookup system.combatSkills 'combat') as |skill|}}
        {{#if skill.visible}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="combat" data-tt-kind="skill" data-tt-id="combat">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.combat.label'}}
          </label>
          {{#if @root.skillsEditMode}}
          <div class="skill-rank-editor">
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.combatSkills.combat.value" data-delta="-1" data-min="0" data-max="{{skillRankMax skill}}">-</button>
            <span class="skill-rank-progress">{{skill.value}} / {{skillRankMax skill}}</span>
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.combatSkills.combat.value" data-delta="1" data-min="0" data-max="{{skillRankMax skill}}">+</button>
          </div>
          {{else}}
          <span class="skill-rank-label">{{romanRank skill.value}}</span>
          {{/if}}
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'archery') as |skill|}}
        {{#if skill.visible}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="archery" data-tt-kind="skill" data-tt-id="archery">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.archery.label'}}
          </label>
          {{#if @root.skillsEditMode}}
          <div class="skill-rank-editor">
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.combatSkills.archery.value" data-delta="-1" data-min="0" data-max="{{skillRankMax skill}}">-</button>
            <span class="skill-rank-progress">{{skill.value}} / {{skillRankMax skill}}</span>
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.combatSkills.archery.value" data-delta="1" data-min="0" data-max="{{skillRankMax skill}}">+</button>
          </div>
          {{else}}
          <span class="skill-rank-label">{{romanRank skill.value}}</span>
          {{/if}}
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'channeling') as |skill|}}
        {{#if skill.visible}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="channeling" data-tt-kind="skill" data-tt-id="channeling">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.channeling.label'}}
          </label>
          {{#if @root.skillsEditMode}}
          <div class="skill-rank-editor">
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.combatSkills.channeling.value" data-delta="-1" data-min="0" data-max="10">-</button>
            <span class="skill-rank-progress">{{skill.value}} / 10</span>
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.combatSkills.channeling.value" data-delta="1" data-min="0" data-max="10">+</button>
          </div>
          {{else}}
          <span class="skill-rank-label">{{romanRank skill.value}}</span>
          {{/if}}
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'bloodManipulation') as |skill|}}
        {{#if (or skill.visible (gt skill.value 0))}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="bloodManipulation" data-tt-kind="skill" data-tt-id="bloodManipulation">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.bloodManipulation.label'}}
          </label>
          {{#if @root.skillsEditMode}}
          <div class="skill-rank-editor">
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.combatSkills.bloodManipulation.value" data-delta="-1" data-min="0" data-max="10">-</button>
            <span class="skill-rank-progress">{{skill.value}} / 10</span>
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.combatSkills.bloodManipulation.value" data-delta="1" data-min="0" data-max="10">+</button>
          </div>
          {{else}}
          <span class="skill-rank-label">{{romanRank skill.value}}</span>
          {{/if}}
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'ranger') as |skill|}}
        {{#if skill.visible}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="ranger" data-tt-kind="skill" data-tt-id="ranger">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.ranger.label'}}
          </label>
          {{#if @root.skillsEditMode}}
          <div class="skill-rank-editor">
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.combatSkills.ranger.value" data-delta="-1" data-min="0" data-max="10">-</button>
            <span class="skill-rank-progress">{{skill.value}} / 10</span>
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.combatSkills.ranger.value" data-delta="1" data-min="0" data-max="10">+</button>
          </div>
          {{else}}
          <span class="skill-rank-label">{{romanRank skill.value}}</span>
          {{/if}}
        </div>
        {{/if}}
      {{/with}}

      {{!-- Weapon Skills, Doctrines, and Schools in left column --}}
      {{#if (hasVisibleEntries system.weaponSkills)}}
      <h5>Weapon Skills <span>Rank</span></h5>
      {{#each system.weaponSkills as |skill key|}}
        {{#if skill.visible}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="{{key}}" data-tt-kind="skill" data-tt-id="{{key}}">
            {{localize (concat 'REDSTEEL.Actor.Character.weaponSkills.' key '.label')}}
          </label>
          {{#if @root.skillsEditMode}}
          <div class="skill-rank-editor">
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.weaponSkills.{{key}}.value" data-delta="-1" data-min="0" data-max="{{skillRankMax skill}}">-</button>
            <span class="skill-rank-progress">{{skill.value}} / {{skillRankMax skill}}</span>
            <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.weaponSkills.{{key}}.value" data-delta="1" data-min="0" data-max="{{skillRankMax skill}}">+</button>
          </div>
          {{else}}
          <span class="skill-rank-label">{{romanRank skill.value}}</span>
          {{/if}}
        </div>
        {{/if}}
      {{/each}}
      {{/if}}

      {{#if (hasVisibleEntries system.doctrines)}}
      <h5>Doctrines <span>Rank</span></h5>
      {{#each system.doctrines as |skill key|}}
          {{#if skill.visible}}
          <div class="skill-entry flexrow">
            <label class="skill-label flexlarge align-left skill-name" data-label="{{key}}" data-tt-kind="skill" data-tt-id="{{key}}">
              {{localize (concat 'REDSTEEL.Actor.Character.doctrines.' key '.label')}}
            </label>
            {{#if @root.skillsEditMode}}
            <div class="skill-rank-editor">
              <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.doctrines.{{key}}.value" data-delta="-1" data-min="0" data-max="{{skillRankMax skill}}">-</button>
              <span class="skill-rank-progress">{{skill.value}} / {{skillRankMax skill}}</span>
              <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.doctrines.{{key}}.value" data-delta="1" data-min="0" data-max="{{skillRankMax skill}}">+</button>
            </div>
            {{else}}
            <span class="skill-rank-label">{{romanRank skill.value}}</span>
            {{/if}}
          </div>
          {{/if}}
      {{/each}}
      {{/if}}

      {{#if (hasVisibleEntries system.schools)}}
      <h5>Schools <span>Rank</span></h5>
      {{#each system.schools as |skill key|}}
          {{!-- Blood is no longer a progressable school: its progression comes
                from the Blood School specialisation, so it is excluded here. --}}
          {{#if (and skill.visible (not (eq key "blood")))}}
          <div class="skill-entry flexrow">
            <label class="skill-label flexlarge align-left skill-name" data-label="{{key}}" data-tt-kind="skill" data-tt-id="{{key}}">
              {{localize (concat 'REDSTEEL.Actor.Character.schools.' key '.label')}}
            </label>
            {{#if @root.skillsEditMode}}
            <div class="skill-rank-editor">
              <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.schools.{{key}}.value" data-delta="-1" data-min="0" data-max="{{skillRankMax skill}}">-</button>
              <span class="skill-rank-progress">{{skill.value}} / {{skillRankMax skill}}</span>
              <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.schools.{{key}}.value" data-delta="1" data-min="0" data-max="{{skillRankMax skill}}">+</button>
            </div>
            {{else}}
            <span class="skill-rank-label">{{romanRank skill.value}}</span>
            {{/if}}
          </div>
          {{/if}}
      {{/each}}
      {{/if}}
    </div>

    <div class="skills-column">
      <h5>Statistics <span>Rating</span></h5>
      {{#with (lookup system.combatSkills 'throwing') as |skill|}}
        {{#if skill}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="throwing" data-tt-kind="skill" data-tt-id="throwing">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.throwing.label'}}
          </label>
          <input type="text" class="skill-rating" data-dtype="Number" value="{{combatSkillRating skill 'throwing'}}" readonly />
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'meleeDefense') as |skill|}}
        {{#if skill}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="meleeDefense" data-tt-kind="skill" data-tt-id="meleeDefense">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.meleeDefense.label'}}
          </label>
          <input type="text" class="skill-rating" data-dtype="Number" value="{{combatSkillRating skill 'meleeDefense'}}" readonly />
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'rangedDefense') as |skill|}}
        {{#if skill}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="rangedDefense" data-tt-kind="skill" data-tt-id="rangedDefense">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.rangedDefense.label'}}
          </label>
          <input type="text" class="skill-rating" data-dtype="Number" value="{{combatSkillRating skill 'rangedDefense'}}" readonly />
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'dodge') as |skill|}}
        {{#if skill}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="dodge" data-tt-kind="skill" data-tt-id="dodge">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.dodge.label'}}
          </label>
          <input type="text" class="skill-rating" data-dtype="Number" value="{{combatSkillRating skill 'dodge'}}" readonly />
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'combat') as |skill|}}
        {{#if skill}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="combat-rating" data-tt-kind="skill" data-tt-id="combat">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.combat.label'}}
          </label>
          <input type="text" class="skill-rating" data-dtype="Number" value="{{combatSkillRating skill 'combat'}}" readonly />
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'archery') as |skill|}}
        {{#if skill}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="archery-rating" data-tt-kind="skill" data-tt-id="archery">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.archery.label'}}
          </label>
          <input type="text" class="skill-rating" data-dtype="Number" value="{{combatSkillRating skill 'archery'}}" readonly />
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'channeling') as |skill|}}
        {{#if (or skill.visible (gt skill.value 0))}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="channeling-rating" data-tt-kind="skill" data-tt-id="channeling">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.channeling.label'}}
          </label>
          <input type="text" class="skill-rating" data-dtype="Number" value="{{combatSkillRating skill 'channeling'}}" readonly />
        </div>
        {{/if}}
      {{/with}}
      {{#with (lookup system.combatSkills 'bloodManipulation') as |skill|}}
        {{#if (or skill.visible (gt skill.value 0))}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="bloodManipulation-rating" data-tt-kind="skill" data-tt-id="bloodManipulation">
            {{localize 'REDSTEEL.Actor.Character.combatSkills.bloodManipulation.label'}}
          </label>
          <input type="text" class="skill-rating" data-dtype="Number" value="{{combatSkillRating skill 'bloodManipulation'}}" readonly />
        </div>
        {{/if}}
      {{/with}}

      {{!-- Spell Power per school, for schools with at least one level, plus
            Blood when its specialisation is active (Blood has no school rank). --}}
      {{#if (or (hasLeveledEntries system.schools) system.specialisations.bloodSchool.active)}}
      <h5>{{localize "REDSTEEL.Actor.Character.schools.spellPower.label"}} <span>Rating</span></h5>
      {{#each system.schools as |school key|}}
        {{#if (or (gt school.value 0) (and (eq key "blood") @root.system.specialisations.bloodSchool.active))}}
        <div class="skill-entry flexrow">
          <label class="skill-label flexlarge align-left skill-name" data-label="{{key}}-spellpower" data-tt-kind="skill" data-tt-id="{{key}}">
            {{localize (concat 'REDSTEEL.Actor.Character.schools.' key '.label')}}
          </label>
          <input type="text" class="skill-rating" data-dtype="Number" value="{{school.spellPower}}" readonly />
        </div>
        {{/if}}
      {{/each}}
      {{/if}}
    </div>
  </section>
</section>
</section>
  </div>
</section>
