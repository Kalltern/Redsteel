<section
  class="tab skills {{tab.cssClass}}"
  data-group="primary"
  data-tab="skills"
>
<div class="scrollable-tab">

<section class="skills-box">
<div class="skills-toolbar-row">

  <nav class="tabs skills-subtabs" data-group="skills-subtabs" data-action="tab">

    <a
      class="item subtab-link {{#if (or (eq activeSkillsSubtab 'general') (not activeSkillsSubtab))}}active{{/if}}"
      data-group="skills-subtabs"
      data-tab="general"
    >
      {{localize "REDSTEEL.Actor.Character.Sections.General"}}
    </a>

    {{#if @root.showSkillsEdit}}
    <button
      type="button"
      class="skills-edit-toggle {{#if @root.skillsEditMode}}active{{/if}}"
      data-action="toggleSkillsEdit"
      aria-pressed="{{#if @root.skillsEditMode}}true{{else}}false{{/if}}"
    >
      <i class="fas fa-pen-to-square"></i>
      {{#if @root.skillsEditMode}}{{localize "REDSTEEL.Actor.SheetConfig.SkillsEditDone"}}{{/if}}
    </button>
    {{/if}}

    {{#if @root.editable}}
    <button type="button" class="learn-open" data-action="learn"><i class="fas fa-graduation-cap"></i> {{localize "REDSTEEL.Learn.open"}}</button>
    {{/if}}

    <a
      class="item subtab-link {{#if (eq activeSkillsSubtab 'combat')}}active{{/if}}"
      data-group="skills-subtabs"
      data-tab="combat"
    >
      {{localize "REDSTEEL.Actor.Character.Sections.Combat"}}
    </a>

  </nav>

</div>

<section
  class="tab skills-subtab general {{#if (or (eq activeSkillsSubtab 'general') (not activeSkillsSubtab))}}active{{/if}}"
  data-group="skills-subtabs"
  data-tab="general"
>

  <section class="skills-container ">
    <div class="skills-column">
      {{#if (hasVisibleSkillsOfId system.skills 0)}}
      <div class="skill-section attribute-str">
        <h5>{{localize "REDSTEEL.Actor.Character.Attribute.Str.long"}}</h5>
      {{#each orderedSkills as |skill key|}}
        {{#if (eq skill.id 0)}}
        <div class="skill-toggle-wrapper{{#unless skill.visible}} is-hidden{{/unless}}">
          <label class="toggle-label hidden">
            <input
              type="checkbox"
              class="toggle-skill-visibility"
              data-skill="{{key}}"
              {{#if skill.visible}}checked{{/if}}>
            {{key}}
          </label>
          <div class="skill-entry flexrow {{#unless skill.visible}}hidden-skill{{/unless}}">
            <label
              class="skill-label rollable flexlarge align-left skill-name"
              data-action="roll"
              data-roll="{{skill.rating}}-1d100"
              data-roll-type="skill"
              data-label="{{key}}" data-tt-kind="skill" data-tt-id="{{key}}"
            >
              {{localize (concat 'REDSTEEL.Actor.Character.skills.' key '.label')}}
            </label>
            {{#if @root.skillsEditMode}}
            <div class="skill-rank-editor">
              <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.skills.{{key}}.value" data-delta="-1" data-min="0" data-max="{{skillRankMax skill}}">-</button>
              <span class="skill-rank-progress">{{skill.value}} / {{skillRankMax skill}}</span>
              <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.skills.{{key}}.value" data-delta="1" data-min="0" data-max="{{skillRankMax skill}}">+</button>
            </div>
            {{/if}}
            <input
              type="text"
              class="skill-rating"
              data-dtype="Number"
              value="{{skill.rating}}"
              readonly
            />
          </div>
        </div>
        {{/if}}
        {{#if (eq key "athletics")}}
        <div class="skill-toggle-wrapper subskill-wrapper{{#unless skill.visible}} is-hidden{{/unless}}">
          <label class="toggle-label hidden">
            <input
              type="checkbox"
              class="toggle-skill-visibility"
              data-skill="{{key}}"
              {{#if skill.visible}}checked{{/if}}>
            {{key}}
          </label>
          <div class="skill-entry flexrow subskill {{#unless skill.visible}}hidden-skill{{/unless}}">
                    <label
            class="skill-label rollable flexlarge align-left skill-name"
            data-action="roll"
            data-roll="{{@root.system.skills.athletics.swimming}}-1d100"
            data-roll-type="skill"
            data-label="blend" data-tt-kind="skill" data-tt-id="swimming"
          >
                      {{localize "REDSTEEL.Actor.Character.skills.swimming.label"}}
          </label>
          <input
            type="text"
            class="skill-rating"
            data-dtype="Number"
            value="{{@root.system.skills.athletics.swimming}}"
            readonly
          />

          </div>
        </div>
        {{/if}}
      {{/each}}
      </div>
      {{/if}}

      {{#if (hasVisibleSkillsOfId system.skills 1)}}
      <div class="skill-section attribute-dex">
        <h5>{{localize "REDSTEEL.Actor.Character.Attribute.Dex.long"}}
    </h5>
        
      {{/if}}
      {{#each orderedSkills as |skill key|}}
        {{#if (eq skill.id 1)}}
