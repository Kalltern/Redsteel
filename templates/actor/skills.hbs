              {{#if @root.skillsEditMode}}
              <div class="skill-rank-editor">
                <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.skills.{{key}}.value" data-delta="-1" data-min="0" data-max="{{skillRankMax skill}}">-</button>
                <span class="skill-rank-progress">{{skill.value}} / {{skillRankMax skill}}</span>
                <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.skills.{{key}}.value" data-delta="1" data-min="0" data-max="{{skillRankMax skill}}">+</button>
              </div>
              {{/if}}
              <input
                type="text"
                class="skill-rating"
                value="{{skill.rating}}"
                readonly
              />
            </div>
          </div>
          {{/if}}
        {{/each}}
        {{#if @root.system.skills.acting.visible}}
        <div class="skill-entry flexrow subskill">

          <label
            class="skill-label rollable flexlarge align-left skill-name"
            data-action="roll"
            data-roll="{{@root.system.skills.acting.blend}}-1d100"
            data-roll-type="skill"
            data-label="blend" data-tt-kind="skill" data-tt-id="blend"
          >
          
            {{localize "REDSTEEL.Actor.Character.skills.blend.label"}}
          </label>
          <input
            type="text"
            class="skill-rating"
            data-dtype="Number"
            value="{{@root.system.skills.acting.blend}}"
            readonly
          />
        </div>
        {{/if}}
      </div>
      {{/if}}

{{#if (hasVisibleSkillsOfId system.skills 6)}}
<div class="skill-section attribute-per">
  <h5>{{localize "REDSTEEL.Actor.Character.Attribute.Per.long"}}
  </h5>

  {{#each orderedSkills as |skill key|}}
    {{#if (eq skill.id 6)}}
    <div class="skill-toggle-wrapper{{#unless skill.visible}} is-hidden{{/unless}}">
      <label class="toggle-label hidden">
        <input
          type="checkbox"
          class="toggle-skill-visibility"
          data-skill="{{key}}"
          {{#if skill.visible}}checked{{/if}}>
        {{key}}
      </label>

      <div class="skill-entry flexrow {{#unless skill.visible}}hidden-skill{{/unless}}">
        <label
          class="skill-label rollable flexlarge align-left skill-name"
          data-action="roll"
          data-roll="{{skill.rating}}-1d100"
          data-roll-type="skill"
          data-label="{{key}}" data-tt-kind="skill" data-tt-id="{{key}}"
        >
          {{localize (concat 'REDSTEEL.Actor.Character.skills.' key '.label')}}
        </label>

        {{#if @root.skillsEditMode}}
        <div class="skill-rank-editor">
          <button
            type="button"
            class="skill-rank-button"
            data-action="adjustActorNumber"
            data-path="system.skills.{{key}}.value"
            data-delta="-1"
            data-min="0"
            data-max="{{skillRankMax skill}}">
            -
          </button>

          <span class="skill-rank-progress">
            {{skill.value}} / {{skillRankMax skill}}
          </span>

          <button
            type="button"
            class="skill-rank-button"
            data-action="adjustActorNumber"
            data-path="system.skills.{{key}}.value"
            data-delta="1"
            data-min="0"
            data-max="{{skillRankMax skill}}">
            +
          </button>
        </div>
        {{/if}}

        <input
          type="text"
          class="skill-rating"
          data-dtype="Number"
          value="{{skill.rating}}"
          readonly
        />
      </div>
    </div>
    {{/if}}
  {{/each}}
</div>
{{/if}}

      {{#if (hasVisibleSkillsOfId system.skills 4)}}
