              {{localize (concat 'REDSTEEL.Actor.Character.skills.' key '.label')}}
            </label>
            {{#if @root.skillsEditMode}}
            <div class="skill-rank-editor">
              <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.skills.{{key}}.value" data-delta="-1" data-min="0" data-max="{{skillRankMax skill}}">-</button>
              <span class="skill-rank-progress">{{skill.value}} / {{skillRankMax skill}}</span>
              <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.skills.{{key}}.value" data-delta="1" data-min="0" data-max="{{skillRankMax skill}}">+</button>
            </div>
            {{/if}}
            <input
              type="text"
              class="skill-rating"
              data-dtype="Number"
              value="{{skill.rating}}"
              readonly
            />
          </div>
        </div>
        {{/if}}
      {{/each}}
      {{#if (hasVisibleSkillsOfId system.skills 3)}}
      </div>
      {{/if}}
    </div>
    <div class="skills-column">
      {{!-- Ordered by how often players reach for them: Cha, Per, Wil, End. --}}
      {{#if (or (hasVisibleSkillsOfId system.skills 5) @root.system.skills.acting.visible)}}
      <div class="skill-section attribute-cha">
        <h5>{{localize "REDSTEEL.Actor.Character.Attribute.Cha.long"}}</h5>
        {{#each orderedSkills as |skill key|}}
          {{#if (eq skill.id 5)}}
          <div class="skill-toggle-wrapper{{#unless skill.visible}} is-hidden{{/unless}}">
            <label class="toggle-label hidden">
              <input
                type="checkbox"
                class="toggle-skill-visibility"
                data-skill="{{key}}"
