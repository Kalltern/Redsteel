              data-roll-type="skill"
              data-label="{{key}}" data-tt-kind="skill" data-tt-id="{{key}}"
            >
              {{localize (concat 'REDSTEEL.Actor.Character.skills.' key '.label')}}
            </label>
            {{#if @root.skillsEditMode}}
            <div class="skill-rank-editor">
              <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.skills.{{key}}.value" data-delta="-1" data-min="0" data-max="{{skillRankMax skill}}">-</button>
              <span class="skill-rank-progress">{{skill.value}} / {{skillRankMax skill}}</span>
              <button type="button" class="skill-rank-button" data-action="adjustActorNumber" data-path="system.skills.{{key}}.value" data-delta="1" data-min="0" data-max="{{skillRankMax skill}}">+</button>
            </div>
            {{/if}}
            <input
              type="text"
              class="skill-rating"
              data-dtype="Number"
              value="{{skill.rating}}"
              readonly
            />
          </div>
        </div>
          {{/if}}
        {{/each}}
      {{#if (hasVisibleSkillsOfId system.skills 1)}}
      </div>
      {{/if}}

      {{#if (hasVisibleSkillsOfId system.skills 3)}}
      <div class="skill-section attribute-int">
        <h5>{{localize "REDSTEEL.Actor.Character.Attribute.Int.long"}}</h5>
      {{/if}}
      {{#each orderedSkills as |skill key|}}
        {{#if (eq skill.id 3)}}
