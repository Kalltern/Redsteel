<section
  class="tab specialisations {{tab.cssClass}}"
  data-group="primary"
  data-tab="specialisations"
>
  <div class="specialisations-box">

    {{#if npcSpecEditor}}
      <!-- NPC only, GM only: turn whole specialisations on/off -->
      <div class="npc-spec-picker">
        <h3 class="npc-spec-picker-title">
          {{localize "REDSTEEL.Actor.Specialisations.npcPickerTitle"}}
        </h3>
        <p class="npc-spec-picker-hint">
          {{localize "REDSTEEL.Actor.Specialisations.npcPickerHint"}}
        </p>
        <div class="npc-spec-picker-grid">
          {{#each npcSpecList as |spec|}}
            <a
              class="npc-spec-option {{#if spec.active}}active{{/if}}"
              data-action="toggleNpcSpec"
              data-spec="{{spec.id}}"
              role="checkbox"
              aria-checked="{{#if spec.active}}true{{else}}false{{/if}}"
            >
              <span class="npc-spec-box"></span>
              <span class="npc-spec-label">{{spec.label}}</span>
            </a>
          {{/each}}
        </div>
      </div>
    {{/if}}

    <!-- Sub-tab navigation: one entry per active specialisation -->
    <nav class="tabs" data-group="specialisations-subtabs" data-action="tab">
      {{#each specTrees as |tree index|}}
        <a
          class="item
            {{#if (or
              (eq tree.id ../activeSpecSubtab)
              (and (eq index 0) (not ../activeSpecSubtab))
            )}}active{{/if}}"
          data-group="specialisations-subtabs"
          data-tab="{{tree.id}}"
        >
          {{localize tree.label}}
        </a>
      {{/each}}
    </nav>

    {{#each specTrees as |tree index|}}
      <section
        class="tab spec-tree-tab
          {{#if (or
            (eq tree.id ../activeSpecSubtab)
            (and (eq index 0) (not ../activeSpecSubtab))
          )}}active{{/if}}"
        data-group="specialisations-subtabs"
        data-tab="{{tree.id}}"
      >
        <div class="spec-tree-wrap">
          <div
            class="spec-tree{{#if tree.constellation}} constellation constellation-{{tree.id}}{{/if}}"
            {{#unless tree.constellation}}style="width: {{tree.width}}px; height: {{tree.height}}px;"{{/unless}}
          >
            {{#if tree.constellation}}
              <svg
                class="spec-tree-links"
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
                width="100%"
                height="100%"
              >
                {{#each tree.links as |link|}}
                  <line
                    class="spec-link {{#if link.active}}active{{/if}}"
                    x1="{{link.x1}}" y1="{{link.y1}}"
                    x2="{{link.x2}}" y2="{{link.y2}}"
                  />
                {{/each}}
              </svg>
            {{else}}
              <svg
                class="spec-tree-links"
                width="{{tree.width}}"
                height="{{tree.height}}"
              >
                {{#each tree.links as |link|}}
                  <line
                    class="spec-link {{#if link.active}}active{{/if}}"
                    x1="{{link.x1}}" y1="{{link.y1}}"
                    x2="{{link.x2}}" y2="{{link.y2}}"
                  />
                {{/each}}
              </svg>
            {{/if}}

            {{#each tree.nodes as |node|}}
              <a
                class="spec-node {{node.state}} {{#if node.automated}}automated{{/if}}"
                style="left: {{node.x}}{{#if tree.constellation}}%{{else}}px{{/if}}; top: {{node.y}}{{#if tree.constellation}}%{{else}}px{{/if}};"
                data-action="toggleSpecNode"
                data-spec="{{tree.id}}"
                data-node="{{node.id}}"
                data-tt-kind="specNode"
                data-tt-id="{{node.id}}"
                data-tt-spec="{{tree.id}}"
              >
                {{#if node.icon}}
                  <img src="{{node.icon}}" alt="" />
                {{/if}}
                <span class="spec-node-label">{{localize node.label}}</span>
              </a>
            {{/each}}
          </div>
        </div>
      </section>
    {{/each}}
  </div>
</section>
