<section
  class="tab spells {{tab.cssClass}}"
  data-group="primary"
  data-tab="spells"
>
  <div class="spells-box">
  {{! Spell Power: characters see it under Statistics on the Combat sub-tab;
      NPCs keep it here since they have no skills tab }}
  {{#if (eq actor.type "npc")}}
  <section class="spell-power-panel">
  <h2 class="flex-group-center">
    {{localize "REDSTEEL.Actor.Character.schools.spellPower.label"}}
  </h2>

  <div class="grid grid-9col spells">
    {{#each system.schools as |school key|}}
      <div class="grid-span-1-spell">
        <label class="resource-label">
          {{localize (concat "REDSTEEL.Actor.Character.schools." key ".label")}}
        </label>
        <input
          class="spell-value"
          type="text"
          name="system.schools.{{key}}.spellPower"
          value="{{school.spellPower}}"
          data-dtype="Number"
        />
      </div>
    {{/each}}
  </div>
  </section>
  {{/if}}

  <!-- Sub-tab navigation -->
<nav class="tabs" data-group="spells-subtabs" data-action="tab">
  {{#each spellSchools as |group index|}}
    <a
      class="item
        {{#if (or
          (eq group.school ../activeSpellSubtab)
          (and (eq index 0) (not ../activeSpellSubtab))
        )}}active{{/if}}"
      data-group="spells-subtabs"
      data-tab="{{group.school}}"
    >
      {{group.label}}
    </a>
  {{/each}}
</nav>


{{#each spellSchools as |group index|}}
<section
  class="tab spells-subtab {{group.school}}
    {{#if (or
      (eq group.school ../activeSpellSubtab)
      (and (eq index 0) (not ../activeSpellSubtab))
    )}}active{{/if}}"
  data-group="spells-subtabs"
  data-tab="{{group.school}}"
>

    <nav class="rank-filter">
      {{#each group.rankGroups as |rg|}}
        <a class="rank-filter-pill {{#if (eq rg.rank ../activeRank)}}active{{/if}}"
           data-action="setSpellRank" data-rank="{{rg.rank}}">{{rg.label}}</a>
      {{/each}}
    </nav>

    {{#each group.rankGroups as |rg|}}
      {{#if (eq rg.rank ../activeRank)}}
        <ul class="spell-card-grid">
          {{#each rg.cards as |card|}}
            <li class="spell-card" data-item-id="{{card.id}}" data-card-kind="spell" data-tt-kind="spellCard" data-tt-id="{{card.id}}" data-drag="true" data-document-class="Item">
              <a class="spell-card-icon rollable" data-action="roll" data-roll-type="item">
                <img src="{{card.img}}" data-item-id="{{card.id}}" width="48" height="48" />
              </a>
              <div class="spell-card-main">
                <div class="spell-card-top">
                  <span class="spell-card-name">{{card.name}}</span>
                  <span class="spell-card-controls">
                    <a class="item-control item-hotbar" data-action="addToHotbar" title="{{localize 'REDSTEEL.UI.addToHotbar'}}"><i class="fas fa-star"></i></a>
                    <a class="item-control item-edit" data-action="viewDoc" title="{{localize 'DOCUMENT.Update' type='spell'}}"><i class="fas fa-edit"></i></a>
                    {{#if @root.editable}}
                      <a class="item-control item-delete" data-action="deleteDoc" title="{{localize 'DOCUMENT.Delete' type='spell'}}"><i class="fas fa-trash"></i></a>
                    {{/if}}
                  </span>
                </div>
                <div class="spell-card-pills">
                  {{#each card.pills as |pill|}}
                    <span class="spell-pill" data-pill="{{pill.key}}" data-positive="{{pill.positive}}">
                      <span class="spell-pill-label">{{pill.label}}</span>
                      <span class="spell-pill-value">{{pill.value}}</span>
                    </span>
                  {{/each}}
                </div>
              </div>
            </li>
          {{/each}}
        </ul>
      {{/if}}
    {{/each}}
  </section>
{{/each}}
  </div>
</section>
