<section
  class="tab config {{tab.cssClass}}"
  data-group="primary"
  data-tab="config"
  >
  <div class="config-box">
   <div class="attributes flexrow configstats">
      {{#each system.attributes as |attribute key|}}
        <div class="attribute flexcolumn flex-group-center">
          <label
            class="resource-label rollable"
            data-action="roll"
            data-roll="(@attributes.{{key}}.mod)-1d100"
            data-roll-type="attribute"
            data-label="{{localize (lookup @root.config.attributes key)}}"
          >
            {{localize (lookup @root.config.attributes key)}}
          </label>
          <input
            type="text"
            name="system.attributes.{{key}}.value"
            value="{{attribute.value}}"
            class="attribute-score"
            data-dtype="Number"
               />
        </div>
      {{/each}}
    </div>
    <div class="attributes flexrow configstats">
      {{#each system.secondaryAttributes as |attribute key|}}
        <div class="attribute flexcolumn flex-group-center">
          <label
            class="resource-label rollable"
            data-action="roll"
            data-roll="(@secondaryAttributes.{{key}}.mod)-1d100"
            data-label="{{localize
              (lookup @root.config.secondaryAttributes key)
            }}"
          >
            {{localize (lookup @root.config.secondaryAttributes key)}}
          </label>
          <input
            type="text"
            name="system.secondaryAttributes.{{key}}.value"
            value="{{attribute.value}}"
            class="attribute-score"
            data-dtype="Number"
          />

        </div>
      {{/each}}
    </div>
<div class="grid grid-10col configstats">
      <div class="grid-span-4"></div>
    <div class="grid-span-1">
        <label class="resource-label">{{localize
            "Endurance Rank"
          }}</label>
        <input
          type="text"
          name="system.attributes.end.rank"
          value="{{system.attributes.end.rank}}"
          data-dtype="Number"
          data-class="stat-input"
        />
  </div>
  <div class="grid-span-1">
        <label class="resource-label">{{localize
            "Treated wounds"
          }}</label>
        <input
          type="number"
          min="0"
          max="{{system.stats.graveWounds.treatedMax}}"
          name="system.stats.graveWounds.treated"
          value="{{system.stats.graveWounds.treated}}"
          data-dtype="Number"
          data-class="stat-input"
        />
  </div>

</div>
{{!-- Maximum Mind. The ceiling is derived (Will + bonus − burned), so it is
      steered by these two knobs rather than typed directly. Burned points are
      the permanent loss from Blood Pact and friends; restoring one (ritual or
      potion, both resolved at the table) means lowering the counter here. --}}
<div class="grid grid-10col configstats">
      <div class="grid-span-4"></div>
  <div class="grid-span-1">
        <label class="resource-label">{{localize
            "REDSTEEL.Actor.Character.stats.mind.bonus.label"
          }}</label>
        <input
          type="number"
          name="system.stats.mind.bonus"
          value="{{system.stats.mind.bonus}}"
          data-dtype="Number"
          data-class="stat-input"
          data-tooltip="{{localize 'REDSTEEL.Actor.Character.stats.mind.bonus.hint'}}"
        />
  </div>
  <div class="grid-span-1">
        <label class="resource-label">{{localize
            "REDSTEEL.Actor.Character.stats.mind.burned.label"
          }}</label>
        <input
          type="number"
          min="0"
          name="system.stats.mind.burned"
          value="{{system.stats.mind.burned}}"
          data-dtype="Number"
          data-class="stat-input"
          data-tooltip="{{localize 'REDSTEEL.Actor.Character.stats.mind.burned.hint'}}"
        />
  </div>
  <div class="grid-span-2">
        <label class="resource-label">{{localize
            "REDSTEEL.Actor.Character.stats.mind.max.label"
          }}</label>
        <span class="resource-label">{{system.stats.mind.value}} / {{system.stats.mind.max}}</span>
  </div>

</div>
{{!-- Absorb pools. Two independent wards: physical damage can only be
      soaked by the physical pool, magical damage only by the magical one
      (see classifyDamagePacket in combatSkillBonuses.mjs). --}}
<div class="grid grid-10col configstats">
      <div class="grid-span-4"></div>
  <div class="grid-span-1">
        <label class="resource-label">{{localize
            "Temp HP (Physical)"
          }}</label>
        <input
          type="number"
          min="0"
          max="{{system.stats.temporaryHealth.max}}"
          name="system.stats.temporaryHealth.value"
          value="{{system.stats.temporaryHealth.value}}"
          data-dtype="Number"
          data-class="stat-input"
        />
  </div>
  <div class="grid-span-1">
        <label class="resource-label">{{localize
            "Temp HP (Magical)"
          }}</label>
        <input
          type="number"
          min="0"
          max="{{system.stats.temporaryHealthMagic.max}}"
          name="system.stats.temporaryHealthMagic.value"
          value="{{system.stats.temporaryHealthMagic.value}}"
          data-dtype="Number"
          data-class="stat-input"
        />
  </div>

</div>
{{!-- Shields. The pool lives on the effect (flags.redsteel.stacks), not in
      system.stats, so these cannot be declarative `name="system…"` inputs —
      they write back through the shield-* actions in actor-sheet.mjs. --}}
<div class="grid grid-10col configstats">
  <div class="grid-span-10">
    <label class="resource-label">{{localize "Shields"}}</label>
  </div>
  {{#each shields as |shield|}}
    <div class="grid-span-3">
      <label class="resource-label">
        <img src="{{shield.img}}" width="16" height="16"> {{shield.name}}
      </label>
    </div>
    <div class="grid-span-2">
      <input
        type="number"
        min="0"
        value="{{shield.value}}"
        data-dtype="Number"
        data-class="stat-input"
        data-action="shieldValue"
        data-effect-id="{{shield.id}}"
        data-tooltip="Absorb remaining (max {{shield.max}})"
      />
    </div>
    <div class="grid-span-3">
      {{#if shield.elementChoices.length}}
        <select
          data-action="shieldElement"
          data-effect-id="{{shield.id}}"
          data-tooltip="Free Action: change absorbed element (costs 3 mana, deduct manually)"
        >
          {{#each shield.elementChoices as |choice|}}
            <option value="{{choice.value}}" {{#if choice.selected}}selected{{/if}}>
              {{choice.label}}
            </option>
          {{/each}}
        </select>
      {{else}}
        <span class="resource-label">{{shield.matchClass}}</span>
      {{/if}}
    </div>
    <div class="grid-span-2">
      <a data-action="shieldRemove" data-effect-id="{{shield.id}}"
         data-tooltip="Remove shield">
        <i class="fas fa-trash"></i>
      </a>
    </div>
  {{else}}
    <div class="grid-span-7">
      <span class="resource-label">{{localize "No active shield"}}</span>
    </div>
  {{/each}}
  <div class="grid-span-3">
    <select data-action="shieldAdd" data-tooltip="Grant a shield by hand">
      <option value="">{{localize "Add shield…"}}</option>
      {{#each config.shieldEffectIds as |id|}}
        <option value="{{id}}">{{id}}</option>
      {{/each}}
    </select>
  </div>
</div>
<div class="grid grid-10col configstats">
  <div class="grid-span-10">
        <label class="resource-label">{{localize
            "REDSTEEL.Banes.TagField"
          }}</label>
        <input
          type="text"
          name="system.baneTypes"
          value="{{system.baneTypes}}"
          data-tooltip="{{localize 'REDSTEEL.Banes.TagFieldHint'}}"
        />
  </div>
</div>
<hr>
{{!--
  Shows this character's portrait in the party row on the Redsteel hotbar, even
  with nobody logged in as them. Connected players are listed automatically.
--}}
<section class="config-container rs-toggle-row">
  <label class="rs-toggle">
    <input
      type="checkbox"
      name="system.partyMember"
      {{#if system.partyMember}}checked{{/if}}
    />
    <span>{{localize "REDSTEEL.Actor.FIELDS.partyMember.label"}}</span>
  </label>
</section>
<hr>
  <section class="config-container rs-toggle-row">

{{#each system.combatSkills as |skill key|}}
        <label class="rs-toggle">
          <input
            type="checkbox"
            name="system.combatSkills.{{key}}.visible"
            data-skill="{{key}}"
            {{#if skill.visible}}checked{{/if}}>
          <span>{{key}}</span>
        </label>
{{/each}}

{{#each system.weaponSkills as |skill key|}}
        <label class="rs-toggle">
          <input
            type="checkbox"
            name="system.weaponSkills.{{key}}.visible"
            data-skill="{{key}}"
            {{#if skill.visible}}checked{{/if}}>
          <span>{{key}}</span>
        </label>
  {{/each}}

{{#each system.doctrines as |skill key|}}
        <label class="rs-toggle">
          <input
            type="checkbox"
            name="system.doctrines.{{key}}.visible"
            data-skill="{{key}}"
            {{#if skill.visible}}checked{{/if}}>
          <span>{{key}}</span>
        </label>
   {{/each}}

{{#each system.schools as |skill key|}}
      {{!-- Blood is gated by its specialisation, not a school-rank toggle. --}}
      {{#unless (eq key "blood")}}
        <label class="rs-toggle">
          <input
            type="checkbox"
            name="system.schools.{{key}}.visible"
            data-skill="{{key}}"
            {{#if skill.visible}}checked{{/if}}>
          <span>{{key}}</span>
        </label>
      {{/unless}}
  {{/each}}

{{#each system.skills as |skill key|}}
        <label class="rs-toggle">
          <input
            type="checkbox"
            name="system.skills.{{key}}.visible"
            data-skill="{{key}}"
            {{#if skill.visible}}checked{{/if}}>
          <span>{{key}}</span>
        </label>
   {{/each}}

{{#each @root.config.specialisations as |spec key|}}
        <label class="rs-toggle">
          <input
            type="checkbox"
            name="system.specialisations.{{key}}.active"
            {{#if (lookup (lookup @root.system.specialisations key) "active")}}checked{{/if}}>
          <span>{{localize spec.label}}</span>
        </label>
   {{/each}}
</section>
  <ol class="items-list">
    <li class="item flexrow items-header">
      <div class="item-name">{{localize "race"}}</div>
        </li>
 
    {{#each race as |item id|}}
      <li
        class="item flexrow"
        data-item-id="{{item._id}}"
        data-drag="true"
        data-document-class="Item"
      >
        <div class="item-name">
          <div class="item-image">
            <a class="rollable" data-roll-type="item" data-action="roll">
              <img
                src="{{item.img}}"
                title="{{item.localizedName}}"
                width="24"
                height="24"
              />
            </a>
          </div>
          <div>{{item.localizedName}}</div>
        </div>
           <div class="item-controls">
           {{#if @root.editable}}
            <a
              class="item-control item-delete"
              title="{{localize 'DOCUMENT.Delete' type="race"}}"
              data-action="deleteDoc"
            >
              <i class="fas fa-trash"></i>
            </a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>

  </div>
</section>
