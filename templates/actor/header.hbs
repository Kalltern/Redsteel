        <label class="stats-resource-label">{{localize (concat 'REDSTEEL.Actor.Character.stats.holyEnergy.value.label')}}</label>
        <div class="stat-values">
          <input
            type="text"
            class="stat-input stat-current resource holyEnergy"
            name="system.stats.holyEnergy.value"
            value="{{system.stats.holyEnergy.value}}"
            data-value="system.stats.holyEnergy.value"
          />
          <input
            type="text"
            class="stat-input stat-max resource holyEnergy"
            name="system.stats.holyEnergy.max"
            value="{{system.stats.holyEnergy.max}}"
            data-value="system.stats.holyEnergy.max"
            />
        </div>
      </div>
      {{/if}}

    </div>

          <div class="checkbox-row">
        <label class="resource-label">{{localize "REDSTEEL.Actor.NPC.FIELDS.mage.label"}}</label>
        <input type="checkbox" name="system.magicPotential" {{checked system.magicPotential}} />

        <label class="resource-label">{{localize "REDSTEEL.Actor.NPC.FIELDS.priest.label"}}</label>
        <input type="checkbox" name="system.priest" {{checked system.priest}} />
      </div>
  </div>

  <div class="header-fields">

    <div class="grid grid-2col">
      <div class="document-name grid-span-1">
        <input
          name="name"
          type="text"
          value="{{actor.name}}"
          placeholder="Name"
        />
      </div>

      <div class="grid-span-1">
        <div class="item-name">
          <input
            type="text"
            name="system.raceName"
            value="{{system.raceName}}"
            placeholder="Choose a race"
          />
        </div>
      </div>
    </div>

    <hr>

    <div class="attributes flexrow">
      {{#each system.attributes as |attribute key|}}
      <div class="attribute flexcolumn flex-group-center">
        <label
          class="resource-label rollable"
          data-action="roll"
          data-roll="(@attributes.{{key}}.mod)-1d100"
          data-roll-type="attribute"
          data-label="{{key}}"
        >
          {{localize (lookup @root.config.attributes key)}}
        </label>

        <input
          type="text"
          name="system.attributes.{{key}}.value"
          value="{{attribute.value}}"
          class="attribute-score"
          data-dtype="Number"
        />
      </div>
      {{/each}}
    </div>

    <hr>

    <div class="stats">

      <div class="stat-row">

        <div class="attribute-armor">
          <label class="resource-label armor-icon" data-tooltip="{{localize "REDSTEEL.Item.Gear.FIELDS.armor.label"}}"><i class="fa-sharp fa-regular fa-shield"></i></label>
          <input
            type="text"
            name="system.armor.natural.value"
            value="{{system.armor.natural.value}}"
            class="attribute-score"
            data-dtype="Number"
          />
          <input
            type="text"
            value="{{system.armor.total}}"
            class="attribute-total"
            data-dtype="Number"
            data-class="stat-input"
            readonly
          />
        </div>

        <div class="attribute-armor">
          <label class="resource-label armor-icon" data-tooltip="{{localize "REDSTEEL.Item.Gear.FIELDS.acid.label"}}"><i class="fa-duotone fa-light fa-flask" style="--fa-primary-color: rgb(61, 79, 34); --fa-secondary-color: rgb(80, 107, 41); --fa-secondary-opacity: 1;"></i></label>
          <input
            type="text"
            name="system.armor.acid.value"
            value="{{system.armor.acid.value}}"
            class="attribute-score"
            data-dtype="Number"
          />
          <input
            type="text"
            value="{{system.armor.acid.total}}"
            class="attribute-total"
            data-dtype="Number"
            data-class="stat-input"
            readonly
          />
        </div>

        <div class="attribute-armor">
          <label class="resource-label armor-icon" data-tooltip="{{localize "REDSTEEL.Item.Gear.FIELDS.fire.label"}}"><i class="fa-sharp fa-light fa-fire" style="color: rgb(123 83 30);"></i></label>
          <input
            type="text"
            name="system.armor.fire.value"
            value="{{system.armor.fire.value}}"
            class="attribute-score"
            data-dtype="Number"
          />
          <input
            type="text"
            value="{{system.armor.fire.total}}"
            class="attribute-total"
            data-dtype="Number"
            data-class="stat-input"
            readonly
          />
        </div>

        <div class="attribute-armor">
          <label class="resource-label armor-icon" data-tooltip="{{localize "REDSTEEL.Item.Gear.FIELDS.frost.label"}}"><i class="fa-solid fa-snowflake" style="color: rgb(46, 70, 92);"></i></label>
