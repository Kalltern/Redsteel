{{! Sheet Header }}

{{#if (eq actor.type "character")}}
<header class="sheet-header">

  <div class="profile-container">
    <img
      class="profile-img"
      src="{{actor.img}}"
      data-edit="img"
      data-action="onEditImage"
      title="{{actor.name}}"
      height="216"
      width="216"
    />

    <div class="resource-bars">

      <div class="resource-bar health">
        <div class="resource-bar-track" title="{{localize 'REDSTEEL.Actor.Character.stats.health.value.label'}}">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.health.value system.stats.health.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.health.value"
              value="{{system.stats.health.value}}"
              data-value="system.stats.health.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              value="{{system.stats.health.max}}"
              data-value="system.stats.health.max"
              readonly
            />
          </div>
        </div>
      </div>

      <div class="resource-bar stamina">
        <div class="resource-bar-track" title="{{localize 'REDSTEEL.Actor.Character.stats.stamina.value.label'}}">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.stamina.value system.stats.stamina.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.stamina.value"
              value="{{system.stats.stamina.value}}"
              data-value="system.stats.stamina.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              value="{{system.stats.stamina.max}}"
              data-value="system.stats.stamina.max"
              readonly
            />
          </div>
        </div>
      </div>

      <div class="resource-bar toxicity">
        <div class="resource-bar-track" title="{{localize 'REDSTEEL.Actor.Character.stats.toxicity.value.label'}}">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.toxicity.value system.stats.toxicity.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.toxicity.value"
              value="{{system.stats.toxicity.value}}"
              data-value="system.stats.toxicity.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              value="{{system.stats.toxicity.max}}"
              data-value="system.stats.toxicity.max"
              readonly
            />
          </div>
        </div>
      </div>

      {{#if system.magicPotential}}
      <div class="resource-bar mana">
        <div class="resource-bar-track" title="{{localize 'REDSTEEL.Actor.Character.stats.mana.value.label'}}">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.mana.value system.stats.mana.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.mana.value"
              value="{{system.stats.mana.value}}"
              data-value="system.stats.mana.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              value="{{system.stats.mana.max}}"
              data-value="system.stats.mana.max"
              readonly
            />
          </div>
        </div>
      </div>
      {{/if}}

      {{#if system.priest}}
      <div class="resource-bar holyEnergy">
        <div class="resource-bar-track" title="{{localize 'REDSTEEL.Actor.Character.stats.holyEnergy.value.label'}}">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.holyEnergy.value system.stats.holyEnergy.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.holyEnergy.value"
              value="{{system.stats.holyEnergy.value}}"
              data-value="system.stats.holyEnergy.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              value="{{system.stats.holyEnergy.max}}"
              data-value="system.stats.holyEnergy.max"
              readonly
            />
          </div>
        </div>
      </div>
      {{/if}}

      {{!-- Blood Pool: only blood mages ever use it; max is freely editable --}}
      {{#if (gt system.schools.blood.value 0)}}
      <div class="resource-bar bloodPool">
        <div class="resource-bar-track" title="{{localize 'REDSTEEL.Actor.Character.stats.bloodPool.value.label'}}">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.bloodPool.value system.stats.bloodPool.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.bloodPool.value"
              value="{{system.stats.bloodPool.value}}"
              data-value="system.stats.bloodPool.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              name="system.stats.bloodPool.max"
              value="{{system.stats.bloodPool.max}}"
              data-value="system.stats.bloodPool.max"
            />
          </div>
        </div>
      </div>
      {{/if}}

    </div>
  </div>

  <div class="header-fields actor">

    <div class="grid grid-2col char-identity">
      <div class="document-name grid-span-1">
        <input
          name="name"
          type="text"
          value="{{actor.name}}"
          placeholder="Name"
        />
      </div>

      <div class="grid-span-1">
        {{#if race.length}}
          {{#each race as |item id|}}
          <div class="item-name">
            <input type="text" value="{{item.name}}" readonly />
          </div>
          {{/each}}
        {{else}}
          <input type="text" value="" placeholder="Choose a race" readonly />
        {{/if}}
      </div>
    </div>


    {{!-- PRIMARY ATTRIBUTES (tier 1 — dominant, 24px values) --}}
    <div class="stat-section stat-section--primary">
      <div class="stat-box-grid">
        {{#each system.attributes as |attribute key|}}
        <div
          class="stat-box rollable"
          data-action="roll"
          data-roll="(@attributes.{{key}}.mod)-1d100"
          data-roll-type="attribute"
          data-label="{{key}}"
        >
          <div class="stat-box-label">{{localize (lookup @root.config.attributes key)}}</div>
          <div class="stat-box-value">{{attribute.total}}</div>
          <div class="stat-box-sub">{{numberFormat attribute.mod decimals=0}}</div>
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- SECONDARY ATTRIBUTES (tier 2 — recessive, 17px, name + value only) --}}
    <div class="stat-section stat-section--secondary">
      <div class="stat-box-grid">
        {{#each system.secondaryAttributes as |attribute key|}}
        {{#if (eq key "spd")}}
        <div class="stat-box rollable" data-action="roll" data-roll-type="secondaryAttribute" data-roll="(@secondaryAttributes.{{key}}.total)+(@secondaryAttributes.ini.total)+1d12" data-label="{{key}}">
        {{else if (eq key "lck")}}
        <div class="stat-box rollable" data-action="roll" data-roll-type="secondaryAttribute" data-roll="(@secondaryAttributes.{{key}}.total*5)+50-1d100" data-label="{{key}}">
        {{else if (eq key "res")}}
        <div class="stat-box rollable" data-action="roll" data-roll-type="secondaryAttribute" data-roll="(@secondaryAttributes.{{key}}.total*10)-1d100" data-label="{{key}}">
        {{else if (eq key "fth")}}
        <div class="stat-box rollable" data-action="roll" data-roll-type="secondaryAttribute" data-roll="(@secondaryAttributes.{{key}}.total*8)-1d100" data-label="{{key}}">
        {{else if (eq key "sin")}}
        <div class="stat-box rollable" data-action="roll" data-roll-type="secondaryAttribute" data-roll="(@secondaryAttributes.res.total*10)-(@secondaryAttributes.{{key}}.total*3)-1d100" data-label="{{key}}">
        {{else}}
        <div class="stat-box">
        {{/if}}
          <div class="stat-box-label">{{localize (lookup @root.config.secondaryAttributes key)}}</div>
          <div class="stat-box-value">{{attribute.total}}</div>
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- CONDITION (tier 3 — compact, grouped by function) --}}
    <div class="stat-section stat-section--condition">
      <div class="condition-row">

        {{!-- RESOURCES --}}
        <div class="condition-group">          <div class="condition-group-boxes">

            {{!-- Wounds --}}
            <div class="stat-box stat-box--editable">
              <div class="stat-box-label">{{localize "REDSTEEL.Actor.Character.stats.graveWounds.value.label"}}</div>
              <div class="stat-box-value stat-box-value--ratio">
                <input type="text" class="stat-box-value-input" name="system.stats.graveWounds.value" value="{{system.stats.graveWounds.value}}" />
                <span class="stat-box-max">/ {{system.stats.graveWounds.max}}</span>
              </div>
            </div>

            {{!-- Mind --}}
            <div class="stat-box stat-box--editable">
              <div class="stat-box-label">{{localize "REDSTEEL.Actor.Character.stats.mind.value.label"}}</div>
              <div class="stat-box-value stat-box-value--ratio">
                <input type="text" class="stat-box-value-input" name="system.stats.mind.value" value="{{system.stats.mind.value}}" />
                <span class="stat-box-max">/ {{system.stats.mind.max}}</span>
              </div>
            </div>

          </div>
        </div>

        {{!-- STATUS --}}
        <div class="condition-group">          <div class="condition-group-boxes">

            {{!-- Insanity --}}
            <div class="stat-box stat-box--editable">
              <div class="stat-box-label">{{localize "REDSTEEL.Actor.Character.stats.insanity.value.label"}}</div>
              <div class="stat-box-value stat-box-value--ratio">
                <input type="text" class="stat-box-value-input" name="system.stats.insanity.value" value="{{system.stats.insanity.value}}" />
                <span class="stat-box-max">/ {{system.stats.insanity.max}}</span>
              </div>
            </div>

            {{!-- Corruption (warning tier) --}}
            <div class="stat-box stat-box--editable stat-box--warn">
              <div class="stat-box-label">{{localize "REDSTEEL.Actor.Character.stats.corruption.value.label"}}</div>
              <div class="stat-box-value stat-box-value--ratio">
                <input type="text" class="stat-box-value-input" name="system.stats.corruption.value" value="{{system.stats.corruption.value}}" />
                <span class="stat-box-max">/ {{system.stats.corruption.max}}</span>
              </div>
            </div>

            {{!-- Fatigue --}}
            <div class="stat-box stat-box--editable">
              <div class="stat-box-label">{{localize "REDSTEEL.Actor.Character.stats.fatigue.value.label"}}</div>
              <div class="stat-box-value stat-box-value--ratio">
                <input type="text" class="stat-box-value-input" name="system.stats.fatigue.value" value="{{system.stats.fatigue.value}}" />
                <span class="stat-box-max">/ {{system.stats.fatigue.max}}</span>
              </div>
            </div>

          </div>
        </div>

        {{!-- DEFENSE --}}
        <div class="condition-group">          <div class="condition-group-boxes">

            {{!-- Armor (derived, no max) --}}
            <div class="stat-box stat-box--armor">
              <div class="stat-box-label">{{localize "Armor"}}</div>
              <div class="stat-box-value">{{system.armor.total}}</div>            </div>

            {{!-- Detection (derived, no max) --}}
            <div class="stat-box">
              <div class="stat-box-label">{{localize "Detection"}}</div>
              <div class="stat-box-value">{{system.detection}}</div>            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</header>
{{/if}}

{{#if (eq actor.type "npc")}}
<header class="sheet-header sheet-npc-header">

  <div class="profile-container">
    <img
      class="profile-img"
      src="{{actor.img}}"
      data-edit="img"
      data-action="onEditImage"
      title="{{actor.name}}"
      height="216"
      width="216"
    />

<div class="grid {{#if (or system.magicPotential system.priest)}}grid-4col{{else}}grid-3col{{/if}}">

      <div class="grid-span-1">
