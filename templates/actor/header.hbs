            data-class="stat-input"
            readonly
          />
        </div>
                        <div class="attribute-armor">
          <label class="resource-label armor-icon" data-tooltip="{{localize "REDSTEEL.Item.Gear.FIELDS.magic.label"}}"><i class="fa-sharp fa-light fa-sparkle" style="color: rgb(0, 68, 124);"></i></label>
          <input
