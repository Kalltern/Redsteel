        </div>

      </div>

      <hr>

      <div class="npc-combat-grid">

        <div class="attribute-armor">
          <label class="resource-label">{{localize "REDSTEEL.Actor.Character.combatSkills.combat.label"}}</label>
          <input type="text" name="system.combatSkills.combat.value" value="{{system.combatSkills.combat.value}}" class="attribute-score" data-dtype="Number" />
        </div>

        <div class="attribute-armor">
          <label class="resource-label">{{localize "REDSTEEL.Actor.Character.combatSkills.archery.label"}}</label>
          <input type="text" name="system.combatSkills.archery.value" value="{{system.combatSkills.archery.value}}" class="attribute-score" data-dtype="Number" />
