{{! Sheet Header }}

{{#if (eq actor.type "character")}}
<header class="sheet-header">

  <div class="profile-container">
    <img
      class="profile-img"
      src="{{actor.img}}"
      data-edit="img"
      data-action="onEditImage"
      title="{{actor.name}}"
      height="216"
      width="216"
    />

    <div class="resource-bars">

      <div class="resource-bar health">
        <div class="resource-bar-track" data-tt-kind="stat" data-tt-id="health">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.health.value system.stats.health.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.health.value" data-dtype="Number"
              value="{{system.stats.health.value}}"
              data-value="system.stats.health.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              value="{{system.stats.health.max}}"
              data-value="system.stats.health.max"
              readonly
            />
          </div>
        </div>
      </div>

      <div class="resource-bar stamina">
        <div class="resource-bar-track" data-tt-kind="stat" data-tt-id="stamina">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.stamina.value system.stats.stamina.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.stamina.value" data-dtype="Number"
              value="{{system.stats.stamina.value}}"
              data-value="system.stats.stamina.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              value="{{system.stats.stamina.max}}"
              data-value="system.stats.stamina.max"
              readonly
            />
          </div>
        </div>
      </div>

      <div class="resource-bar toxicity">
        <div class="resource-bar-track" data-tt-kind="stat" data-tt-id="toxicity">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.toxicity.value system.stats.toxicity.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.toxicity.value" data-dtype="Number"
              value="{{system.stats.toxicity.value}}"
              data-value="system.stats.toxicity.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              value="{{system.stats.toxicity.max}}"
              data-value="system.stats.toxicity.max"
              readonly
            />
          </div>
        </div>
      </div>

      {{#if system.magicPotential}}
      <div class="resource-bar mana">
        <div class="resource-bar-track" data-tt-kind="stat" data-tt-id="mana">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.mana.value system.stats.mana.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.mana.value" data-dtype="Number"
              value="{{system.stats.mana.value}}"
              data-value="system.stats.mana.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              value="{{system.stats.mana.max}}"
              data-value="system.stats.mana.max"
              readonly
            />
          </div>
        </div>
      </div>
      {{/if}}

      {{#if system.priest}}
      <div class="resource-bar holyEnergy">
        <div class="resource-bar-track" data-tt-kind="stat" data-tt-id="holyEnergy">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.holyEnergy.value system.stats.holyEnergy.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.holyEnergy.value" data-dtype="Number"
              value="{{system.stats.holyEnergy.value}}"
              data-value="system.stats.holyEnergy.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              value="{{system.stats.holyEnergy.max}}"
              data-value="system.stats.holyEnergy.max"
              readonly
            />
          </div>
        </div>
      </div>
      {{/if}}

      {{!-- Blood Pool: appears for characters once the Blood School
            specialisation's "apprentice" node is acquired (its max is derived
            from the specialisation). NPCs still surface it via their blood
            school rank, with a freely-editable max. --}}
      {{#if (or system.specialisations.bloodSchool.nodes.apprentice (gt system.schools.blood.value 0))}}
      <div class="resource-bar bloodPool">
        <div class="resource-bar-track" data-tt-kind="stat" data-tt-id="bloodPool">
          <div class="resource-bar-fill" style="width: {{percentOf system.stats.bloodPool.value system.stats.bloodPool.max}}%"></div>
          <div class="resource-bar-values">
            <input
              type="text"
              class="resource-bar-current"
              name="system.stats.bloodPool.value" data-dtype="Number"
              value="{{system.stats.bloodPool.value}}"
              data-value="system.stats.bloodPool.value"
            />
            <span class="resource-bar-sep">/</span>
            <input
              type="text"
              class="resource-bar-max"
              name="system.stats.bloodPool.max" data-dtype="Number"
              value="{{system.stats.bloodPool.max}}"
              data-value="system.stats.bloodPool.max"
              {{#if (eq actor.type "character")}}readonly{{/if}}
            />
          </div>
        </div>
      </div>
      {{/if}}

    </div>
  </div>

  <div class="header-fields actor">

    <div class="grid grid-2col char-identity">
      <div class="document-name grid-span-1">
        <input
          name="name"
          type="text"
          value="{{actor.name}}"
          placeholder="Name"
        />
      </div>

      <div class="grid-span-1">
        {{#if race.length}}
          {{#each race as |item id|}}
          <div
            class="item-name race-select"
            data-action="selectRace"
            title="{{localize 'REDSTEEL.Race.EditTooltip'}}"
          >
            {{item.localizedName}}
          </div>
          {{/each}}
        {{else}}
          <div
            class="item-name race-select race-select--empty"
            data-action="selectRace"
            title="{{localize 'REDSTEEL.Race.EditTooltip'}}"
          >
            {{localize "REDSTEEL.Race.ChooseRace"}}
          </div>
        {{/if}}
      </div>
    </div>


    {{!-- PRIMARY ATTRIBUTES (tier 1 — dominant, 24px values) --}}
    <div class="stat-section stat-section--primary">
      <div class="stat-box-grid">
        {{#each system.attributes as |attribute key|}}
        <div
          class="stat-box rollable" data-tt-kind="attribute" data-tt-id="{{key}}"
          data-action="roll"
          data-roll="(@attributes.{{key}}.mod)-1d100"
          data-roll-type="attribute"
          data-label="{{key}}"
        >
          <div class="stat-box-label">{{localize (lookup @root.config.attributes key)}}</div>
          <div class="stat-box-value">{{attribute.total}}</div>
          <div class="stat-box-sub">{{numberFormat attribute.mod decimals=0}}</div>
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- SECONDARY ATTRIBUTES (tier 2 — recessive, 17px, name + value only) --}}
    <div class="stat-section stat-section--secondary">
      <div class="stat-box-grid">
        {{#each system.secondaryAttributes as |attribute key|}}
        {{#if (eq key "spd")}}
        <div class="stat-box rollable" data-tt-kind="secondaryAttribute" data-tt-id="{{key}}" data-action="rollSpeed" data-label="{{key}}">
        {{else if (eq key "lck")}}
        <div class="stat-box rollable" data-tt-kind="secondaryAttribute" data-tt-id="{{key}}" data-action="roll" data-roll-type="secondaryAttribute" data-roll="(@secondaryAttributes.{{key}}.total*5)+50-1d100" data-label="{{key}}">
        {{else if (eq key "res")}}
        <div class="stat-box rollable" data-tt-kind="secondaryAttribute" data-tt-id="{{key}}" data-action="roll" data-roll-type="secondaryAttribute" data-roll="(@secondaryAttributes.{{key}}.total*10)-1d100" data-label="{{key}}">
        {{else if (eq key "fth")}}
        <div class="stat-box rollable" data-tt-kind="secondaryAttribute" data-tt-id="{{key}}" data-action="roll" data-roll-type="secondaryAttribute" data-roll="(@secondaryAttributes.{{key}}.total*8)-1d100" data-label="{{key}}">
        {{else if (eq key "sin")}}
        <div class="stat-box rollable" data-tt-kind="secondaryAttribute" data-tt-id="{{key}}" data-action="roll" data-roll-type="secondaryAttribute" data-roll="(@secondaryAttributes.res.total*10)-(@secondaryAttributes.{{key}}.total*3)-1d100" data-label="{{key}}">
        {{else}}
        <div class="stat-box" data-tt-kind="secondaryAttribute" data-tt-id="{{key}}">
        {{/if}}
          <div class="stat-box-label">{{localize (lookup @root.config.secondaryAttributes key)}}</div>
          <div class="stat-box-value">{{attribute.total}}</div>
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- CONDITION (tier 3 — compact, grouped by function) --}}
    <div class="stat-section stat-section--condition">
      <div class="condition-row">

        {{!-- RESOURCES --}}
        <div class="condition-group">          <div class="condition-group-boxes">

            {{!-- Wounds --}}
            <div class="stat-box stat-box--editable">
              <div class="stat-box-label condition-icon" data-tt-kind="stat" data-tt-id="graveWounds"><i class="fa-light fa-bone-break" style="color: rgb(102, 32, 29);"></i></div>
              <div class="stat-box-value stat-box-value--ratio">
                <input type="text" class="stat-box-value-input" name="system.stats.graveWounds.value" data-dtype="Number" value="{{system.stats.graveWounds.value}}" />
                <span class="stat-box-max">/ {{system.stats.graveWounds.max}}</span>
              </div>
            </div>

            {{!-- Mind --}}
            <div class="stat-box stat-box--editable">
              <div class="stat-box-label condition-icon" data-tt-kind="stat" data-tt-id="mind"><i class="fa-light fa-head-side-brain" style="color: rgb(116, 119, 126);"></i></div>
              <div class="stat-box-value stat-box-value--ratio">
                <input type="text" class="stat-box-value-input" name="system.stats.mind.value" data-dtype="Number" value="{{system.stats.mind.value}}" />
                <span class="stat-box-max">/ {{system.stats.mind.max}}</span>
              </div>
            </div>

          </div>
        </div>

        {{!-- STATUS --}}
        <div class="condition-group">          <div class="condition-group-boxes">

            {{!-- Insanity --}}
            <div class="stat-box stat-box--editable">
              <div class="stat-box-label condition-icon" data-tt-kind="stat" data-tt-id="insanity"><i class="fa-light fa-hurricane" style="color: rgb(104, 40, 73);"></i></div>
              <div class="stat-box-value stat-box-value--ratio">
                <input type="text" class="stat-box-value-input" name="system.stats.insanity.value" data-dtype="Number" value="{{system.stats.insanity.value}}" />
                <span class="stat-box-max">/ {{system.stats.insanity.max}}</span>
              </div>
            </div>

            {{!-- Corruption (warning tier) --}}
            <div class="stat-box stat-box--editable stat-box--warn">
              <div class="stat-box-label condition-icon" data-tt-kind="stat" data-tt-id="corruption"><i class="fa-sharp fa-thin fa-galaxy" style="color: rgb(70, 35, 118);"></i></div>
              <div class="stat-box-value stat-box-value--ratio">
                <input type="text" class="stat-box-value-input" name="system.stats.corruption.value" data-dtype="Number" value="{{system.stats.corruption.value}}" />
                <span class="stat-box-max">/ {{system.stats.corruption.max}}</span>
              </div>
            </div>

            {{!-- Fatigue --}}
            <div class="stat-box stat-box--editable">
              <div class="stat-box-label condition-icon" data-tt-kind="stat" data-tt-id="fatigue"><i class="fa-light fa-tent" style="color: rgb(58, 68, 84);"></i></div>
              <div class="stat-box-value stat-box-value--ratio">
                <input type="text" class="stat-box-value-input" name="system.stats.fatigue.value" data-dtype="Number" value="{{system.stats.fatigue.value}}" />
                <span class="stat-box-max">/ {{system.stats.fatigue.max}}</span>
              </div>
            </div>

          </div>
        </div>

        {{!-- DEFENSE --}}
        <div class="condition-group">          <div class="condition-group-boxes">

            {{!-- Armor (derived, no max) --}}
            <div class="stat-box stat-box--armor">
              <div class="stat-box-label condition-icon" data-tt-kind="stat" data-tt-id="armor"><i class="fa-light fa-shield-quartered" style="color: rgb(96, 74, 48);"></i></div>
              <div class="stat-box-value">{{system.armor.total}}</div>            </div>

            {{!-- Detection (derived, no max) --}}
            <div class="stat-box">
              <div class="stat-box-label condition-icon" data-tt-kind="stat" data-tt-id="detection"><i class="fa-light fa-eye" style="color: rgb(116, 119, 126);"></i></div>
              <div class="stat-box-value">{{system.detection}}</div>            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</header>
{{/if}}

{{#if (eq actor.type "npc")}}
<header class="sheet-header sheet-npc-header">

  <div class="profile-container">
    <img
      class="profile-img"
      src="{{actor.img}}"
      data-edit="img"
      data-action="onEditImage"
      title="{{actor.name}}"
      height="216"
      width="216"
    />

<div class="grid {{#if (or system.magicPotential system.priest)}}grid-4col{{else}}grid-3col{{/if}}">

      <div class="grid-span-1">
        <label class="stats-resource-label" data-tt-kind="stat" data-tt-id="health">{{localize (concat 'REDSTEEL.Actor.Character.stats.health.value.label')}}</label>
        <div class="stat-values">
          <input
            type="text"
            class="stat-input stat-current resource health"
            name="system.stats.health.value" data-dtype="Number"
            value="{{system.stats.health.value}}"
            data-value="system.stats.health.value"
          />
          <input
            type="text"
            class="stat-input stat-max resource health"
            name="system.stats.health.max" data-dtype="Number"
            value="{{system.stats.health.max}}"
            data-value="system.stats.health.max"
          />
        </div>
      </div>

      <div class="grid-span-1">
        <label class="stats-resource-label" data-tt-kind="stat" data-tt-id="stamina">{{localize (concat 'REDSTEEL.Actor.Character.stats.stamina.value.label')}}</label>
        <div class="stat-values">
          <input
            type="text"
            class="stat-input stat-current resource stamina"
            name="system.stats.stamina.value" data-dtype="Number"
            value="{{system.stats.stamina.value}}"
            data-value="system.stats.stamina.value"
          />
          <input
            type="text"
            class="stat-input stat-max resource stamina"
            name="system.stats.stamina.max" data-dtype="Number"
            value="{{system.stats.stamina.max}}"
            data-value="system.stats.stamina.max"
          />
        </div>
      </div>

      <div class="grid-span-1">
        <label class="stats-resource-label" data-tt-kind="stat" data-tt-id="toxicity">{{localize (concat 'REDSTEEL.Actor.Character.stats.toxicity.value.label')}}</label>
        <div class="stat-values">
          <input
            type="text"
            class="stat-input stat-current resource toxicity"
            name="system.stats.toxicity.value" data-dtype="Number"
            value="{{system.stats.toxicity.value}}"
            data-value="system.stats.toxicity.value"
          />
          <input
            type="text"
            class="stat-input stat-max resource toxicity"
            name="system.stats.toxicity.max" data-dtype="Number"
            value="{{system.stats.toxicity.max}}"
            data-value="system.stats.toxicity.max"
          />
        </div>
      </div>

      {{#if system.magicPotential}}
      <div class="grid-span-1">
        <label class="stats-resource-label" data-tt-kind="stat" data-tt-id="mana">{{localize (concat 'REDSTEEL.Actor.Character.stats.mana.value.label')}}</label>
        <div class="stat-values">
          <input
            type="text"
            class="stat-input stat-current resource mana"
            name="system.stats.mana.value" data-dtype="Number"
            value="{{system.stats.mana.value}}"
            data-value="system.stats.mana.value"
          />
          <input
            type="text"
            class="stat-input stat-max resource mana"
            name="system.stats.mana.max" data-dtype="Number"
            value="{{system.stats.mana.max}}"
            data-value="system.stats.mana.max"
          />
        </div>
      </div>
      {{/if}}

      {{#if system.priest}}
      <div class="grid-span-1">
        <label class="stats-resource-label" data-tt-kind="stat" data-tt-id="holyEnergy">{{localize (concat 'REDSTEEL.Actor.Character.stats.holyEnergy.value.label')}}</label>
        <div class="stat-values">
          <input
            type="text"
            class="stat-input stat-current resource holyEnergy"
            name="system.stats.holyEnergy.value" data-dtype="Number"
            value="{{system.stats.holyEnergy.value}}"
            data-value="system.stats.holyEnergy.value"
          />
          <input
            type="text"
            class="stat-input stat-max resource holyEnergy"
            name="system.stats.holyEnergy.max" data-dtype="Number"
            value="{{system.stats.holyEnergy.max}}"
            data-value="system.stats.holyEnergy.max"
            />
        </div>
      </div>
      {{/if}}

    </div>

          <div class="rs-toggle-row">
        <label class="rs-toggle">
          <input type="checkbox" name="system.magicPotential" {{checked system.magicPotential}} />
          <span>{{localize "REDSTEEL.Actor.NPC.FIELDS.mage.label"}}</span>
        </label>

        <label class="rs-toggle">
          <input type="checkbox" name="system.priest" {{checked system.priest}} />
          <span>{{localize "REDSTEEL.Actor.NPC.FIELDS.priest.label"}}</span>
        </label>

        <label class="rs-toggle">
          <input type="checkbox" name="system.bloodMage" {{checked system.bloodMage}} />
          <span>{{localize "REDSTEEL.Actor.NPC.FIELDS.bloodMage.label"}}</span>
        </label>

        {{!-- Puts this NPC in the party row on the Redsteel hotbar --}}
        <label class="rs-toggle">
          <input type="checkbox" name="system.partyMember" {{checked system.partyMember}} />
          <span>{{localize "REDSTEEL.Actor.FIELDS.partyMember.label"}}</span>
        </label>

        {{!-- Rolls this NPC's best defense on its own when it is attacked. On
             by default, so the box is ticked unless it was explicitly cleared:
             an NPC predating this field stores no value and still defends, and
             `{{checked system.autoDefense}}` would show that as unticked. --}}
        <label class="rs-toggle" data-tooltip="{{localize 'REDSTEEL.AutoDefense.Tooltip'}}">
          <input
            type="checkbox"
            name="system.autoDefense"
            {{#unless (eq system.autoDefense false)}}checked{{/unless}}
          />
          <span>{{localize "REDSTEEL.AutoDefense.Label"}}</span>
        </label>
      </div>
  </div>

  <div class="header-fields">

    <div class="grid grid-2col npc-identity">
      <div class="document-name grid-span-1">
        <input
          name="name"
          type="text"
          value="{{actor.name}}"
          placeholder="Name"
        />
      </div>

      <div class="grid-span-1">
        {{#if race.length}}
          {{#each race as |item id|}}
          <div
            class="item-name race-select"
            data-action="selectRace"
            title="{{localize 'REDSTEEL.Race.EditTooltip'}}"
          >
            {{item.localizedName}}
          </div>
          {{/each}}
        {{else}}
          <div
            class="item-name race-select race-select--empty"
            data-action="selectRace"
            title="{{localize 'REDSTEEL.Race.EditTooltip'}}"
          >
            {{localize "REDSTEEL.Race.ChooseRace"}}
          </div>
        {{/if}}
      </div>
    </div>

    <hr>

    <div class="attributes flexrow">
      {{#each system.attributes as |attribute key|}}
      <div class="attribute flexcolumn flex-group-center">
        <label
          class="resource-label rollable" data-tt-kind="attribute" data-tt-id="{{key}}"
          data-action="roll"
          data-roll="(@attributes.{{key}}.mod)-1d100"
          data-roll-type="attribute"
          data-label="{{key}}"
        >
          {{localize (lookup @root.config.attributes key)}}
        </label>

        <input
          type="text"
          name="system.attributes.{{key}}.value"
          value="{{attribute.value}}"
          class="attribute-score"
          data-dtype="Number"
        />
      </div>
      {{/each}}
    </div>

    <hr>

    <div class="stats">

      <div class="stat-row">

        <div class="attribute-armor">
          <label class="resource-label armor-icon" data-tooltip="{{localize "REDSTEEL.Item.Gear.FIELDS.armor.label"}}"><i class="fa-sharp fa-regular fa-shield"></i></label>
          <input
            type="text"
            name="system.armor.natural.value"
            value="{{system.armor.natural.value}}"
            class="attribute-score"
            data-dtype="Number"
          />
          <input
            type="text"
            value="{{system.armor.total}}"
            class="attribute-total"
            data-dtype="Number"
            data-class="stat-input"
            readonly
          />
        </div>

        <div class="attribute-armor">
          <label class="resource-label armor-icon" data-tooltip="{{localize "REDSTEEL.Item.Gear.FIELDS.acid.label"}}"><i class="fa-duotone fa-light fa-flask" style="--fa-primary-color: rgb(61, 79, 34); --fa-secondary-color: rgb(80, 107, 41); --fa-secondary-opacity: 1;"></i></label>
          <input
            type="text"
            name="system.armor.acid.value"
            value="{{system.armor.acid.value}}"
            class="attribute-score"
            data-dtype="Number"
          />
          <input
            type="text"
            value="{{system.armor.acid.total}}"
            class="attribute-total"
            data-dtype="Number"
            data-class="stat-input"
            readonly
          />
        </div>

        <div class="attribute-armor">
          <label class="resource-label armor-icon" data-tooltip="{{localize "REDSTEEL.Item.Gear.FIELDS.fire.label"}}"><i class="fa-sharp fa-light fa-fire" style="color: rgb(123 83 30);"></i></label>
          <input
            type="text"
            name="system.armor.fire.value"
            value="{{system.armor.fire.value}}"
            class="attribute-score"
            data-dtype="Number"
          />
          <input
            type="text"
            value="{{system.armor.fire.total}}"
            class="attribute-total"
            data-dtype="Number"
            data-class="stat-input"
            readonly
          />
        </div>

        <div class="attribute-armor">
          <label class="resource-label armor-icon" data-tooltip="{{localize "REDSTEEL.Item.Gear.FIELDS.frost.label"}}"><i class="fa-solid fa-snowflake" style="color: rgb(46, 70, 92);"></i></label>
          <input
            type="text"
            name="system.armor.frost.value"
            value="{{system.armor.frost.value}}"
            class="attribute-score"
            data-dtype="Number"
          />
          <input
            type="text"
            value="{{system.armor.frost.total}}"
            class="attribute-total"
            data-dtype="Number"
            data-class="stat-input"
            readonly
          />
        </div>

        <div class="attribute-armor">
          <label class="resource-label armor-icon" data-tooltip="{{localize "REDSTEEL.Item.Gear.FIELDS.lightning.label"}}"><i class="fa-light fa-bolt-lightning" style="color: rgb(109 93 38);"></i></label>
          <input
            type="text"
            name="system.armor.lightning.value"
            value="{{system.armor.lightning.value}}"
            class="attribute-score"
            data-dtype="Number"
          />
          <input
            type="text"
