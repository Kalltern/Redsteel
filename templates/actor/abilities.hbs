{{! Abilities Tab }}
<section
  class="tab abilities {{tab.cssClass}}"
  data-group="primary"
  data-tab="abilities"
>
  <div class="abilities-box">
    <header class="npc-traits-header">
      <h3>{{localize "REDSTEEL.Actor.Tabs.Abilities"}}</h3>
      {{#if @root.editable}}
        <a
          class="item-control item-create"
          title="{{localize 'DOCUMENT.New' type='ability'}}"
          data-action="createDoc"
          data-document-class="Item"
          data-type="ability"
        >
          <i class="fas fa-plus"></i>
        </a>
      {{/if}}
    </header>

    <ul class="spell-card-grid">
      {{#each abilityCards as |card|}}
        <li class="spell-card" data-item-id="{{card.id}}" data-card-kind="ability" data-drag="true" data-document-class="Item">
          <a class="spell-card-icon rollable" data-action="roll" data-roll-type="item">
            <img src="{{card.img}}" data-item-id="{{card.id}}" width="48" height="48" />
          </a>
          <div class="spell-card-main">
            <div class="spell-card-top">
              <span class="spell-card-name">{{card.name}}</span>
              <span class="spell-card-controls">
                <a class="item-control item-edit" data-action="viewDoc" title="{{localize 'DOCUMENT.Update' type='Ability'}}"><i class="fas fa-edit"></i></a>
                {{#if @root.editable}}
                  <a class="item-control item-delete" data-action="deleteDoc" title="{{localize 'DOCUMENT.Delete' type='Ability'}}"><i class="fas fa-trash"></i></a>
                {{/if}}
              </span>
            </div>
            <div class="spell-card-pills">
              {{#each card.pills as |pill|}}
                <span class="spell-pill" data-pill="{{pill.key}}" data-positive="{{pill.positive}}">
                  <span class="spell-pill-label">{{pill.label}}</span>
                  <span class="spell-pill-value">{{pill.value}}</span>
                </span>
              {{/each}}
            </div>
          </div>
        </li>
      {{/each}}
    </ul>

  </div>
</section>
