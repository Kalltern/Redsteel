{{!-- One scroll: identify it, copy it into a grimoire, or break its seal.
      ApplicationV2 parts must render a SINGLE root element. --}}
<div class="rs-scroll-window">

  <div class="rs-scroll-head">
    <img class="rs-scroll-art" src="{{spellImg}}" alt="" />
    <div>
      <div class="rs-scroll-title">{{name}}</div>
      {{#if identified}}
        <div class="rs-scroll-sub">{{schoolLabel}} &middot; {{rankLabel}}</div>
      {{/if}}
    </div>
  </div>

  {{#unless identified}}
    <p class="rs-scroll-hint">{{localize "REDSTEEL.Scroll.Window.UnknownHint"}}</p>
  {{/unless}}

  {{!-- The last roll. It stays on screen after a successful identify has
        committed itself, which is why it is not inside the pending block. --}}
  {{#if result}}
    <div class="rs-scroll-result {{#if result.success}}is-success{{else}}is-failure{{/if}}">
      {{localize "REDSTEEL.Scroll.Window.Result" d100=result.d100 margin=result.marginText}}
    </div>
  {{/if}}

  {{!-- A parked test. Nothing is written until Accept. --}}
  {{#if pending}}
    <div class="rs-scroll-actions">
      <button type="button" class="rs-scroll-btn" data-action="reroll">
        <i class="fa-light fa-rotate"></i> {{localize "REDSTEEL.Scroll.Window.Reroll"}}
      </button>
      <button type="button" class="rs-scroll-btn danger" data-action="accept">
        {{localize "REDSTEEL.Scroll.Window.Close"}}
      </button>
    </div>
  {{else}}

    {{#unless identified}}
      <div class="rs-scroll-actions">
        <button type="button" class="rs-scroll-btn" data-action="identify" {{#if locked}}disabled{{/if}}>
          {{localize "REDSTEEL.Scroll.Window.Identify"}}
          <span class="rs-scroll-sub">({{localize "REDSTEEL.Scroll.Window.Difficulty"}} {{identifyDifficulty}})</span>
        </button>
      </div>
      {{#if locked}}
        <p class="rs-scroll-hint">{{localize "REDSTEEL.Scroll.Warn.IdentifyLocked" name=@root.actorName}}</p>
      {{/if}}
    {{/unless}}

    {{#if identified}}
      <div class="rs-scroll-book-row">
        <label>{{localize "REDSTEEL.Scroll.Window.Book"}}</label>
        {{#if hasBooks}}
          <select name="book">
            {{#each books as |book|}}
              <option value="{{book.id}}" {{#if book.selected}}selected{{/if}}>{{book.name}}</option>
            {{/each}}
          </select>
        {{else}}
          <span class="rs-scroll-sub">{{localize "REDSTEEL.Scroll.Window.NoBooks"}}</span>
        {{/if}}
      </div>
      <p class="rs-scroll-hint">{{localize "REDSTEEL.Scroll.Window.WriteHint"}}</p>
      <div class="rs-scroll-actions">
        <button type="button" class="rs-scroll-btn" data-action="write" {{#unless hasBooks}}disabled{{/unless}}>
          {{localize "REDSTEEL.Scroll.Window.Write"}}
          <span class="rs-scroll-sub">({{localize "REDSTEEL.Scroll.Window.Difficulty"}} {{writeDifficulty}})</span>
        </button>
      </div>
    {{/if}}

    <p class="rs-scroll-hint">{{localize "REDSTEEL.Scroll.Window.CastHint"}}</p>
    <div class="rs-scroll-actions">
      <button type="button" class="rs-scroll-btn danger" data-action="cast">
        {{localize "REDSTEEL.Scroll.Window.Cast"}}
        {{#if castBonus}}<span class="rs-scroll-sub">({{castBonusText}})</span>{{/if}}
      </button>
    </div>

  {{/if}}

</div>
