<header class="sheet-header-item">

  {{!-- =====================
       PROFILE IMAGE & NAME
  ====================== --}}
  <img
    class="profile-img"
    src="{{item.img}}"
    data-edit="img"
    data-action="onEditImage"
    title="{{itemDisplayName}}"
  />

  <div class="header-fields">
    <div class="document-name">
      {{#if hasLocalizedName}}
        <input type="text" value="{{itemDisplayName}}" readonly title="{{item.name}}" />
      {{else}}
        <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'REDSTEEL.UI.name'}}" />
      {{/if}}
      <input
        name="system.localizationKey"
        type="text"
        value="{{system.localizationKey}}"
        placeholder="{{localize 'REDSTEEL.UI.localizationKey'}}"
      />
    </div>
    {{!-- =====================
         AMMUNITION
    ====================== --}}
    {{#if (eq item.type "ammunition")}}
      <div class="grid-span-1">
        <label for="ammunition-option">Option:</label>
        <select name="system.option" id="ammunition-option">
          <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
          {{#each system.options as |option|}}
            <option value="{{option}}" {{#if (eq ../system.option option)}}selected{{/if}}>
              {{option}}
            </option>
          {{/each}}
        </select>
      </div>
      <div class="grid grid-2col">
      <div class="grid-span-1">
        <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.quantity.label"}}</label>
        <input
          type="number"
          name="system.quantity"
          value="{{system.quantity}}"
          data-dtype="Number"
        />
      </div>
       {{#if (or (eq system.option "arrows") (eq system.option "bolts"))}}
        
      <div class="grid-span-1">
        <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.penetration.label"}}</label>
        <input
          type="number"
          name="system.penetration"
          value="{{system.penetration}}"
          data-dtype="Number"
        />
      </div>

     <div class="grid-span-1">
        <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.bleed.label"}}</label>
        <input
          type="number"
          name="system.bleed"
          value="{{system.bleed}}"
          data-dtype="Number"
        />
      </div>
       {{/if}}
      </div>
      {{!-- Sharp ammunition lends the attack the weapon Sharp property: a
            second Bleeding roll on the same chance. Offered for every ammo
            type; on thrown stock the weapon usually carries Sharp already and
            the two simply agree. --}}
      <div class="grid-span-1">
        <label class="rs-toggle" data-tt-kind="weaponField" data-tt-id="sharp">
          <input type="checkbox" name="system.sharp" {{checked system.sharp}} />
          <span>{{localize "REDSTEEL.Item.Ammunition.FIELDS.sharp.label"}}</span>
        </label>
      </div>
    {{/if}}
    {{!-- =====================
         FEATURE
    ====================== --}}
    {{#if (eq item.type "feature")}}
      <div class="grid-span-1">
        <label for="feature-option">Option:</label>
        <select name="system.option" id="feature-option">
          <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
          {{#each system.options as |option|}}
            <option value="{{option}}" {{#if (eq ../system.option option)}}selected{{/if}}>
              {{option}}
            </option>
          {{/each}}
        </select>
      </div>
    {{/if}}

    {{!-- =====================
         WEAPON & ABILITY
    ====================== --}}
    {{#if (or (eq item.type "weapon") (eq item.type "ability"))}}
      <div class="grid-2col">

        {{!-- Weapon dice fields --}}
        {{#if (eq item.type "weapon")}}
          <div class="grid-span-1">
            <label for="damage-dice" data-tt-kind="weaponField" data-tt-id="diceNum">{{localize "REDSTEEL.Item.Weapon.FIELDS.diceNum.label"}}:</label>
            <input
              type="text"
              name="system.roll.diceNum"
              value="{{system.roll.diceNum}}"
              data-dtype="Number"
            />
          </div>

          <div class="grid-span-1">
            <label class="resource-label" data-tt-kind="weaponField" data-tt-id="dieSize">{{localize "REDSTEEL.Item.Weapon.FIELDS.dieSize.label"}}</label>
            <input
              type="text"
              name="system.roll.diceSize"
              value="{{system.roll.diceSize}}"
              data-dtype="String"
            />
          </div>
        {{/if}}

        {{!-- Shared fields --}}
        <div class="grid-span-1">
          <label class="resource-label" data-tt-kind="weaponField" data-tt-id="rollMod">{{localize "REDSTEEL.Item.Weapon.FIELDS.rollMod.label"}}</label>
          <input
            type="text"
            name="system.roll.diceBonus"
            value="{{system.roll.diceBonus}}"
            data-dtype="String"
            placeholder="e.g. +5+2d6"
          />
        </div>

        {{#if (eq item.type "ability")}}
          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Ability.FIELDS.heavyDamage.label"}}</label>
            <input
              type="text"
              name="system.roll.heavyDiceBonus"
              value="{{system.roll.heavyDiceBonus}}"
              data-dtype="String"
              placeholder="e.g. +2d4"
              title="{{localize "REDSTEEL.Item.Ability.FIELDS.heavyDamage.hint"}}"
            />
          </div>
        {{/if}}

        <div class="grid-span-1">
          <label class="resource-label" data-tt-kind="weaponField" data-tt-id="penetration">{{localize "REDSTEEL.Item.Weapon.FIELDS.penetration.label"}}</label>
          <input
            type="number"
            name="system.penetration"
            value="{{system.penetration}}"
            data-dtype="Number"
          />
        </div>

        {{!-- Weapon-only fields --}}
        {{#if (eq item.type "weapon")}}
          <div class="grid-span-1">
            <label for="weapon-class" data-tt-kind="weaponField" data-tt-id="weaponClass">{{localize "REDSTEEL.UI.weaponClass"}}:</label>
            <select name="system.class" id="weapon-class">
              <option value="">{{localize "REDSTEEL.UI.selectClass"}}</option>
              {{#each system.classOptions as |classOption|}}
                <option value="{{classOption}}" {{#if (eq ../system.class classOption)}}selected{{/if}}>
                  {{classOption}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label for="weapon-type" data-tt-kind="weaponField" data-tt-id="weaponType">{{localize "REDSTEEL.UI.weaponType"}}:</label>
            <select name="system.type" id="weapon-type">
              <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
              {{#each system.typeOptions as |typeOption|}}
                <option value="{{typeOption}}" {{#if (eq ../system.type typeOption)}}selected{{/if}}>
                  {{typeOption}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label for="weapon-quality" data-tt-kind="weaponField" data-tt-id="quality">{{localize "REDSTEEL.Item.Weapon.FIELDS.quality.label"}}:</label>
            <select name="system.quality" id="weapon-quality">
              {{#each system.qualityChoices as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.quality key)}}selected{{/if}}>
                  {{label}}
                </option>
              {{/each}}
            </select>
          </div>
        {{/if}}

        {{!-- Ability-only fields --}}
        {{#if (eq item.type "ability")}}
          <div class="grid-span-1">
            <label for="ability-class">{{localize "REDSTEEL.UI.abilityClass"}}:</label>
            <select name="system.class" id="ability-class">
              <option value="">{{localize "REDSTEEL.UI.selectClass"}}</option>
              {{#each system.classOptions as |classOption|}}
                <option value="{{classOption}}" {{#if (eq ../system.class classOption)}}selected{{/if}}>
                  {{classOption}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label for="ability-type">{{localize "REDSTEEL.UI.abilityType"}}:</label>
            <select name="system.type" id="ability-type">
              <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
              {{#each system.typeOptions as |typeOption|}}
                <option value="{{typeOption}}" {{#if (eq ../system.type typeOption)}}selected{{/if}}>
                  {{typeOption}}
                </option>
              {{/each}}
            </select>
          </div>

          {{#if system.standalone}}
            {{#if (eq system.type "ranged")}}
              <div class="grid-span-1">
                <label for="ability-ranged-skill" title="{{localize "REDSTEEL.Item.Ability.FIELDS.rangedSkill.hint"}}">{{localize "REDSTEEL.Item.Ability.FIELDS.rangedSkill.label"}}:</label>
                <select name="system.rangedSkill" id="ability-ranged-skill">
                  <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
                  {{#each system.rangedSkillOptions as |skillOption|}}
                    <option value="{{skillOption}}" {{#if (eq ../system.rangedSkill skillOption)}}selected{{/if}}>
                      {{skillOption}}
                    </option>
                  {{/each}}
                </select>
              </div>
            {{/if}}
          {{/if}}

          <div class="grid-span-1">
            <label for="cost-type">{{localize "REDSTEEL.UI.costType"}}:</label>
            <select name="system.costType" id="cost-type">
              <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
              {{#each system.costOptions as |costOption|}}
                <option value="{{costOption}}" {{#if (eq ../system.costType costOption)}}selected{{/if}}>
                  {{costOption}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label for="test-type">{{localize "REDSTEEL.UI.testType"}}:</label>
            <select name="system.attributeTest" id="test-type">
              <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
              {{#each system.testOptions as |testOption|}}
                <option value="{{testOption}}" {{#if (eq ../system.attributeTest testOption)}}selected{{/if}}>
                  {{testOption}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Spell.FIELDS.cost.label"}}</label>
            <input type="text" name="system.cost" value="{{system.cost}}" data-dtype="Number"/>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.UI.testModifier"}}</label>
            <input type="text" name="system.testModifier" value="{{system.testModifier}}" data-dtype="Number"/>
          </div>

          <div class="grid-span-2 rs-toggle-row">
            <label class="rs-toggle">
              <input type="checkbox" name="system.weaponAbility" {{#if system.weaponAbility}}checked{{/if}} />
              <span>{{localize "REDSTEEL.Item.Ability.FIELDS.weaponAbility.label"}}</span>
            </label>

            <label class="rs-toggle">
              <input type="checkbox" name="system.standalone" {{#if system.standalone}}checked{{/if}} />
              <span>{{localize "REDSTEEL.Item.Ability.FIELDS.standalone.label"}}</span>
            </label>

            <label class="rs-toggle">
              <input type="checkbox" name="system.modifiesAttack" {{#if system.modifiesAttack}}checked{{/if}} />
              <span>{{localize "REDSTEEL.Item.Ability.FIELDS.modifiesAttack.label"}}</span>
            </label>

            <label class="rs-toggle">
              <input type="checkbox" name="system.multiAttack" {{#if system.multiAttack}}checked{{/if}} />
              <span>{{localize "REDSTEEL.Item.Ability.FIELDS.multiAttack.label"}}</span>
            </label>

            <label class="rs-toggle" title="{{localize "REDSTEEL.Item.Ability.FIELDS.opportunityAttack.hint"}}">
              <input type="checkbox" name="system.opportunityAttack" {{#if system.opportunityAttack}}checked{{/if}} />
              <span>{{localize "REDSTEEL.Item.Ability.FIELDS.opportunityAttack.label"}}</span>
            </label>
          </div>

          <div class="grid-span-2">
            <label class="resource-label" title="{{localize "REDSTEEL.Item.Ability.FIELDS.requiredWeaponTag.hint"}}">
              {{localize "REDSTEEL.Item.Ability.FIELDS.requiredWeaponTag.label"}}
            </label>
            <input type="text" name="system.requiredWeaponTag" value="{{system.requiredWeaponTag}}"
              placeholder="{{localize "REDSTEEL.Item.Ability.FIELDS.requiredWeaponTag.hint"}}" />
          </div>
        {{/if}}

      </div>
    {{/if}}

    {{!-- =====================
         GEAR
    ====================== --}}
    {{#if (eq item.type "gear")}}
      <div class="grid grid-2col">

        <div class="grid-span-2 rs-toggle-row">
          <label class="rs-toggle">
            <input type="checkbox" name="system.shield" {{#if system.shield}}checked{{/if}} />
            <span>{{localize "REDSTEEL.Item.Gear.FIELDS.shield.label"}}</span>
          </label>

          {{#unless system.shield}}
            <label class="rs-toggle">
              <input type="checkbox" name="system.helmet" {{#if system.helmet}}checked{{/if}} />
              <span>{{localize "REDSTEEL.Item.Gear.FIELDS.helmet.label"}}</span>
            </label>
          {{/unless}}
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Gear.FIELDS.armor.label"}}</label>
          <input type="text" name="system.armor.value" value="{{system.armor.value}}" data-dtype="Number"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Gear.FIELDS.durability.label"}}</label>
          <input type="text" name="system.armor.durability" value="{{system.armor.durability}}" data-dtype="Number"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Gear.FIELDS.durabilityMax.label"}}</label>
          <input type="text" name="system.armor.durabilityMax" value="{{system.armor.durabilityMax}}" data-dtype="Number"/>
        </div>


        {{#unless system.shield}}
          <div class="grid-span-1">
            <label for="gear-layer">{{localize "REDSTEEL.UI.gearLayer"}}:</label>
            <select name="system.layer" id="gear-layer">
              <option value="">{{localize "REDSTEEL.UI.selectLayer"}}</option>
              {{#each system.layerOptions as |layerOption|}}
                <option value="{{layerOption}}" {{#if (eq ../system.layer layerOption)}}selected{{/if}}>
                  {{layerOption}}
                </option>
              {{/each}}
            </select>
          </div>
        {{/unless}}

        <div class="grid-span-1">
          <label for="gear-quality">{{localize "REDSTEEL.Item.Gear.FIELDS.quality.label"}}:</label>
          <select name="system.quality" id="gear-quality">
            {{#each system.qualityChoices as |label key|}}
              <option value="{{key}}" {{#if (eq ../system.quality key)}}selected{{/if}}>
                {{label}}
              </option>
            {{/each}}
          </select>
        </div>

      </div>
    {{/if}}

    {{!-- =====================
         CONSUMABLE
    ====================== --}}
    {{#if (eq item.type "consumable")}}
      <div class="grid grid-2col">
        <div class="grid-span-1">
          <label for="consumable-option">Type:</label>
          <select name="system.option" id="consumable-option">
            <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
            {{#each system.options as |option|}}
              <option value="{{option}}" {{#if (eq ../system.option option)}}selected{{/if}}>{{option}}</option>
            {{/each}}
          </select>
        </div>

        <div class="grid-span-1">
          <label class="resource-label" title="{{localize 'REDSTEEL.Item.Consumable.FIELDS.difficulty.hint'}}">{{localize "REDSTEEL.Item.Consumable.FIELDS.difficulty.label"}}</label>
          <input type="number" name="system.difficulty" value="{{system.difficulty}}" data-dtype="Number" placeholder="0"/>
        </div>

        {{!-- Potion --}}
        {{#if (eq item.system.option "potion")}}
          <div class="grid-span-1">
            <label for="potion-type">{{localize "REDSTEEL.UI.potionType"}}:</label>
            <select name="system.type" id="potion-type">
              <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
              {{#each system.types as |type|}}
                <option value="{{type}}" {{#if (eq ../system.type type)}}selected{{/if}}>{{type}}</option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.toxicity.label"}}</label>
            <input type="text" name="system.toxicity" value="{{system.toxicity}}" data-dtype="Number"/>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.bleed.label"}}</label>
            <input type="text" name="system.bleed" value="{{system.bleed}}" data-dtype="Number"/>
          </div>
        {{/if}}

        {{!-- Explosive --}}
        {{#if (eq item.system.option "explosive")}}
          <div class="grid-span-1 rs-toggle-row">
            <label class="rs-toggle">
              <input type="checkbox" name="system.aimed" {{#if system.aimed}}checked{{/if}} />
              <span>{{localize "REDSTEEL.Item.Consumable.FIELDS.aimed.label"}}</span>
            </label>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.penetration.label"}}</label>
            <input type="text" name="system.penetration" value="{{system.penetration}}" data-dtype="Number" placeholder="0"/>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.burn.label"}}</label>
            <input type="text" name="system.burn" value="{{system.burn}}" data-dtype="Number" placeholder="0"/>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.freeze.label"}}</label>
            <input type="text" name="system.freeze" value="{{system.freeze}}" data-dtype="Number" placeholder="0"/>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.stagger.label"}}</label>
            <input type="text" name="system.stagger" value="{{system.stagger}}" data-dtype="Number" placeholder="0"/>
          </div>

          <div class="grid-span-2">
            <label class="resource-label">{{localize
                "REDSTEEL.Item.Spell.FIELDS.headerType.label"
              }}</label>
            <div style="display:flex; gap:4px;">
              <select name="system.dmgType1" id="dmg-type-1">
                <option value="">-- Select a type --</option>
                {{#each system.dmgTypes as |dmgType|}}
                  <option value="{{dmgType}}" {{#if (eq ../system.dmgType1 dmgType)}}selected{{/if}}>
                    {{dmgType}}
                  </option>
                {{/each}}
              </select>

              <select name="system.bool2" id="effect-bool-2">
                <option value="">--</option>
                {{#each system.effectOptions as |bool|}}
                  <option value="{{bool}}" {{#if (eq ../system.bool2 bool)}}selected{{/if}}>
                    {{bool}}
                  </option>
                {{/each}}
              </select>

              <select name="system.dmgType2" id="dmg-type-2">
                <option value="">-- Select a type --</option>
                {{#each system.dmgTypes as |dmgType|}}
                  <option value="{{dmgType}}" {{#if (eq ../system.dmgType2 dmgType)}}selected{{/if}}>
                    {{dmgType}}
                  </option>
                {{/each}}
              </select>
            </div>
          </div>
        {{/if}}

        {{!-- Dice fields --}}
        <div class="grid-span-1">
          <label>{{localize "REDSTEEL.Item.Weapon.FIELDS.diceNum.label"}}:</label>
          <input type="text" name="system.roll.diceNum" value="{{system.roll.diceNum}}" data-dtype="Number" placeholder="0"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.dieSize.label"}}</label>
          <input type="text" name="system.roll.diceSize" value="{{system.roll.diceSize}}" data-dtype="String" placeholder="0"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.rollMod.label"}}</label>
          <input type="text" name="system.roll.diceBonus" value="{{system.roll.diceBonus}}" data-dtype="String" placeholder="e.g. 5+2d6"/>
        </div>

      </div>
    {{/if}}

    {{!-- =====================
         MAGIC & DIVINE SPELLS
    ====================== --}}
    {{#if (eq item.type "spell")}}
      <div class="grid grid-2col">
        <div class="grid-span-1">
          <label for="spell-option">Type:</label>
          <select name="system.option" id="spell-option">
            <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
            {{#each system.options as |option|}}
              <option value="{{option}}" {{#if (eq ../system.option option)}}selected{{/if}}>{{option}}</option>
            {{/each}}
          </select>
        </div>

        {{!-- Magic option --}}
        {{#if (eq item.system.option "magic")}}
          <div class="grid-span-1">
            <label for="school-type">{{localize "REDSTEEL.UI.school"}}:</label>
            <select name="system.type" id="school-type">
              <option value="">{{localize "REDSTEEL.UI.selectSchool"}}</option>
              {{#each system.spellTypes as |type|}}
                <option value="{{type}}" {{#if (eq ../system.type type)}}selected{{/if}}>{{type}}</option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label for="spell-rank">{{localize "REDSTEEL.UI.rank"}}:</label>
            <select name="system.rank">
              <option value="">{{localize "REDSTEEL.UI.selectRank"}}</option>
              {{#each system.spellRanks as |rank|}}
                <option value="{{rank}}" {{#if (eq ../system.rank rank)}}selected{{/if}}>{{rank}}</option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Spell.FIELDS.difficulty.label"}}</label>
            <input type="text" name="system.difficulty" value="{{system.difficulty}}" data-dtype="Number"/>
          </div>
        {{/if}}

        {{!-- Divine option --}}
        {{#if (eq item.system.option "divine")}}
          <div class="grid-span-1">
            <label for="spell-rank">{{localize "REDSTEEL.UI.rank"}}:</label>
            <select name="system.rank">
              <option value="">{{localize "REDSTEEL.UI.selectRank"}}</option>
              {{#each system.miracleRanks as |rank|}}
                <option value="{{rank}}" {{#if (eq ../system.rank rank)}}selected{{/if}}>{{rank}}</option>
              {{/each}}
            </select>
          </div>
        {{/if}}

        {{!-- Dice fields --}}
        <div class="grid-span-1">
          <label>{{localize "REDSTEEL.Item.Weapon.FIELDS.diceNum.label"}}:</label>
          <input type="text" name="system.roll.diceNum" value="{{system.roll.diceNum}}" data-dtype="Number" placeholder="0"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.dieSize.label"}}</label>
          <input type="text" name="system.roll.diceSize" value="{{system.roll.diceSize}}" data-dtype="String" placeholder="0"/>
        </div>

        <div class="grid-span-2">
          <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.rollMod.label"}}</label>
          <input type="text" name="system.roll.diceBonus" value="{{system.roll.diceBonus}}" data-dtype="String" placeholder="e.g. @spellPower"/>
        </div>
       <div class="grid-span-1">
            <label for="test-type">{{localize "REDSTEEL.UI.testType"}}:</label>
            <select name="system.attributeTest" id="test-type">
              <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
              {{#each system.testOptions as |testOption|}}
                <option value="{{testOption}}" {{#if (eq ../system.attributeTest testOption)}}selected{{/if}}>
                  {{testOption}}
                </option>
              {{/each}}
            </select>
       </div>
         
          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.UI.testModifier"}}</label>
            <input type="text" name="system.testModifier" value="{{system.testModifier}}" data-dtype="String" placeholder="e.g. @spellPower"/>
          </div>
         </div>
         <div class="grid grid-3col">
        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.penetration.label"}}</label>
          <input type="text" name="system.penetration" value="{{system.penetration}}" data-dtype="Number" placeholder="0"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Spell.FIELDS.cost.label"}}</label>
          <input type="text" name="system.cost" value="{{system.cost}}" data-dtype="Number"/>
        </div>

        {{!-- Offensive / Uncontested / Sustained / Healing live under
              "Spell properties" on the Variants tab. --}}

      </div>
    {{/if}}

  </div>

</header>
