<header class="sheet-header-item{{#if (or (eq item.type "weapon") (eq item.type "gear") (eq item.type "ability"))}} sheet-header-item--plated{{/if}}">

  {{!-- =====================
       PROFILE IMAGE & NAME
  ====================== --}}
  <img
    class="profile-img"
    src="{{item.img}}"
    data-edit="img"
    data-action="onEditImage"
    title="{{itemDisplayName}}"
  />

  <div class="header-fields">
    <div class="document-name">
      {{!-- An unidentified magic item: players get the disguise with no title
            (the title would leak the true name), the GM always gets the
            editable real name. --}}
      {{#if (and hasLocalizedName (not (and isGM isUnidentified)))}}
        <input type="text" value="{{itemDisplayName}}" readonly {{#unless identifyHidden}}title="{{item.name}}"{{/unless}} />
      {{else}}
        <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'REDSTEEL.UI.name'}}" />
      {{/if}}
      {{!-- The key can name the item, so a player never sees it on an
            unidentified one. Tucked behind an icon: it matters only while
            authoring, and it lights up when one is set. --}}
      {{#unless identifyHidden}}
        <details class="rs-item-key{{#if system.localizationKey}} rs-item-key--set{{/if}}">
          <summary data-tooltip="{{localize 'REDSTEEL.UI.localizationKey'}}">
            <i class="fa-solid fa-language"></i>
          </summary>
          <input
            name="system.localizationKey"
            type="text"
            value="{{system.localizationKey}}"
            placeholder="{{localize 'REDSTEEL.UI.localizationKey'}}"
          />
        </details>
      {{/unless}}
    </div>
    {{!-- =====================
         AMMUNITION
    ====================== --}}
    {{#if (eq item.type "ammunition")}}
      <div class="grid-span-1">
        <label for="ammunition-option">Option:</label>
        <select name="system.option" id="ammunition-option">
          <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
          {{#each system.options as |option|}}
            <option value="{{option}}" {{#if (eq ../system.option option)}}selected{{/if}}>
              {{option}}
            </option>
          {{/each}}
        </select>
      </div>
      <div class="grid grid-2col">
      <div class="grid-span-1">
        <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.quantity.label"}}</label>
        <input
          type="number"
          name="system.quantity"
          value="{{system.quantity}}"
          data-dtype="Number"
        />
      </div>
       {{#if (or (eq system.option "arrows") (eq system.option "bolts"))}}
        
      <div class="grid-span-1">
        <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.penetration.label"}}</label>
        <input
          type="number"
          name="system.penetration"
          value="{{system.penetration}}"
          data-dtype="Number"
        />
      </div>

     <div class="grid-span-1">
        <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.bleed.label"}}</label>
        <input
          type="number"
          name="system.bleed"
          value="{{system.bleed}}"
          data-dtype="Number"
        />
      </div>
       {{/if}}
      </div>
      {{!-- Sharp ammunition lends the attack the weapon Sharp property: a
            second Bleeding roll on the same chance. Offered for every ammo
            type; on thrown stock the weapon usually carries Sharp already and
            the two simply agree. --}}
      <div class="grid-span-1">
        <label class="rs-toggle" data-tt-kind="weaponField" data-tt-id="sharp">
          <input type="checkbox" name="system.sharp" {{checked system.sharp}} />
          <span>{{localize "REDSTEEL.Item.Ammunition.FIELDS.sharp.label"}}</span>
        </label>
      </div>
    {{/if}}
    {{!-- =====================
         FEATURE
    ====================== --}}
    {{#if (eq item.type "feature")}}
      <div class="grid-span-1">
        <label for="feature-option">Option:</label>
        <select name="system.option" id="feature-option">
          <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
          {{#each system.options as |option|}}
            <option value="{{option}}" {{#if (eq ../system.option option)}}selected{{/if}}>
              {{option}}
            </option>
          {{/each}}
        </select>
      </div>
    {{/if}}

    {{!-- =====================
         PLAIN ITEM
    ====================== --}}
    {{#if (eq item.type "item")}}
      <div class="grid grid-2col">
        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.quantity.label"}}</label>
          <input
            type="number"
            name="system.quantity"
            value="{{system.quantity}}"
            data-dtype="Number"
          />
        </div>
        {{!-- Any stack ticked here counts as food units for the Long Rest:
              bread, dried meat, a hunter's catch. One item = one unit, so a
              stack of 12 feeds one normal character for four days. --}}
        <div class="grid-span-1">
          <label class="rs-toggle">
            <input type="checkbox" name="system.rations" {{checked system.rations}} />
            <span>{{localize "REDSTEEL.Item.Item.FIELDS.rations.label"}}</span>
          </label>
          {{!-- Ohniskový předmět (utils/focusItem.mjs). --}}
          <label class="rs-toggle" data-tooltip="{{localize 'REDSTEEL.Item.Focus.hint'}}">
            <input type="checkbox" name="system.focus" {{checked system.focus}} />
            <span>{{localize "REDSTEEL.Item.Focus.label"}}</span>
          </label>
        </div>
      </div>
    {{/if}}

    {{!-- =====================
         WEAPON
    ====================== --}}
    {{#if (eq item.type "weapon")}}
      <div class="rs-item-facts">
        <div class="rs-field">
          <label for="weapon-class" data-tt-kind="weaponField" data-tt-id="weaponClass">{{localize "REDSTEEL.UI.weaponClass"}}</label>
          <select name="system.class" id="weapon-class">
            <option value="">{{localize "REDSTEEL.UI.selectClass"}}</option>
            {{#each system.classOptions as |classOption|}}
              <option value="{{classOption}}" {{#if (eq ../system.class classOption)}}selected{{/if}}>
                {{localize (concat "REDSTEEL.Item.Weapon.Class." classOption)}}
              </option>
            {{/each}}
          </select>
        </div>
        <div class="rs-field">
          <label for="weapon-type" data-tt-kind="weaponField" data-tt-id="weaponType">{{localize "REDSTEEL.UI.weaponType"}}</label>
          <select name="system.type" id="weapon-type">
            <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
            {{#each system.typeOptions as |typeOption|}}
              <option value="{{typeOption}}" {{#if (eq ../system.type typeOption)}}selected{{/if}}>
                {{localize (concat "REDSTEEL.Item.Weapon.Type." typeOption)}}
              </option>
            {{/each}}
          </select>
        </div>
        <div class="rs-field">
          <label for="weapon-quality" data-tt-kind="weaponField" data-tt-id="quality">{{localize "REDSTEEL.Item.Weapon.FIELDS.quality.label"}}</label>
          <select name="system.quality" id="weapon-quality">
            {{#each system.qualityChoices as |label key|}}
              <option value="{{key}}" {{#if (eq ../system.quality key)}}selected{{/if}}>
                {{label}}
              </option>
            {{/each}}
          </select>
        </div>
        {{!-- Material (utils/materials.mjs). The select is unnamed so the form
              submit never writes it; the sheet's change listener stores the key
              and a frozen snapshot together. --}}
        <div class="rs-field">
          <label for="weapon-material">{{localize "REDSTEEL.Material.Label"}}</label>
          <div class="material-select-row">
            <select id="weapon-material" data-material-select {{#unless editable}}disabled{{/unless}}>
              {{#each materialChoices as |choice|}}
                <option value="{{choice.key}}" {{#if choice.selected}}selected{{/if}}>
                  {{choice.label}}
                </option>
              {{/each}}
            </select>
            {{#if (and editable materialKey)}}
              <a class="material-refresh" data-action="refreshMaterial" title="{{localize 'REDSTEEL.Material.Refresh'}}">
                <i class="fa-solid fa-rotate"></i>
              </a>
            {{/if}}
          </div>
        </div>
      </div>
      {{#if materialSummary}}
        <p class="hint material-summary">{{materialSummary}}</p>
      {{/if}}
    {{/if}}

    {{!-- =====================
         ABILITY
    ====================== --}}
    {{#if (eq item.type "ability")}}
      <div class="rs-item-facts">
        <div class="rs-field">
          <label for="ability-class">{{localize "REDSTEEL.UI.abilityClass"}}</label>
          <select name="system.class" id="ability-class">
            <option value="">{{localize "REDSTEEL.UI.selectClass"}}</option>
            {{#each system.classOptions as |option|}}
              <option value="{{option}}" {{#if (eq ../system.class option)}}selected{{/if}}>{{localize (concat "REDSTEEL.Item.Ability.Class." option)}}</option>
            {{/each}}
          </select>
        </div>
        <div class="rs-field">
          <label for="ability-category">{{localize "REDSTEEL.Item.Ability.FIELDS.category.label"}}</label>
          <select name="system.category" id="ability-category">
            {{#each system.categoryOptions as |categoryOption|}}
              <option value="{{categoryOption}}" {{#if (eq ../system.category categoryOption)}}selected{{/if}}>
                {{localize (concat "REDSTEEL.Actor.Abilities.Category." categoryOption)}}
              </option>
            {{/each}}
          </select>
        </div>
        <div class="rs-field">
          <label for="ability-type">{{localize "REDSTEEL.UI.abilityType"}}</label>
          <select name="system.type" id="ability-type">
            <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
            {{#each system.typeOptions as |option|}}
              <option value="{{option}}" {{#if (eq ../system.type option)}}selected{{/if}}>{{localize (concat "REDSTEEL.Item.Ability.Type." option)}}</option>
            {{/each}}
          </select>
        </div>
        {{#if (and system.standalone (eq system.type "ranged"))}}
          <div class="rs-field">
            <label for="ability-ranged-skill" title="{{localize "REDSTEEL.Item.Ability.FIELDS.rangedSkill.hint"}}">{{localize "REDSTEEL.Item.Ability.FIELDS.rangedSkill.label"}}</label>
            <select name="system.rangedSkill" id="ability-ranged-skill">
              <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
              {{#each system.rangedSkillOptions as |skillOption|}}
                <option value="{{skillOption}}" {{#if (eq ../system.rangedSkill skillOption)}}selected{{/if}}>
                  {{localize (concat "REDSTEEL.Actor.Character.combatSkills." skillOption ".label")}}
                </option>
              {{/each}}
            </select>
          </div>
        {{/if}}
      </div>
    {{/if}}

    {{!-- =====================
         GEAR
    ====================== --}}
    {{#if (eq item.type "gear")}}
      <div class="rs-item-facts">
        {{#unless system.shield}}
          <div class="rs-field">
            <label for="gear-layer">{{localize "REDSTEEL.UI.gearLayer"}}</label>
            <select name="system.layer" id="gear-layer">
              <option value="">{{localize "REDSTEEL.UI.selectLayer"}}</option>
              {{#each system.layerOptions as |layerOption|}}
                <option value="{{layerOption}}" {{#if (eq ../system.layer layerOption)}}selected{{/if}}>
                  {{localize (concat "REDSTEEL.Item.Gear.Layer." layerOption)}}
                </option>
              {{/each}}
            </select>
          </div>
          {{#unless (eq system.layer "Accessory")}}
            <div class="rs-field">
              <label for="gear-armor-weight">{{localize "REDSTEEL.Item.Gear.FIELDS.armorWeight.label"}}</label>
              <select name="system.armorWeight" id="gear-armor-weight">
                <option value="" {{#unless system.armorWeight}}selected{{/unless}}>{{localize "REDSTEEL.Item.Gear.FIELDS.armorWeight.none"}}</option>
                <option value="light" {{#if (eq system.armorWeight "light")}}selected{{/if}}>{{localize "REDSTEEL.Item.Gear.FIELDS.armorWeight.light"}}</option>
                <option value="heavy" {{#if (eq system.armorWeight "heavy")}}selected{{/if}}>{{localize "REDSTEEL.Item.Gear.FIELDS.armorWeight.heavy"}}</option>
              </select>
            </div>
          {{/unless}}
        {{/unless}}
        <div class="rs-field">
          <label for="gear-quality">{{localize "REDSTEEL.Item.Gear.FIELDS.quality.label"}}</label>
          <select name="system.quality" id="gear-quality">
            {{#each system.qualityChoices as |label key|}}
              <option value="{{key}}" {{#if (eq ../system.quality key)}}selected{{/if}}>
                {{label}}
              </option>
            {{/each}}
          </select>
        </div>
        {{!-- Material (utils/materials.mjs). The select is unnamed so the form
              submit never writes it; the sheet's change listener stores the key
              and a frozen snapshot together. --}}
        <div class="rs-field">
          <label for="gear-material">{{localize "REDSTEEL.Material.Label"}}</label>
          <div class="material-select-row">
            <select id="gear-material" data-material-select {{#unless editable}}disabled{{/unless}}>
              {{#each materialChoices as |choice|}}
                <option value="{{choice.key}}" {{#if choice.selected}}selected{{/if}}>
                  {{choice.label}}
                </option>
              {{/each}}
            </select>
            {{#if (and editable materialKey)}}
              <a class="material-refresh" data-action="refreshMaterial" title="{{localize 'REDSTEEL.Material.Refresh'}}">
                <i class="fa-solid fa-rotate"></i>
              </a>
            {{/if}}
          </div>
        </div>
      </div>
      {{#if materialSummary}}
        <p class="hint material-summary">{{materialSummary}}</p>
      {{/if}}
      <div class="rs-toggle-row">
        <label class="rs-toggle">
          <input type="checkbox" name="system.shield" {{#if system.shield}}checked{{/if}} />
          <span>{{localize "REDSTEEL.Item.Gear.FIELDS.shield.label"}}</span>
        </label>
        {{#unless system.shield}}
          <label class="rs-toggle">
            <input type="checkbox" name="system.helmet" {{#if system.helmet}}checked{{/if}} />
            <span>{{localize "REDSTEEL.Item.Gear.FIELDS.helmet.label"}}</span>
          </label>
        {{/unless}}
        {{!-- Ohniskový předmět (utils/focusItem.mjs). --}}
        <label class="rs-toggle" data-tooltip="{{localize 'REDSTEEL.Item.Focus.hint'}}">
          <input type="checkbox" name="system.focus" {{checked system.focus}} />
          <span>{{localize "REDSTEEL.Item.Focus.label"}}</span>
        </label>
      </div>
    {{/if}}

    {{!-- =====================
         CONSUMABLE
    ====================== --}}
    {{#if (eq item.type "consumable")}}
      <div class="grid grid-2col">
        <div class="grid-span-1">
          <label for="consumable-option">Type:</label>
          <select name="system.option" id="consumable-option">
            <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
            {{#each system.options as |option|}}
              <option value="{{option}}" {{#if (eq ../system.option option)}}selected{{/if}}>{{option}}</option>
            {{/each}}
          </select>
        </div>

        <div class="grid-span-1">
          <label class="resource-label" title="{{localize 'REDSTEEL.Item.Consumable.FIELDS.difficulty.hint'}}">{{localize "REDSTEEL.Item.Consumable.FIELDS.difficulty.label"}}</label>
          <input type="number" name="system.difficulty" value="{{system.difficulty}}" data-dtype="Number" placeholder="0"/>
        </div>

        {{!-- Potion --}}
        {{#if (eq item.system.option "potion")}}
          <div class="grid-span-1">
            <label for="potion-type">{{localize "REDSTEEL.UI.potionType"}}:</label>
            <select name="system.type" id="potion-type">
              <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
              {{#each system.types as |type|}}
                <option value="{{type}}" {{#if (eq ../system.type type)}}selected{{/if}}>{{type}}</option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.toxicity.label"}}</label>
            <input type="text" name="system.toxicity" value="{{system.toxicity}}" data-dtype="Number"/>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.bleed.label"}}</label>
            <input type="text" name="system.bleed" value="{{system.bleed}}" data-dtype="Number"/>
          </div>
        {{/if}}

        {{!-- Explosive --}}
        {{#if (eq item.system.option "explosive")}}
          <div class="grid-span-1 rs-toggle-row">
            <label class="rs-toggle">
              <input type="checkbox" name="system.aimed" {{#if system.aimed}}checked{{/if}} />
              <span>{{localize "REDSTEEL.Item.Consumable.FIELDS.aimed.label"}}</span>
            </label>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.penetration.label"}}</label>
            <input type="text" name="system.penetration" value="{{system.penetration}}" data-dtype="Number" placeholder="0"/>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.burn.label"}}</label>
            <input type="text" name="system.burn" value="{{system.burn}}" data-dtype="Number" placeholder="0"/>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.freeze.label"}}</label>
            <input type="text" name="system.freeze" value="{{system.freeze}}" data-dtype="Number" placeholder="0"/>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Consumable.FIELDS.stagger.label"}}</label>
            <input type="text" name="system.stagger" value="{{system.stagger}}" data-dtype="Number" placeholder="0"/>
          </div>

          <div class="grid-span-2">
            <label class="resource-label">{{localize
                "REDSTEEL.Item.Spell.FIELDS.headerType.label"
              }}</label>
            <div style="display:flex; gap:4px;">
              <select name="system.dmgType1" id="dmg-type-1">
                <option value="">-- Select a type --</option>
                {{#each system.dmgTypes as |dmgType|}}
                  <option value="{{dmgType}}" {{#if (eq ../system.dmgType1 dmgType)}}selected{{/if}}>
                    {{dmgType}}
                  </option>
                {{/each}}
              </select>

              <select name="system.bool2" id="effect-bool-2">
                <option value="">--</option>
                {{#each system.effectOptions as |bool|}}
                  <option value="{{bool}}" {{#if (eq ../system.bool2 bool)}}selected{{/if}}>
                    {{bool}}
                  </option>
                {{/each}}
              </select>

              <select name="system.dmgType2" id="dmg-type-2">
                <option value="">-- Select a type --</option>
                {{#each system.dmgTypes as |dmgType|}}
                  <option value="{{dmgType}}" {{#if (eq ../system.dmgType2 dmgType)}}selected{{/if}}>
                    {{dmgType}}
                  </option>
                {{/each}}
              </select>
            </div>
          </div>
        {{/if}}

        {{!-- Dice fields --}}
        <div class="grid-span-1">
          <label>{{localize "REDSTEEL.Item.Weapon.FIELDS.diceNum.label"}}:</label>
          <input type="text" name="system.roll.diceNum" value="{{system.roll.diceNum}}" data-dtype="Number" placeholder="0"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.dieSize.label"}}</label>
          <input type="text" name="system.roll.diceSize" value="{{system.roll.diceSize}}" data-dtype="String" placeholder="0"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.rollMod.label"}}</label>
          <input type="text" name="system.roll.diceBonus" value="{{system.roll.diceBonus}}" data-dtype="String" placeholder="e.g. 5+2d6"/>
        </div>

      </div>
    {{/if}}

    {{!-- =====================
         MAGIC & DIVINE SPELLS
    ====================== --}}
    {{#if (eq item.type "spell")}}
      <div class="grid grid-2col">
        <div class="grid-span-1">
          <label for="spell-option">Type:</label>
          <select name="system.option" id="spell-option">
            <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
            {{#each system.options as |option|}}
              <option value="{{option}}" {{#if (eq ../system.option option)}}selected{{/if}}>{{option}}</option>
            {{/each}}
          </select>
        </div>

        {{!-- Magic option --}}
        {{#if (eq item.system.option "magic")}}
          <div class="grid-span-1">
            <label for="school-type">{{localize "REDSTEEL.UI.school"}}:</label>
            <select name="system.type" id="school-type">
              <option value="">{{localize "REDSTEEL.UI.selectSchool"}}</option>
              {{#each system.spellTypes as |type|}}
                <option value="{{type}}" {{#if (eq ../system.type type)}}selected{{/if}}>{{type}}</option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label for="spell-rank">{{localize "REDSTEEL.UI.rank"}}:</label>
            <select name="system.rank">
              <option value="">{{localize "REDSTEEL.UI.selectRank"}}</option>
              {{#each system.spellRanks as |rank|}}
                <option value="{{rank}}" {{#if (eq ../system.rank rank)}}selected{{/if}}>{{rank}}</option>
              {{/each}}
            </select>
          </div>

          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.Item.Spell.FIELDS.difficulty.label"}}</label>
            <input type="text" name="system.difficulty" value="{{system.difficulty}}" data-dtype="Number"/>
          </div>
        {{/if}}

        {{!-- Divine option --}}
        {{#if (eq item.system.option "divine")}}
          <div class="grid-span-1">
            <label for="spell-rank">{{localize "REDSTEEL.UI.rank"}}:</label>
            <select name="system.rank">
              <option value="">{{localize "REDSTEEL.UI.selectRank"}}</option>
              {{#each system.miracleRanks as |rank|}}
                <option value="{{rank}}" {{#if (eq ../system.rank rank)}}selected{{/if}}>{{rank}}</option>
              {{/each}}
            </select>
          </div>
        {{/if}}

        {{!-- Dice fields --}}
        <div class="grid-span-1">
          <label>{{localize "REDSTEEL.Item.Weapon.FIELDS.diceNum.label"}}:</label>
          <input type="text" name="system.roll.diceNum" value="{{system.roll.diceNum}}" data-dtype="Number" placeholder="0"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.dieSize.label"}}</label>
          <input type="text" name="system.roll.diceSize" value="{{system.roll.diceSize}}" data-dtype="String" placeholder="0"/>
        </div>

        <div class="grid-span-2">
          <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.rollMod.label"}}</label>
          <input type="text" name="system.roll.diceBonus" value="{{system.roll.diceBonus}}" data-dtype="String" placeholder="e.g. @spellPower"/>
        </div>
       <div class="grid-span-1">
            <label for="test-type">{{localize "REDSTEEL.UI.testType"}}:</label>
            <select name="system.attributeTest" id="test-type">
              <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
              {{#each system.testOptions as |testOption|}}
                <option value="{{testOption}}" {{#if (eq ../system.attributeTest testOption)}}selected{{/if}}>
                  {{testOption}}
                </option>
              {{/each}}
            </select>
       </div>
         
          <div class="grid-span-1">
            <label class="resource-label">{{localize "REDSTEEL.UI.testModifier"}}</label>
            <input type="text" name="system.testModifier" value="{{system.testModifier}}" data-dtype="String" placeholder="e.g. @spellPower"/>
          </div>

          <div class="grid-span-1">
            <label class="resource-label" title="{{localize "REDSTEEL.Item.Ability.FIELDS.versusAgainst.hint"}}">
              {{localize "REDSTEEL.Item.Ability.FIELDS.versusAgainst.label"}}
            </label>
            <div class="rs-versus-against">
              {{#each versusAgainstOptions as |opt|}}
                <label class="rs-versus-against__opt" data-tooltip="{{opt.label}}">
                  <input type="checkbox" data-versus-against="{{opt.key}}" {{checked opt.checked}} {{#unless ../editable}}disabled{{/unless}} />{{opt.abbr}}
                </label>
              {{/each}}
            </div>
          </div>
         </div>
         <div class="grid grid-3col">
        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Weapon.FIELDS.penetration.label"}}</label>
          <input type="text" name="system.penetration" value="{{system.penetration}}" data-dtype="Number" placeholder="0"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize "REDSTEEL.Item.Spell.FIELDS.cost.label"}}</label>
          <input type="text" name="system.cost" value="{{system.cost}}" data-dtype="Number"/>
        </div>

        <div class="grid-span-1">
          <label class="resource-label" data-tooltip="{{localize "REDSTEEL.Item.Spell.FIELDS.magicAttack.hint"}}">{{localize "REDSTEEL.Item.Spell.FIELDS.magicAttack.label"}}</label>
          <input type="text" name="system.magicAttack" value="{{system.magicAttack}}" data-dtype="Number" placeholder="0"/>
        </div>

        {{!-- Offensive / Uncontested / Sustained / Healing / Fixed Magic Attack
              live under "Spell properties" on the Variants tab. --}}

      </div>
    {{/if}}

  </div>

  {{!-- The numbers an item is judged by stay in view on every tab. Each
        input is the stored base value; the small figure beside it is what
        quality, material and enchantments add on top. --}}
  {{#if (eq item.type "weapon")}}
  <div class="rs-item-stats">
    <div class="rs-plate rs-plate--hero">
      <label>{{localize "REDSTEEL.Item.Ability.FIELDS.damage.label"}}</label>
      <div class="rs-plate-formula">
        <input type="text" name="system.roll.diceNum" value="{{system.roll.diceNum}}" data-dtype="Number"
          aria-label="{{localize 'REDSTEEL.Item.Weapon.FIELDS.diceNum.label'}}" data-tt-kind="weaponField" data-tt-id="diceNum" />
        <span>d</span>
        <input type="text" name="system.roll.diceSize" value="{{system.roll.diceSize}}" data-dtype="String"
          aria-label="{{localize 'REDSTEEL.Item.Weapon.FIELDS.dieSize.label'}}" data-tt-kind="weaponField" data-tt-id="dieSize" />
        {{#if damageJoiner}}<span>{{damageJoiner}}</span>{{/if}}
        <input type="text" name="system.roll.diceBonus" value="{{system.roll.diceBonus}}" data-dtype="String" placeholder="0"
          aria-label="{{localize 'REDSTEEL.Item.Weapon.FIELDS.rollMod.label'}}" data-tt-kind="weaponField" data-tt-id="rollMod" />
      </div>
      {{#if weaponBonus.damage}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{weaponBonus.damage}}</span>{{/if}}
    </div>
    <div class="rs-plate">
      <label data-tt-kind="weaponField" data-tt-id="attack">{{localize "REDSTEEL.Item.Weapon.FIELDS.attack.label"}}</label>
      <input type="text" name="system.attack" value="{{system.attack}}" data-dtype="Number" />
      {{#if weaponBonus.attack}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{weaponBonus.attack}}</span>{{/if}}
    </div>
    <div class="rs-plate">
      <label data-tt-kind="weaponField" data-tt-id="defense">{{localize "REDSTEEL.Item.Weapon.FIELDS.defense.label"}}</label>
      <input type="text" name="system.defense" value="{{system.defense}}" data-dtype="Number" />
      {{#if weaponBonus.defense}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{weaponBonus.defense}}</span>{{/if}}
    </div>
    <div class="rs-plate">
      <label data-tt-kind="weaponField" data-tt-id="dodge">{{localize "REDSTEEL.Item.Weapon.FIELDS.dodge.label"}}</label>
      <input type="text" name="system.dodge" value="{{system.dodge}}" data-dtype="Number" />
      {{#if weaponBonus.dodge}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{weaponBonus.dodge}}</span>{{/if}}
    </div>
    <div class="rs-plate">
      <label data-tt-kind="weaponField" data-tt-id="penetration">{{localize "REDSTEEL.Item.Weapon.FIELDS.penetration.label"}}</label>
      <input type="number" name="system.penetration" value="{{system.penetration}}" data-dtype="Number" />
      {{#if weaponBonus.penetration}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{weaponBonus.penetration}}</span>{{/if}}
    </div>
    <div class="rs-plate">
      <label data-tt-kind="weaponField" data-tt-id="breakthrough">{{localize "REDSTEEL.Item.Weapon.FIELDS.breakthrough.label"}}</label>
      <input type="text" name="system.breakthrough" value="{{system.breakthrough}}" data-dtype="String" placeholder="2d6" />
      {{#if weaponBonus.breakthrough}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{weaponBonus.breakthrough}}</span>{{/if}}
    </div>
    <div class="rs-plate">
      <label data-tt-kind="weaponField" data-tt-id="sneakDamage">{{localize "REDSTEEL.Item.Weapon.FIELDS.sneakDamage.label"}}</label>
      <input type="text" name="system.sneakDamage" value="{{system.sneakDamage}}" data-dtype="String" placeholder="2d6" />
    </div>
  </div>
  {{/if}}
  {{#if (eq item.type "gear")}}
  <div class="rs-item-stats rs-item-stats--gear">
    <div class="rs-plate rs-plate--hero">
      <label>{{localize "REDSTEEL.Item.Gear.FIELDS.armor.label"}}</label>
      <input type="text" name="system.armor.value" value="{{system.armor.value}}" data-dtype="Number" />
      {{#if gearBonus.armor}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{gearBonus.armor}}</span>{{/if}}
    </div>
    <div class="rs-plate">
      <label>{{localize "REDSTEEL.Item.Gear.FIELDS.defense.label"}}</label>
      <input type="text" name="system.defense" value="{{system.defense}}" data-dtype="Number" />
      {{#if gearBonus.defense}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{gearBonus.defense}}</span>{{/if}}
    </div>
    <div class="rs-plate">
      <label>{{localize "REDSTEEL.Item.Gear.FIELDS.critDefense.label"}}</label>
      <input type="text" name="system.critDefense" value="{{system.critDefense}}" data-dtype="Number" />
      {{#if gearBonus.critDefense}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{gearBonus.critDefense}}</span>{{/if}}
    </div>
    <div class="rs-plate rs-plate--hero">
      <label>{{localize "REDSTEEL.Item.Gear.FIELDS.durability.label"}}</label>
      <div class="rs-plate-formula">
        <input type="text" name="system.armor.durability" value="{{system.armor.durability}}" data-dtype="Number"
          aria-label="{{localize 'REDSTEEL.Item.Gear.FIELDS.durability.label'}}" />
        <span>/</span>
        <input type="text" name="system.armor.durabilityMax" value="{{system.armor.durabilityMax}}" data-dtype="Number"
          aria-label="{{localize 'REDSTEEL.Item.Gear.FIELDS.durabilityMax.label'}}" />
      </div>
    </div>
    <div class="rs-plate">
      <label>{{localize "REDSTEEL.Item.Gear.FIELDS.rangedDefense.label"}}</label>
      <input type="text" name="system.rangedDefense" value="{{system.rangedDefense}}" data-dtype="Number" />
      {{#if gearBonus.rangedDefense}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{gearBonus.rangedDefense}}</span>{{/if}}
    </div>
    <div class="rs-plate">
      <label>{{localize "REDSTEEL.Item.Gear.FIELDS.rangedCritDefense.label"}}</label>
      <input type="text" name="system.rangedCritDefense" value="{{system.rangedCritDefense}}" data-dtype="Number" />
      {{#if gearBonus.rangedCritDefense}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{gearBonus.rangedCritDefense}}</span>{{/if}}
    </div>
  </div>
  {{/if}}
  {{#if (eq item.type "ability")}}
  {{!-- Six plates between the two heroes. A defense or stance is judged by what
        it protects, anything else by what it hits with; Heavy Damage moves to
        the Attributes tab when the first set fills the strip. --}}
  <div class="rs-item-stats rs-item-stats--ability">
    {{#if (or (eq system.class "defense") (eq system.class "stance"))}}
      <div class="rs-plate rs-plate--hero">
        <label>{{localize "REDSTEEL.Item.Weapon.FIELDS.defense.label"}}</label>
        <input type="text" name="system.defense" value="{{system.defense}}" data-dtype="Number" />
      </div>
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.rangedDefense.label"}}</label>
        <input type="text" name="system.rangedDefense" value="{{system.rangedDefense}}" data-dtype="Number" />
      </div>
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Weapon.FIELDS.dodge.label"}}</label>
        <input type="text" name="system.dodge" value="{{system.dodge}}" data-dtype="Number" />
      </div>
      <div class="rs-plate">
        <label data-tt-kind="weaponField" data-tt-id="rollMod">{{localize "REDSTEEL.Item.Ability.FIELDS.damage.label"}}</label>
        <input type="text" name="system.roll.diceBonus" value="{{system.roll.diceBonus}}" data-dtype="String" placeholder="0" />
      </div>
    {{else}}
      <div class="rs-plate rs-plate--hero">
        <label data-tt-kind="weaponField" data-tt-id="rollMod">{{localize "REDSTEEL.Item.Ability.FIELDS.damage.label"}}</label>
        <input type="text" name="system.roll.diceBonus" value="{{system.roll.diceBonus}}" data-dtype="String" placeholder="0" />
      </div>
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Weapon.FIELDS.attack.label"}}</label>
        <input type="text" name="system.attack" value="{{system.attack}}" data-dtype="Number" />
      </div>
      <div class="rs-plate">
        <label data-tt-kind="weaponField" data-tt-id="penetration">{{localize "REDSTEEL.Item.Weapon.FIELDS.penetration.label"}}</label>
        <input type="number" name="system.penetration" value="{{system.penetration}}" data-dtype="Number" />
      </div>
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Weapon.FIELDS.breakthrough.label"}}</label>
        <input type="text" name="system.breakthrough" value="{{system.breakthrough}}" data-dtype="String" placeholder="2d6" />
      </div>
    {{/if}}
    <div class="rs-plate rs-plate--hero">
      <label>{{localize "REDSTEEL.Item.Spell.FIELDS.cost.label"}}</label>
      <input type="text" name="system.cost" value="{{system.cost}}" data-dtype="Number" />
      <select name="system.costType" id="cost-type" aria-label="{{localize 'REDSTEEL.UI.costType'}}">
        <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
        {{#each system.costOptions as |costOption|}}
          <option value="{{costOption}}" {{#if (eq ../system.costType costOption)}}selected{{/if}}>{{localize (concat "REDSTEEL.Item.Ability.Cost." costOption)}}</option>
        {{/each}}
      </select>
    </div>
    <div class="rs-plate rs-plate--word">
      <label>{{localize "REDSTEEL.Item.Ability.FIELDS.actionCost.label"}}</label>
      <input type="text" name="system.actionCost" value="{{system.actionCost}}" data-dtype="String" placeholder="2 | R" />
    </div>
    <div class="rs-plate">
      <label>{{localize "REDSTEEL.Item.Spell.FIELDS.perRound.label"}}</label>
      <input type="text" name="system.perRound" value="{{system.perRound}}" data-dtype="String" />
    </div>
    {{#if (or (eq system.class "defense") (eq system.class "stance"))}}
      <div class="rs-plate">
        <label data-tt-kind="weaponField" data-tt-id="penetration">{{localize "REDSTEEL.Item.Weapon.FIELDS.penetration.label"}}</label>
        <input type="number" name="system.penetration" value="{{system.penetration}}" data-dtype="Number" />
      </div>
    {{else}}
      <div class="rs-plate">
        <label title="{{localize "REDSTEEL.Item.Ability.FIELDS.heavyDamage.hint"}}">{{localize "REDSTEEL.Item.Ability.FIELDS.heavyDamage.short"}}</label>
        <input type="text" name="system.roll.heavyDiceBonus" value="{{system.roll.heavyDiceBonus}}" data-dtype="String" placeholder="+2d4" />
      </div>
    {{/if}}
  </div>
  {{/if}}

</header>
