{{! Attributes Tab — Race }}
<section
  class='tab attributes {{tab.cssClass}}'
  data-group='primary'
  data-tab='attributes'
>

  <h3 class="race-grants-heading">{{localize "REDSTEEL.Race.Grants.Heading"}}</h3>
  <p class="hint">{{localize "REDSTEEL.Race.Grants.Hint"}}</p>

  <div class="race-grant-list">
    {{#each raceGrantEntries as |entry|}}
      <div class="race-grant-row">
        {{#if entry.img}}<img src="{{entry.img}}" width="20" height="20" />{{/if}}
        <span>{{entry.name}}</span>
        {{#if @root.editable}}
          <a data-action="removeRaceGrant" data-index="{{entry.index}}" title="{{localize 'REDSTEEL.Race.Grants.Remove'}}">
            <i class="fas fa-xmark"></i>
          </a>
        {{/if}}
      </div>
    {{else}}
      <p class="hint">{{localize "REDSTEEL.Race.Grants.Empty"}}</p>
    {{/each}}
  </div>

  <h3 class="race-choices-heading">{{localize "REDSTEEL.Race.Editor.Heading"}}</h3>

  <div class="grid grid-10col">
    <div class="grid-span-10">
      <label class="resource-label">{{localize "REDSTEEL.Banes.TagField"}}</label>
      <input
        type="text"
        name="system.baneTypes"
        value="{{system.baneTypes}}"
        data-tooltip="{{localize 'REDSTEEL.Banes.TagFieldHint'}}"
      />
    </div>
  </div>

  {{#unless hasRaceEffects}}
    <p class="hint">{{localize "REDSTEEL.Race.Editor.NoEffects"}}</p>
  {{/unless}}

  {{#each raceChoiceEntries as |group|}}
    <fieldset class="race-choice-editor-group">
      <div class="grid grid-3col">
        <div class="grid-span-2">
          <label>{{localize "REDSTEEL.Race.Editor.Label"}}</label>
          <input
            type="text"
            name="system.choices.{{group.index}}.label"
            value="{{group.label}}"
          />
        </div>
        <div class="grid-span-1">
          <label>{{localize "REDSTEEL.Race.Editor.Count"}}</label>
          <input
            type="number"
            min="1"
            name="system.choices.{{group.index}}.count"
            value="{{group.count}}"
            data-dtype="Number"
          />
        </div>
      </div>

      {{#if hasRaceEffects}}
        <div class="race-choice-editor-effects rs-toggle-row">
          {{#each group.effectRows as |row|}}
            <label class="rs-toggle">
              <input
                type="checkbox"
                data-action="toggleRaceChoiceEffect"
                data-group-index="{{group.index}}"
                data-effect-id="{{row.effectId}}"
                {{#if row.member}}checked{{/if}}
              />
              <span>
                {{#if row.img}}<img src="{{row.img}}" width="16" height="16" />{{/if}}
                {{row.name}}
              </span>
            </label>
          {{/each}}
        </div>
      {{/if}}

      <a data-action="removeRaceChoice" data-index="{{group.index}}" class="race-choice-remove">
        <i class="fas fa-xmark"></i>
      </a>
    </fieldset>
  {{/each}}

  <a data-action="addRaceChoice" class="race-choice-add">
    <i class="fas fa-plus"></i> {{localize "REDSTEEL.Race.Editor.AddChoice"}}
  </a>

</section>
