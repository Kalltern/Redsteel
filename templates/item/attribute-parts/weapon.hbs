{{! Attributes Tab }}
<section
  class="tab attributes {{tab.cssClass}}"
  data-group="primary"
  data-tab="attributes"
>
  {{! As you add new fields, add them in here! }}

  <div class="resource">

    <div class="grid grid-4col">

      <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="attack">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.attack.label"
          }}</label>
        <input
          type="text"
          name="system.attack"
          value="{{system.attack}}"
          data-dtype="Number"
        />
      </div>
      <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="defense">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.defense.label"
          }}</label>
        <input
          type="text"
          name="system.defense"
          value="{{system.defense}}"
          data-dtype="Number"
        />
      </div>

            <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="dodge">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.dodge.label"
          }}</label>
        <input
          type="text"
          name="system.dodge"
          value="{{system.dodge}}"
          data-dtype="Number"
        />
      </div>


      <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="critRange">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.critRange.label"
          }}</label>
        <input
          type="text"
          name="system.critRange"
          value="{{system.critRange}}"
          data-dtype="Number"
        />
      </div>

      <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="critChance">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.critChance.label"
          }}</label>
        <input
          type="text"
          name="system.critChance"
          value="{{system.critChance}}"
          data-dtype="Number"
        />
      </div>

      <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="critFail">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.critFail.label"
          }}</label>
        <input
          type="text"
          name="system.critFail"
          value="{{system.critFail}}"
          data-dtype="Number"
        />
      </div>

      <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="critDefense">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.critDefense.label"
          }}</label>
        <input
          type="text"
          name="system.critDefense"
          value="{{system.critDefense}}"
          data-dtype="Number"
        />
      </div>
      
      <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="critDodge">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.critDodge.label"
          }}</label>
        <input
          type="text"
          name="system.critDodge"
          value="{{system.critDodge}}"
          data-dtype="Number"
        />
      </div>

            <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="critPenetration">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.critPenetration.label"
          }}</label>
        <input
          type="text"
          name="system.critPenetration"
          value="{{system.critPenetration}}"
          data-dtype="Number"
        />
      </div>

            <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="critDamage">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.critDamage.label"
          }}</label>
        <input
          type="text"
          name="system.critDamage"
          value="{{system.critDamage}}"
          data-dtype="Number"
        />
      </div>


      <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="breakthrough">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.breakthrough.label"
          }}</label>
        <input
          type="text"
          name="system.breakthrough"
          value="{{system.breakthrough}}"
          data-dtype="String"
          placeholder="e.g. 2d6"
        />
      </div>
      <div class="grid-span-1">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="sneakDamage">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.sneakDamage.label"
          }}</label>
        <input
          type="text"
          name="system.sneakDamage"
          value="{{system.sneakDamage}}"
          data-dtype="String"
          placeholder="e.g. 2d6"
        />
      </div>
      {{! Property toggles get their own full-width row so none of them are
          pushed out of the 4-column grid. }}
      <div class="grid-span-4 rs-toggle-row">
        <label class="rs-toggle" data-tt-kind="weaponField" data-tt-id="finesse">
          <input
            type="checkbox"
            name="system.finesse"
            {{checked system.finesse}}
          />
          <span>{{localize "REDSTEEL.Item.Weapon.FIELDS.finesse.label"}}</span>
        </label>
        {{#unless (eq system.type "heavy")}}
          <label class="rs-toggle" data-tt-kind="weaponField" data-tt-id="twoHandGrip">
            <input
              type="checkbox"
              name="system.twoHandGrip"
              {{checked system.twoHandGrip}}
            />
            <span>{{localize "REDSTEEL.Item.Weapon.FIELDS.twoHandGrip.label"}}</span>
          </label>
        {{/unless}}
        {{#if (eq system.class "polearm")}}
        {{#unless (eq system.thrown true)}}
          <label class="rs-toggle" data-tt-kind="weaponField" data-tt-id="longReach">
            <input
              type="checkbox"
              name="system.longReach"
              {{checked system.longReach}}
            />
            <span>{{localize "REDSTEEL.Item.Weapon.FIELDS.longReach.label"}}</span>
          </label>
          {{/unless}}
        {{/if}}
        <label class="rs-toggle" data-tt-kind="weaponField" data-tt-id="sharp">
          <input type="checkbox" name="system.sharp" {{checked system.sharp}} />
          <span>{{localize "REDSTEEL.Item.Weapon.FIELDS.sharp.label"}}</span>
        </label>

        <label class="rs-toggle" data-tt-kind="weaponField" data-tt-id="thrown">
          <input type="checkbox" name="system.thrown" {{checked system.thrown}} />
          <span>{{localize "REDSTEEL.Item.Weapon.FIELDS.thrown.label"}}</span>
        </label>
       {{#unless (or (eq system.class "polearm") (eq system.type "heavy"))}}
        <label class="rs-toggle" data-tt-kind="weaponField" data-tt-id="offhand">
          <input
            type="checkbox"
            name="system.offhand"
            {{checked system.offhand}}
          />
          <span>{{localize "REDSTEEL.Item.Weapon.FIELDS.offhand.label"}}</span>
        </label>

    {{/unless}}
      </div>

      {{! Tags sit one row below the toggles. }}
      <div class="grid-span-2">
        <label class="resource-label" data-tt-kind="weaponField" data-tt-id="tags">{{localize
            "REDSTEEL.Item.Weapon.FIELDS.tags.label"
          }}</label>
        <input
          type="text"
          name="system.tags"
          value="{{system.tags}}"
          data-dtype="String"
          placeholder="e.g. Trident, Reach"
        />
      </div>
      <div class="grid-span-2"></div>



<div class="grid-span-4">
<label class="resource-label" data-tt-kind="weaponField" data-tt-id="dmgType">{{localize
     "REDSTEEL.Item.Spell.FIELDS.headerType.label"
  }}</label></div>

<select name="system.dmgType1" id="dmg-type-1">
  <option value="">-- Select a type --</option>
  {{#each system.dmgTypes as |dmgType|}}
    <option value="{{dmgType}}" {{#if (eq ../system.dmgType1 dmgType)}}selected{{/if}}>
      {{dmgType}}
    </option>
  {{/each}}
</select>

<select name="system.bool2" id="effect-bool-2">
  <option value="">-- Select a type --</option>
  {{#each system.effectOptions as |bool|}}
    <option value="{{bool}}" {{#if (eq ../system.bool2 bool)}}selected{{/if}}>
      {{bool}}
    </option>
  {{/each}}
</select> 

<select name="system.dmgType2" id="dmg-type-2">
  <option value="">-- Select a type --</option>
  {{#each system.dmgTypes as |dmgType|}}
    <option value="{{dmgType}}" {{#if (eq ../system.dmgType2 dmgType)}}selected{{/if}}>
      {{dmgType}}
    </option>
  {{/each}}
</select>

<select name="system.bool3" id="effect-bool-3">
  <option value="">-- Select a type --</option>
  {{#each system.effectOptions as |bool|}}
    <option value="{{bool}}" {{#if (eq ../system.bool3 bool)}}selected{{/if}}>
      {{bool}}
    </option>
  {{/each}}
</select>

<select name="system.dmgType3" id="dmg-type-3">
  <option value="">-- Select a type --</option>
  {{#each system.dmgTypes as |dmgType|}}
    <option value="{{dmgType}}" {{#if (eq ../system.dmgType3 dmgType)}}selected{{/if}}>
      {{dmgType}}
    </option>
  {{/each}}
</select>

<select name="system.bool4" id="effect-bool-4">
  <option value="">-- Select a type --</option>
  {{#each system.effectOptions as |bool|}}
    <option value="{{bool}}" {{#if (eq ../system.bool4 bool)}}selected{{/if}}>
      {{bool}}
    </option>
  {{/each}}
</select>

<select name="system.dmgType4" id="dmg-type-4">
  <option value="">-- Select a type --</option>
  {{#each system.dmgTypes as |dmgType|}}
    <option value="{{dmgType}}" {{#if (eq ../system.dmgType4 dmgType)}}selected{{/if}}>
      {{dmgType}}
    </option>
  {{/each}}
</select>

    </div>

  </div>
</section>