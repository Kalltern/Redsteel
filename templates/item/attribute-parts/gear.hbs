{{! Attributes Tab }}
<section
  class="tab attributes {{tab.cssClass}}"
  data-group="primary"
  data-tab="attributes"
>
  {{! As you add new fields, add them in here! }}

  <div class="rs-section">
    <h3 class="rs-section-head">{{localize "REDSTEEL.Item.Gear.Section.whileEquipped"}}</h3>
    <div class="rs-plate-grid">
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.dodgePenalty.label"}}</label>
        <input type="text" name="system.dodgePenalty" value="{{system.dodgePenalty}}" data-dtype="Number" />
      </div>
      {{#unless system.shield}}
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.iniPenalty.label"}}</label>
        <input type="text" name="system.iniPenalty" value="{{system.iniPenalty}}" data-dtype="Number" />
        {{#if gearBonus.ini}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{gearBonus.ini}}</span>{{/if}}
      </div>
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.acroPenalty.label"}}</label>
        <input type="text" name="system.acroPenalty" value="{{system.acroPenalty}}" data-dtype="Number" />
      </div>
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.swimPenalty.label"}}</label>
        <input type="text" name="system.swimPenalty" value="{{system.swimPenalty}}" data-dtype="Number" />
      </div>
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.castPenalty.label"}}</label>
        <input type="text" name="system.castPenalty" value="{{system.castPenalty}}" data-dtype="Number" />
      </div>
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.stealthPenalty.label"}}</label>
        <input type="text" name="system.stealthPenalty" value="{{system.stealthPenalty}}" data-dtype="Number" />
      </div>
        {{#if system.helmet}}
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.perPenalty.label"}}</label>
        <input type="text" name="system.perPenalty" value="{{system.perPenalty}}" data-dtype="Number" />
      </div>
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.archeryPenalty.label"}}</label>
        <input type="text" name="system.archeryPenalty" value="{{system.archeryPenalty}}" data-dtype="Number" />
      </div>
        {{/if}}
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.maxSpeed.label"}}</label>
        <input type="text" name="system.maxSpeed" value="{{system.maxSpeed}}" data-dtype="Number" />
      </div>
      <div class="rs-plate">
        <label>{{localize "REDSTEEL.Item.Gear.FIELDS.healthBonus.label"}}</label>
        <input type="text" name="system.healthBonus" value="{{system.healthBonus}}" data-dtype="Number" />
        {{#if gearBonus.healthBonus}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{gearBonus.healthBonus}}</span>{{/if}}
      </div>
      {{/unless}}
    </div>
  </div>

  <div class="rs-section">
    <h3 class="rs-section-head">{{localize "REDSTEEL.Item.Gear.Section.resistances"}}</h3>
    <div class="rs-plate-grid">
      {{#each system.armor as |armor key|}}
        {{#unless (or (eq key "value") (or (eq key "durability") (eq key "durabilityMax")))}}
          <div class="rs-plate">
            <label>{{localize (concat "REDSTEEL.Item.Gear.FIELDS." key ".label")}}</label>
            <input type="text" name="system.armor.{{key}}.value" value="{{armor.value}}" data-dtype="Number" />
            {{#if (lookup ../gearBonus.resist key)}}<span class="rs-plate-mod" data-tooltip="{{localize 'REDSTEEL.Item.Weapon.BonusHint'}}">{{lookup ../gearBonus.resist key}}</span>{{/if}}
          </div>
        {{/unless}}
      {{/each}}
    </div>
  </div>
</section>
