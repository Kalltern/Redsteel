{{! Attributes Tab }}
<section
  class='tab attributes {{tab.cssClass}}'
  data-group='primary'
  data-tab='attributes'
>
  {{! As you add new fields, add them in here! }}
  <h3>Reroll Settings</h3>

  <!-- Static Input for Reroll Name -->
  <label for="reroll-name">Reroll Name</label>
  <input 
    type="text" 
    id="reroll-name" 
    name="system.reroll.name" 
    value="{{system.reroll.name}}" 
    placeholder="Enter reroll name" />

  <!-- Static Input for Reroll Value -->
  <label for="reroll-value">Reroll Value</label>
  <input 
    type="number" 
    id="reroll-value" 
    name="system.reroll.value" 
    value="{{system.reroll.value}}" 
    min="0" 
    placeholder="Enter number of rerolls" />

{{#if (eq system.option "trait")}}
<div class="form-group stacked">
  <label>Roll Triggers</label>
  <input
    type="text"
    name="system.rollTriggersRaw"
    value="{{system.rollTriggersRaw}}"
    placeholder="e.g. res, athletics"
  />
  <p class="hint">
    Comma-separated. Pills appear in chat when a matching roll is made. attributes are written with shortcut only (str,res)
  </p>
</div>

<div class="form-group stacked">
  <label>Status Effects</label>
  <input
    type="text"
    name="system.statusEffectsRaw"
    value="{{system.statusEffectsRaw}}"
    placeholder="e.g. guard, regeneration"
  />
  <p class="hint">
    Comma-separated status effect ids. A token deployed for this actor spawns
    with these effects (they can be removed normally). Ids are case-sensitive.
  </p>
</div>
{{/if}}

</section>