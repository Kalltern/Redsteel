{{! Attributes Tab }}
<section
  class='tab attributes {{tab.cssClass}}'
  data-group='primary'
  data-tab='attributes'
>
  {{! As you add new fields, add them in here! }}
  <div
    class="flexrow"
    style="align-items: center; justify-content: space-between; margin-bottom: 6px;"
  >
    <h3 style="margin: 0;">Reroll Pools</h3>
    <a
      class="reroll-pool-control"
      data-action="addRerollPool"
      title="Add reroll pool"
      style="flex: 0 0 auto;"
    >
      <i class="fas fa-plus"></i> Add reroll pool
    </a>
  </div>
  <p class="hint">
    Each pool is an independent reroll source with its own count. Leave
    <b>Skills</b> blank (or type <code>universal</code>) for a reroll usable on
    any roll; otherwise list skill shortcuts, comma-separated
    (e.g. <code>perception, archery</code>). One pool per skill that should be
    consumed separately.
  </p>
  <p class="hint">
    An attribute alone (<code>str</code>) covers only the raw Strength test;
    <code>str-based</code> covers every non-combat roll governed by it
    (Athletics, Smithing, …). Neither rerolls an attack or a defense — for that
    the pool must be universal or list <code>attack</code>, <code>defense</code>
    or a combat skill (<code>combat, archery, dodge</code>).
  </p>

  {{#each rerollPoolEntries as |pool|}}
    <fieldset class="reroll-pool-row" style="margin-bottom: 8px;">
      <div class="flexrow" style="align-items: center; gap: 6px;">
        <input
          type="text"
          name="system.reroll.pools.{{pool.index}}.label"
          value="{{pool.label}}"
          placeholder="Pool label (optional)"
          style="flex: 2;"
        />
        <input
          type="number"
          name="system.reroll.pools.{{pool.index}}.max"
          value="{{pool.max}}"
          min="0"
          title="Number of rerolls"
          data-dtype="Number"
          style="flex: 0 0 64px;"
        />
        <a
          class="reroll-pool-control"
          data-action="removeRerollPool"
          data-index="{{pool.index}}"
          title="Remove pool"
          style="flex: 0 0 auto;"
        >
          <i class="fas fa-trash"></i>
        </a>
      </div>
      <input
        type="text"
        name="system.reroll.pools.{{pool.index}}.skillsRaw"
        value="{{pool.skillsRaw}}"
        placeholder="Skills (blank = universal), e.g. per-based, archery"
        style="margin-top: 4px;"
      />
      {{! Preserve spent state across sheet submits. }}
      <input
        type="hidden"
        name="system.reroll.pools.{{pool.index}}.used"
        value="{{pool.used}}"
        data-dtype="Number"
      />
    </fieldset>
  {{else}}
    <p style="opacity: 0.7;">No reroll pools. Add one to grant rerolls.</p>
  {{/each}}

{{#if (or (eq system.option "trait") (eq system.option "feature"))}}
<div class="form-group stacked">
  <label>Roll Triggers</label>
  <input
    type="text"
    name="system.rollTriggersRaw"
    value="{{system.rollTriggersRaw}}"
    placeholder="e.g. res, athletics"
  />
  <p class="hint">{{localize "REDSTEEL.RollTriggers.Hint"}}</p>
</div>
{{/if}}

{{#if (eq system.option "trait")}}
<div class="form-group">
  <label class="rs-toggle">
    <input type="checkbox" name="system.starsign" {{checked system.starsign}} />
    <span>Starsign</span>
  </label>
  <p class="hint">
    Marks this trait as a Starsign (Hvězda). A character may own only one —
    dropping a second one on a sheet is refused.
  </p>
</div>
{{/if}}

{{#if (eq system.option "trait")}}
<div class="form-group stacked">
  <label>Status Effects</label>
  <input
    type="text"
    name="system.statusEffectsRaw"
    value="{{system.statusEffectsRaw}}"
    placeholder="e.g. guard, regeneration"
  />
  <p class="hint">
    Comma-separated status effect ids. A token deployed for this actor spawns
    with these effects (they can be removed normally). Ids are case-sensitive.
  </p>
</div>
{{/if}}

{{#if system.weaponSpec.tier}}
<div class="form-group stacked">
  <label>Weapon Specialization tag</label>
  <input
    type="text"
    name="system.weaponSpec.tag"
    value="{{system.weaponSpec.tag}}"
    placeholder="e.g. sword, reach, axe"
  />
  <input
    type="hidden"
    name="system.weaponSpec.tier"
    value="{{system.weaponSpec.tier}}"
    data-dtype="Number"
  />
  <p class="hint">
    This feature's Weapon Specialization bonuses (tier {{system.weaponSpec.tier}}) apply to any weapon whose Tags include this tag. Case-insensitive, exact tag match.
  </p>
</div>
{{/if}}

{{#if (eq system.option "feature")}}
{{! What the feature costs in the Learn window. An empty box stores null and
    falls back to the book price (shown as the placeholder); 0 is free. }}
<h3 style="margin: 12px 0 6px;">{{localize "REDSTEEL.Learn.ItemFields.title"}}</h3>
<div class="flexrow" style="gap: 6px;">
  <div class="form-group stacked">
    <label>{{localize "REDSTEEL.Learn.ItemFields.costCp"}}</label>
    <input
      type="number"
      name="system.cost.cp"
      value="{{system.cost.cp}}"
      min="0"
      data-dtype="Number"
      placeholder="{{featureBookPrice.cp}}"
    />
  </div>
  <div class="form-group stacked">
    <label>{{localize "REDSTEEL.Learn.ItemFields.costSp"}}</label>
    <input
      type="number"
      name="system.cost.sp"
      value="{{system.cost.sp}}"
      min="0"
      data-dtype="Number"
      placeholder="{{featureBookPrice.sp}}"
    />
  </div>
</div>
<div class="form-group stacked">
  <label>{{localize "REDSTEEL.Learn.ItemFields.section"}}</label>
  <select name="system.learnSection">
    {{#each featureSectionOptions}}
      <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
    {{/each}}
  </select>
</div>
<div class="form-group stacked">
  <label>{{localize "REDSTEEL.Learn.ItemFields.requirementsNote"}}</label>
  <input
    type="text"
    name="system.requirementsNote"
    value="{{system.requirementsNote}}"
  />
</div>
<p class="hint">{{localize "REDSTEEL.Learn.ItemFields.hint"}}</p>
{{/if}}

</section>